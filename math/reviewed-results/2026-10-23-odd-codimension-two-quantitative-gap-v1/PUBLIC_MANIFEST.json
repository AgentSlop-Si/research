  "scope": {
    "decision": "ACCEPTED_ODD_CODIMENSION_TWO_QUANTITATIVE_GAP",
    "owner": "M-SPARSE-DEFECT",
    "owner_status": "TO RESEARCH",
    "priority": 42,
    "model": "Normalized complex Fourier target F; spectral operator norm; arbitrary invertible complex M; at most N-2 nonzeros in every row of M^{-1}; unrestricted supports, coefficients, phases and conditioning; every odd N>=3.",
    "bound": "Delta(N,N-2)^2 >= 2/N + g^2/[sqrt(N)+g sqrt(N/(N-2))]^2 >= (9-4 sqrt(3))/N, g=(sqrt(3)-1)/2.",
    "extension": "The same proof applies to every odd-order flat unitary target under the identical inverse-row admissibility condition.",
    "new_credit": "One accepted strengthening to a uniform relative gap. Prior qualitative strictness, N=3 exact optimum, distinct-odd-semiprime classification and historical weaker polynomial gap are inherited, not new credit.",
    "limits": "Nonoptimal lower bound only. No exact values, optimizer, optimal constant, matching upper bound, broader-budget quantitative classification, global support classification, historical novelty clearance, FFT gain, arithmetic-cost improvement or owner closure.",
    "comparison": "Classical Welch and quadrangularity ingredients credited. No directly matched published bound or optimum established in the bounded pass; this is not proof of absence.",
    "unread_sources": "Welch 1974 original full text unread; Holland-Wathen-Shaw full article and appended correction unread; Cosgrove-Diaz-Griewank abstract only.",
    "validation": "Stored exact integer/cyclotomic and separately numerical controls retained. Exact identity controls use a certified rational upper bound, not exact sample spectral norms. Initial ill-conditioned numerical harness failure retained. No scientific program executed for packaging.",
    "acceptance": "Frozen candidate pending labels are historical. The included later independent mathematical verdict and separately sealed comparison verdict govern the accepted scope."
  },
