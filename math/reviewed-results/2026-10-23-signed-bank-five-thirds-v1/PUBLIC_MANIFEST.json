  "scope": {
    "disposition": "INDEPENDENTLY_ACCEPTED_IMPROVED_ORIGINAL_SIGNED_BANK_COUNT",
    "domain": "N odd, d>=4, N>=6d-2, m=N-d; supplied primitive Nth root q; characteristic not dividing N.",
    "bank_count": "At most 2(N-d)+2 original signed phase-weighted resolvent banks. For every odd N>=23, choose d=floor((N+2)/6): B<=2N-2floor((N+2)/6)+2=5N/3+O(1).",
    "delta": "First-order variable-coefficient Fourier-envelope cancellation improves the prior N>=8d-10 sufficient threshold and 7N/4+O(1) upper bound in the same original bank model. The leading constant decreases by1/21, approximately4.7619%; this is not a universal finite-N percentage or runtime gain.",
    "grammar": "Original individual signed phase-weighted resolvent banks, same enlarged envelope, both cross-sign singleton nodes, nonzero physical nodes and Delta guards; no zero-node/derivative/trace atoms, new generators, products or endpoint maps.",
    "field": "Genuine algebraic splitting extension remains necessary. Finite coefficient extension degree2 is not splitting degree; stated total extension upper bound2*(N-d)! remains.",
    "cost": "All setup, coefficient search, field construction, splitting/root enumeration, amplitudes/raw weights, inversions, storage, tests/addressing and input/output costs remain charged. Warm literal application costs2BN^2 multiplications and2BN^2-BN-N additions over the actual splitting field, hence cubic with B=Theta(N), before base-field expansion.",
    "controls": "31,713 independent exact normal/optimized checks. No full literal root instantiation claimed executed. Controls support the proof, not universal extrapolation.",
    "not_claimed": [
      "FFT or runtime improvement",
      "efficient full compiler",
      "polynomial splitting degree",
      "optimality",
      "base-field attainment",
      "worldwide novelty clearance",
      "new discovery count",
      "priority or parent-owner closure"
    ],
    "other_results": "This package covers only the accepted first-order support theorem; separately accepted or pending constructions retain their own scope and are not silently composed."
  },
