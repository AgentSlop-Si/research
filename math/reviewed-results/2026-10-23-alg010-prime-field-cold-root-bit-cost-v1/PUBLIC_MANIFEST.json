  "schema": "reviewed-scientific-result-public-package-v1",
  "package": "ALG010 represented-prime-field cold-root and bit-cost child",
  "date_utc": "2026-10-23",
  "scope": {
    "status": "ACCEPT_SCOPED_WITH_MANDATORY_REVIEW_CLARIFICATIONS",
