  need(pos==cdoff and central==len(raw)-22,'no ZIP prefix, suffix, gap or hidden record')

def zip_members(raw):
 envelope(raw)
 out={};fold=set()
 with zipfile.ZipFile(io.BytesIO(raw)) as z:
  need(not z.comment,'archive comment forbidden');infos=z.infolist();need(len(infos)<=3000 and sum(i.file_size for i in infos)<=64*1024**2,'archive budget')
  for i in infos:
   need(i.orig_filename==i.filename and not i.comment and not i.extra,'hidden member metadata');n=route(i.filename);need(not i.is_dir() and not i.flag_bits&1,'directory/encrypted archive entry');need(n not in out and n.casefold() not in fold,'duplicate/case archive entry')
   need(stat.S_IFMT(i.external_attr>>16) in (0,stat.S_IFREG),'archive member type');fold.add(n.casefold());out[n]=z.read(i)
  for n in out:need(not any('/'.join(n.split('/')[:j]).casefold() in fold for j in range(1,len(n.split('/')))),'archive file/directory conflict')
  need(z.testzip() is None,'CRC failure')
 return out
def extract(raw,dest):
 need(not dest.exists() and not dest.is_symlink(),'extraction destination exists');members=canonical_members(raw)
 for n,b in members.items():privacy(n,b)
 dest.mkdir(parents=True)
 try:
  for n,b in members.items():
   p=dest/n;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
 except Exception:shutil.rmtree(dest);raise
 return len(members)
def canonical_zip(members):
