  mounts=list(dict.fromkeys(str(Path(p)) for p in ['/usr','/lib','/lib64',sys.prefix] if Path(p).exists()))
  def run(label,args,cpu=60,wall=90,memory=1024**3,expected_returncode=0):
   target=out/label;target.mkdir();cap={'cpu_seconds':cpu,'wall_seconds':wall,'address_space_bytes':memory,'file_size_bytes':64*1024**2,'core_bytes':0,'numerical_threads':1}
   def limits():
    for name,n in [(resource.RLIMIT_CPU,cpu),(resource.RLIMIT_AS,memory),(resource.RLIMIT_FSIZE,64*1024**2),(resource.RLIMIT_CORE,0)]:resource.setrlimit(name,(n,n))
   rec={'label':label,'logical_arguments':args,'caps':cap,'status':'FAIL','phase':'RUNNING','expected_returncode':expected_returncode};put(target/'RESULT.json',rec)
   proc=None;started=time.monotonic();error=None;rc=None;timed_out=False
   with policy.open('rb') as f:
    cmd=['bwrap','--die-with-parent','--new-session','--unshare-user','--unshare-pid','--unshare-ipc','--unshare-uts']
    for x in mounts:cmd+=['--ro-bind',x,x]
    cmd+=['--ro-bind',str(stage),'/input','--bind',str(work),'/work','--proc','/proc','--dev','/dev','--tmpfs','/tmp','--chdir','/work','--clearenv','--setenv','PATH','/usr/bin:/bin','--setenv','HOME','/tmp','--setenv','OPENBLAS_NUM_THREADS','1','--setenv','OMP_NUM_THREADS','1','--setenv','MKL_NUM_THREADS','1','--setenv','NUMEXPR_NUM_THREADS','1','--setenv','PYTHONDONTWRITEBYTECODE','1','--setenv','PYTHONHASHSEED','0','--seccomp',str(f.fileno()),sys.executable,'-I','-B']+args
    replacements={str(stage):'<STAGED_EXACT_ZIP_INPUT>',str(work):'<REPLAY_WORK_DIRECTORY>',str(sentinel):'<UNMOUNTED_HOST_SENTINEL>',str(ROOT):'<ORIGINAL_RUNNER_DIRECTORY>',str(ROOT.parent):'<ORIGINAL_PARENT_DIRECTORY>',str(archive):'<ORIGINAL_ARCHIVE>',sys.executable:'<PYTHON_EXECUTABLE>',sys.prefix:'<PYTHON_RUNTIME>',str(f.fileno()):'<SECCOMP_POLICY_FD>'}
    rec['logical_arguments']=[replacements.get(x,x) for x in args];rec['normalized_argv']=[replacements.get(x,x) for x in cmd];put(target/'RESULT.json',rec)
    try:
     with (target/'STDOUT.txt').open('wb') as stdout,(target/'STDERR.txt').open('wb') as stderr:
      proc=subprocess.Popen(cmd,stdout=stdout,stderr=stderr,pass_fds=(f.fileno(),),preexec_fn=limits,start_new_session=True)
      rec['child_started']=True;rec['child_pid']=proc.pid;put(target/'RESULT.json',rec)
      try:rc=proc.wait(timeout=wall)
      except subprocess.TimeoutExpired:timed_out=True;raise
    except BaseException as e:error=e
    finally:
     if proc is not None and proc.poll() is None:
      os.killpg(proc.pid,signal.SIGKILL);proc.wait()
     if proc is not None:rc=proc.returncode
     rec.update(phase='FINISHED',status='PASS' if error is None and not timed_out and rc==expected_returncode else 'FAIL',returncode=rc,timed_out=timed_out,elapsed_wall_seconds=round(time.monotonic()-started,6),stdout_sha256=H((target/'STDOUT.txt').read_bytes()) if (target/'STDOUT.txt').exists() else None,stderr_sha256=H((target/'STDERR.txt').read_bytes()) if (target/'STDERR.txt').exists() else None)
     if error:rec['failure_type']=type(error).__name__
     put(target/'RESULT.json',rec);COMMANDS.append(rec);put(out/'COMMANDS.json',COMMANDS)
   if error:raise error
   need(rec['status']=='PASS',label+' failed; durable raw logs and result retained')
   return (target/'STDOUT.txt').read_bytes()
  run('isolation_probe',['/input/tools/isolation_probe.py',str(sentinel),str(ROOT),str(ROOT.parent),str(archive)],15,30)
  run('isolation_probe_optimized',['-O','/input/tools/isolation_probe.py',str(sentinel),str(ROOT),str(ROOT.parent),str(archive)],15,30)
  for optimized in [False,True]:
   prefix=['-O']if optimized else[];suffix='_optimized'if optimized else''
   run('public_integrity'+suffix,prefix+['/input/tools/verify.py'],30,60)
   run('public_negative_controls'+suffix,prefix+['/input/tools/verify.py','--negative-controls'],90,120)
  comparisons=[];(out/'scientific_outputs').mkdir()
  for spec in v.read(stage/'REPLAY_POLICY.json')['current_scientific_programs']:
   for optimized in [False,True]:
    role=spec['role'];label=role+('_optimized' if optimized else '');args=(['-O']if optimized else[])+['/input/tools/run_case.py',role]
    stdout=run(label+'_controls',args,180,210,1024**3);data=(work/label/spec['result']).read_bytes();ref=(stage/spec['reference']).read_bytes()
    (out/'scientific_outputs'/(label+'.json')).write_bytes(data)
    need(data==ref,'scientific result bytes differ: '+label)
    need(len(stdout)==spec['stdout_bytes'] and H(stdout)==spec['stdout_sha256'],'scientific stdout bytes differ')
    stderr=(out/(label+'_controls')/'STDERR.txt').read_bytes();need(len(stderr)==spec['stderr_bytes'] and H(stderr)==spec['stderr_sha256'],'scientific stderr bytes differ')
    result={'case':label,'result_byte_exact':True,'stdout_byte_exact':True,'stdout_sha256':H(stdout)}
    result.update(optimized_python=optimized,script_sha256=H((stage/spec['script']).read_bytes()),result_sha256=H(data),reference_sha256=H(ref),raw_result_bytes_preserved=True,raw_stdout_bytes_preserved=True,program_arithmetic_unchanged=True)
    optimization=(work/label/'OPTIMIZATION.json').read_bytes();(out/'scientific_outputs'/(label+'_OPTIMIZATION.json')).write_bytes(optimization);state=v.loads(optimization);v.same(state,{'optimize':int(optimized),'debug':not optimized,'assert_executed':not optimized},'actual child optimization semantics');result['actual_child_optimization_probe']=state;result['scientific_stderr_byte_exact']=True;result['stderr_sha256']=H(stderr);result['scientific_stderr_empty']=(stderr==b'')
    comparisons.append(result)
