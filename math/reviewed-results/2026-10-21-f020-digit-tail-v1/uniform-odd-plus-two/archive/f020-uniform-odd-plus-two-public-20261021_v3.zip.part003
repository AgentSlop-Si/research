       if running.get('phase')=='RUNNING' and running.get('child_started')is True:break
      time.sleep(.005)
     initial=read(target/'REPLAY_RESULT.json');need(initial['status']=='FAIL' and initial['phase']=='RUNNING','missing durable initial FAIL');os.kill(proc.pid,sig);rc=proc.wait(timeout=20)
   finally:
    if proc is not None and proc.poll()is None:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
