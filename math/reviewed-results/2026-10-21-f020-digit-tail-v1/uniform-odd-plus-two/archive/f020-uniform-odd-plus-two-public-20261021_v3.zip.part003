  need(re.search('-----BEGIN '+r'(?:RSA |EC |OPENSSH )?PRIVATE KEY-----',s)is None,'key marker')
  need(re.search(r'(?:gh[pousr]_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{32,})',s)is None,'credential marker')
  extra=['file'+':'+ '//','sandbox'+':'+ '//','sediment'+':'+ '//','functions'+'.exec','cloud'+'_browser_handoff','library'+'_file_id','/'+'var'+'/folders/']
  need(not any(t.lower() in s.lower() for t in extra),'private scheme or coordination marker')
  need(re.search(r'Bearer\s+[A-Za-z0-9._-]{20,}',s,re.I)is None,'bearer marker')
