   with (out/(label+'.stdout')).open('wb')as stdout,(out/(label+'.stderr')).open('wb')as stderr:p=subprocess.run([sys.executable,'-I','-B']+argv,stdout=stdout,stderr=stderr,timeout=timeout,env=env)
   return p.returncode
  target=out/'wrong_digest';rc=run('wrong_digest',args(target,'0'*64));rec=read(target/'REPLAY_RESULT.json');need(rc!=0 and rec['status']=='FAIL','bad pin did not fail durably');rows.append({'case':'wrong_digest','returncode':rc,'durable_status':'FAIL'})
