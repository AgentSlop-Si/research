 except UnicodeError:raise ValueError('unclassified binary member: '+name)
 if name.endswith('.json'):loads(text)
 tokens=['/'+p+'/' for p in ('work'+'space','home','root','tmp','users','mnt','media')]+['cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','delivery'+'_context','thread'+'_id','lib'+'file_','codex'+':','chatgpt'+'.com']
 for s in itertools.chain(text_variants(name),text_variants(text)):
