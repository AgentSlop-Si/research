   same(entry['index'],index,'historical row index');same(entry['path'],rel,'historical row path');same(entry['declared_identity'],declared,'historical declaration');need(entry['schema']==schema,'historical schema');q=parent+rel if rel is not None else None
   if q not in members:need(entry['disposition']=='absent_in_original_public_archive','historical absence qualification');closed=False
   elif members[q]['disposition']=='raw_runtime_log_omitted':need(entry['disposition']=='raw_runtime_log_omitted','historical log omission qualification');same(entry['archive_member_identity'],members[q]['original'],'historical omitted log identity');closed=False
   else:
