 expected_roles={(c,str(p.parent.relative_to(root/c)))for c in SOURCES for p in(root/c).rglob('MANIFEST.json')if p.parent!=root/c};same(role_roots,expected_roles,'all nested manifests qualified')
 hist=read(root/'provenance/HISTORICAL_ARCHIVE_LEDGER.json');need(hist['raw_logs_exported']is False and hist['fresh_historical_execution']is False and hist['archive_envelopes_omitted']is True and hist['archive_envelopes_rewritten']is False,'history disclosure');same(len(hist['archives']),1,'one accepted historical archive');a=hist['archives'][0];identity(a['original_archive']);need(a['original_archive']['sha256']==DEP_SHA and a['envelope_retained']is False,'archive identity/omission');same(a['original_archive'],originals[('author','sources/accepted-uniform-adjacent-author/sources/accepted-c3-author/sources/accepted-single-leading-digit-comparison.zip')],'source archive identity');coll=a['collection'];members={};logs=0
