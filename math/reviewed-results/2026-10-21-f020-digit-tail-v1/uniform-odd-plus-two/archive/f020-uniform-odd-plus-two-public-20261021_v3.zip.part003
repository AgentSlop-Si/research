   if sig==signal.SIGTERM:need(rec.get('failure_type')=='InterruptedError' and 'phase'not in rec,'caught signal not terminal FAIL')
   else:need(rec['phase']=='RUNNING' and rec['completion_is_not_established']is True,'uncatchable kill not visibly incomplete')
   rows.append({'case':label,'returncode':rc,'durable_receipt':rec,'raw_logs_retained':True,'interrupted_actual_scientific_child':True})
  # Retry into the killed run must refuse without changing its original failure receipt or logs.
  target=out/'uncatchable_kill';snapshot={p.relative_to(target).as_posix():p.read_bytes()for p in target.rglob('*')if p.is_file()};rc=run('preserve_failed_receipts',args(target));need(rc!=0 and snapshot=={p.relative_to(target).as_posix():p.read_bytes()for p in target.rglob('*')if p.is_file()},'failed-run evidence overwritten');rows.append({'case':'preserve_failed_receipts','returncode':rc,'all_failed_receipts_and_logs_unchanged':True})
  after={p.relative_to(ROOT).as_posix():hashlib.sha256(p.read_bytes()).hexdigest()for p in ROOT.rglob('*')if p.is_file()};need(before==after and hashlib.sha256(archive.read_bytes()).hexdigest()==pin,'frozen input changed');report={'status':'PASS','input_zip_sha256':pin,'cases':rows,'frozen_input_unchanged':True};r.put(result,report);print(json.dumps(report,indent=2,sort_keys=True))
 except BaseException as e:r.put(result,{'status':'FAIL','failure_type':type(e).__name__,'incomplete_or_failed_is_never_PASS':True});raise
if __name__=='__main__':main()
