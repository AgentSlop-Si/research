   name=raw[pos+30:pos+30+ns];need(name.decode('utf8' if flags&0x800 else 'cp437')==i.orig_filename,'local name consistency');start=pos+30+ns+xs;end=start+cs;need(end<=cdoff,'local data span');comp=raw[start:end]
