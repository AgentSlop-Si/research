"""Actively test inaccessible host paths, immutable input, and native network denial."""
import ctypes,errno,json,os,socket,sys
from pathlib import Path
def need(b,m):
 if not b:raise RuntimeError(m)
paths=sys.argv[1:];need(len(paths)>=3,'host probe arguments required')
for p in paths:
 need(not Path(p).exists(),'original host locator exposed')
 try:os.open(p,os.O_RDONLY)
 except OSError as e:need(e.errno in(errno.ENOENT,errno.EACCES),'unexpected host-open errno')
 else:raise RuntimeError('original host open succeeded')
for family in(socket.AF_INET,socket.AF_INET6,socket.AF_UNIX):
 try:socket.socket(family,socket.SOCK_STREAM)
 except OSError as e:need(e.errno==errno.EPERM,'unexpected Python socket errno')
 else:raise RuntimeError('Python socket succeeded')
libc=ctypes.CDLL(None,use_errno=True);libc.socket.argtypes=[ctypes.c_int]*3
for family in(2,10,1):
 ctypes.set_errno(0);fd=libc.socket(family,1,0);need(fd==-1 and ctypes.get_errno()==errno.EPERM,'native network not denied')
need(Path('/input/author/REPORT.md').is_file(),'input not readable')
try:os.open('/input/WRITE_PROBE',os.O_WRONLY|os.O_CREAT,0o600)
except OSError as e:need(e.errno in(errno.EROFS,errno.EACCES,errno.EPERM),'unexpected immutable-input errno')
else:raise RuntimeError('input was writable')
Path('/work/probe.txt').write_text('writable isolated replay directory')
print(json.dumps({'status':'PASS','unmounted_host_paths_checked':len(paths),'python_socket_families_denied':3,'native_libc_socket_families_denied':3,'input_readable':True,'input_write_rejected':True,'isolated_output_writable':True}))
PK␀␀␀␀␀␀␀!␀Úç‘Ÿ2.␀␀2.␀␀<␀␀␀f020-uniform-odd-plus-two-public-20261021_v3/tools/replay.py#!/usr/bin/env python3
"""Exact-ZIP, durable, capped current-program replay with kernel isolation."""
from pathlib import Path
import argparse,re,hashlib,importlib.util,json,math,os,platform,resource,shutil,signal,struct,subprocess,sys,tempfile,time
ROOT=Path(__file__).resolve().parents[1]
OUT=None
COMMANDS=[]
def need(x,msg):
 if not x:raise ValueError(msg)
def H(b):return hashlib.sha256(b).hexdigest()
def put(p,x):
 temp=p.with_name(p.name+'.pending')
 with temp.open('w') as f:
  f.write(json.dumps(x,indent=2)+'\n');f.flush();os.fsync(f.fileno())
 temp.replace(p)
 fd=os.open(p.parent,os.O_RDONLY|os.O_DIRECTORY)
 try:os.fsync(fd)
 finally:os.close(fd)
def stop(signum,frame):raise InterruptedError('Replay received signal '+str(signum))
def main():
 global OUT
 p=argparse.ArgumentParser();p.add_argument('--archive',required=True);p.add_argument('--expect-sha256',required=True);p.add_argument('--output',required=True);a=p.parse_args()
 requested=Path(a.output).absolute();need(not requested.is_symlink(),'Output symlink forbidden');out=requested.resolve();need(out!=ROOT and ROOT not in out.parents and not out.exists(),'Output must be new and outside the frozen input');out.mkdir(parents=True);OUT=out
 put(out/'REPLAY_RESULT.json',{'status':'FAIL','phase':'RUNNING','completion_is_not_established':True})
 for sig in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP):signal.signal(sig,stop)
 spec=importlib.util.spec_from_file_location('public_verify',ROOT/'tools/verify.py');v=importlib.util.module_from_spec(spec);spec.loader.exec_module(v)
 need(v.HEX.fullmatch(a.expect_sha256),'trusted archive digest required');archive=Path(a.archive).resolve();raw=archive.read_bytes();raw_archive=raw;need(H(raw)==a.expect_sha256,'archive SHA-256 mismatch')
 need(platform.system()=='Linux' and platform.machine()=='x86_64','Retained replay profile requires Linux x86-64');need(shutil.which('bwrap'),'bubblewrap is required; no weaker fallback')
 need(sys.version_info[:2]==(3,12),'CPython 3.12 required; see requirements')
 put(out/'ENVIRONMENT.json',{'python':sys.version.split()[0],'system':platform.system(),'architecture':platform.machine(),'kernel_release':platform.release()})
 # x86-64 architecture guard, x32 rejection, native network/io_uring syscall denial.
 denied=list(range(41,56))+[288,299,307,425,426,427]
 ins=[(0x20,0,0,4),(0x15,1,0,0xc000003e),(0x06,0,0,0x80000000),(0x20,0,0,0),(0x45,0,1,0x40000000),(0x06,0,0,0x00050001)]
 for n in denied:ins.extend([(0x15,0,1,n),(0x06,0,0,0x00050001)])
 ins.append((0x06,0,0,0x7fff0000));filt=b''.join(struct.pack('HBBI',*x) for x in ins)
 put(out/'ISOLATION_POLICY.json',{'method':'bubblewrap mount/PID/IPC/UTS namespaces plus architecture-checked kernel seccomp','network_namespace_used':False,'network_policy':'Socket, network and io_uring syscalls return EPERM; inherited descriptors except policy and standard streams are closed.','denied_x86_64_syscalls':denied,'seccomp_bpf_sha256':H(filt),'runtime_mounts':'Read-only operating-system libraries and active Python runtime','input_mount':'Exact safely extracted delivery ZIP, read-only at /input','writable_mount':'Fresh replay directory at /work and private temporary filesystem','original_workspace_mounted':False,'weaker_fallback':False})
 put(out/'INPUT_ARCHIVE.json',{'sha256':H(raw),'bytes':len(raw),'package_root':v.PACKAGE,'caller_supplied_trusted_digest_matched':True})
 with tempfile.TemporaryDirectory(prefix='uniform-odd-plus-two-mount-replay-') as td:
  tmp=Path(td);extract=tmp/'extract';v.canonical_members(raw);v.extract(raw,extract);need({x.name for x in extract.iterdir()}=={v.PACKAGE},'ZIP package root');stage=extract/v.PACKAGE
  put(out/'INTEGRITY_BEFORE.json',v.integrity(stage));before={n:v.ident((stage/n).read_bytes()) for n in v.inventory(stage)}
  need((stage/'tools/replay.py').read_bytes()==Path(__file__).read_bytes(),'Runner is not the exact ZIP runner');need((stage/'tools/verify.py').read_bytes()==(ROOT/'tools/verify.py').read_bytes(),'Verifier is not the exact ZIP verifier')
  (out/'INPUT_MANIFEST.json').write_bytes((stage/'MANIFEST.json').read_bytes())
