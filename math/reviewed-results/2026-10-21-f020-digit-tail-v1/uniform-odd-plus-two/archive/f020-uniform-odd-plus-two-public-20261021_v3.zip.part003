 with zipfile.ZipFile(b,'w',compression=zipfile.ZIP_STORED) as z:
  for n,data in sorted(members.items()):
   route(n);i=zipfile.ZipInfo(n,(1980,1,1,0,0,0));i.create_system=3;i.external_attr=0o100644<<16;i.compress_type=zipfile.ZIP_STORED;z.writestr(i,data)
 return b.getvalue()
def canonical_members(raw):
 members=zip_members(raw);need(raw==canonical_zip(members),'noncanonical archive bytes');need({n.split('/')[0] for n in members}=={PACKAGE},'archive package root');return members

