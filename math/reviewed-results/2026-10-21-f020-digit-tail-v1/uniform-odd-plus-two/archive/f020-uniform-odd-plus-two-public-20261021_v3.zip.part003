  rc=run('missing_digest',[str(ROOT/'tools/replay.py'),'--archive',str(archive),'--output',str(out/'missing_digest')]);need(rc!=0 and not(out/'missing_digest').exists(),'missing digest accepted');rows.append({'case':'missing_digest','returncode':rc,'not_started':True})
