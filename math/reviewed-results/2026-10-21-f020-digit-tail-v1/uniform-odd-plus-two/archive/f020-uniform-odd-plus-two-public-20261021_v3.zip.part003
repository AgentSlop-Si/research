   same(sorted(present),sorted(role['retained_listed_files']),'retained inventory paths');same(set(missing),{x[pf]for x in obj[field]}-set(present),'missing inventory paths');need(role['original_inventory_completely_retained']is(not missing),'partial inventory qualification')
 expected_json={(coll,p.relative_to(root/coll).as_posix(),field)for coll in SOURCES for p in(root/coll).rglob('*.json')for field,pf in fields(read(p))}
