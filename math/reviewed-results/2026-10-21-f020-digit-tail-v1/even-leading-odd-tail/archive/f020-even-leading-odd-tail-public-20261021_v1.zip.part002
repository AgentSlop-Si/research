PK␀␀␀␀␀␀␀!␀FiÿÄÇ␀␀Ç␀␀]␀␀␀f020-even-leading-odd-tail-public-20261021_v1/independent-review/check_inventory_mutations.py#!/usr/bin/env python3
"""Reject independent disposable-copy corruptions without modifying the frozen author."""
import argparse,hashlib,json,shutil,subprocess,sys,tempfile
from pathlib import Path

def run(author):
    cases=['proof_edit','missing_file','unlisted_file','seal_mismatch','rehashed_replacement','symlink_report'];out=[]
    for case in cases:
        with tempfile.TemporaryDirectory(prefix='f020-mixed-negative-') as tmp:
            root=Path(tmp)/'candidate';shutil.copytree(author,root)
            if case in ['proof_edit','rehashed_replacement']:
                p=root/'REPORT.md';p.write_bytes(p.read_bytes()+b'\nchanged\n')
            if case=='missing_file':(root/'CONTROL_RESULTS.json').unlink()
            if case=='unlisted_file':(root/'UNLISTED.txt').write_text('unexpected')
            if case=='seal_mismatch':
                p=root/'SEAL.json';j=json.loads(p.read_text());j['manifest_sha256']='0'*64;p.write_text(json.dumps(j))
            if case=='rehashed_replacement':
                p=root/'MANIFEST.json';j=json.loads(p.read_text())
                for row in j['files']:
                    if row['path']=='REPORT.md':row['bytes']=(root/'REPORT.md').stat().st_size;row['sha256']=hashlib.sha256((root/'REPORT.md').read_bytes()).hexdigest()
                p.write_text(json.dumps(j));sp=root/'SEAL.json';sj=json.loads(sp.read_text());sj['manifest_sha256']=hashlib.sha256(p.read_bytes()).hexdigest();sj['report_sha256']=hashlib.sha256((root/'REPORT.md').read_bytes()).hexdigest();sp.write_text(json.dumps(sj))
            if case=='symlink_report':
                (root/'REPORT.md').unlink();(root/'REPORT.md').symlink_to(author/'REPORT.md')
            r=subprocess.run([sys.executable,'-I','-B',str(Path(__file__).with_name('verify_author.py')),str(root)],capture_output=True,timeout=20)
            if r.returncode==0:raise RuntimeError('mutation escaped: '+case)
            out.append({'mutation':case,'status':'REJECTED','returncode':r.returncode})
    return {'status':'PASS','frozen_author_modified':False,'mutations':out}
if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('candidate',type=Path);a=p.parse_args();print(json.dumps(run(a.candidate),indent=2,sort_keys=True))
PK␀␀␀␀␀␀␀!␀	‚­7␀␀­7␀␀X␀␀␀f020-even-leading-odd-tail-public-20261021_v1/independent-review/independent_controls.py#!/usr/bin/env python3
"""Independent bounded controls, without imports from candidate or predecessor programs.
The uniform proof, not this finite suite, establishes the theorem.
"""
from fractions import Fraction as F
from math import comb, prod
from pathlib import Path
import hashlib, json, time
import numpy as np
import sympy as sy


def need(ok, why):
    if not ok: raise RuntimeError(why)


def hermite(c):
    a,b=[1],[0,1]
    if c==0:return a
    for j in range(1,c):
        v=[0]+b
        for k,z in enumerate(a):v[k]+=j*z
        a,b=b,v
    return b


def jetmul(a,b):return [sum(a[j]*b[k-j] for j in range(k+1)) for k in range(3)]
def jetadd(a,b):return [x+y for x,y in zip(a,b)]
def jetquot(a,b):
    c=[]
    for k in range(3):c.append((a[k]-sum(b[j]*c[k-j] for j in range(1,k+1)))/b[0])
    return c

def tail_controls():
    # Propagate constant and X-linear terms of the ORIGINAL two recurrences at X=0.
    e=o=v=[F(1),F(0),F(0)]
    rows=[]
    for m in range(0,51):
        if m:
            ae=[F(2*m),F(comb(2*m,2)),F(comb(2*m,3))]
            ao=[F(2*m-1),F(comb(2*m-1,2)),F(comb(2*m-1,3))]
            e=jetmul(ao,e)
            o=jetadd(e,jetmul(ae,o))
            v=jetmul(ae,v)
        C=prod(range(1,2*m+2,2)); B=prod(range(2,2*m+1,2));alpha=F(B,C)
        k=jetquot(v,o)
        want=[alpha,alpha*F(m,6),alpha*F(m*(7*m-27),360)]
        need(k==want,f'tail ratio m={m}')
        need(o[0]==C and v[0]==B,'tail constants')
        rows.append({'m':m,'alpha':str(alpha),'kappa_jet':[str(z) for z in k]})
    m=sy.Symbol('m')
    first=F(1,8)+m/6
    second=m*(7*m-27)/360-sy.Rational(9,128)
    need(sy.expand(first-(4*m+3)/24)==0,'first correction')
    need(second.subs(m,-sy.Rational(3,4))==-sy.Rational(1,320),'second correction')
    return rows


def polynomial_controls():
    U=sy.Symbol('U'); rows=[];count=0;two=[]
    for p in sy.primerange(3,102):
        for c in range(2,p,2):
            h=hermite(c)
            R=sy.Poly(sum(h[2*k]*U**k for k in range(c//2+1)),U,modulus=p)
            need(sy.gcd(R,R.diff()).degree()==0,'R inseparable')
            need(int(R.eval(0))%p!=0,'R zero constant')
            for d in range(1,p,2):
                count+=1;m=(d-1)//2
                C=prod(range(1,2*m+2,2));B=prod(range(2,2*m+1,2))
                alpha=B*pow(C,-1,p)%p
                ob=int(R.eval(-alpha))%p
                if not ob:
                    rp=int(R.diff().eval(-alpha))%p
                    need(rp!=0,'obstructed multiple R root')
                    lift=0 if p==3 else 2 if (2*d+1)%p==0 else 1
                    need(lift!=2 or p>=7 and p==2*d+1,'small prime second lift')
                    unit=(-B*pow(alpha,(p-1)//2,p)*rp*(2*d+1)*pow(12,-1,p))%p if lift==1 and p>=5 else (B*pow(alpha,(p-1)//2,p)*rp*pow(160,-1,p))%p if p>=7 else None
                    need(unit is None or unit!=0,'unit vanishes')
                    row={'p':int(p),'c':c,'d':d,'alpha_mod_p':alpha,'lift':lift,'derivative_unit':unit}
                    rows.append(row)
                    if lift==2:two.append(row)
    need(any(r['p']==5 and r['c']==4 and r['d']==3 for r in rows),'p5 mixed boundary missing')
    need(any(r['p']==43 and r['c']==24 and r['d']==21 for r in two),'genuine mixed double missing')
    # Full inseparable root/ordinary-derivative residual gcd, not just a scalar census.
    Y=sy.Symbol('Y');gcdrows=[]
    for p,c,d in [(5,4,1),(5,4,3),(7,6,5),(11,8,3),(11,8,7)]:
        m=(d-1)//2;C=prod(range(1,2*m+2,2));B=prod(range(2,2*m+1,2));alpha=B*pow(C,-1,p)%p
        hc,hm=hermite(c),hermite(c-1)
        f=sy.Poly(sum(z*Y**(k*p) for k,z in enumerate(hc)),Y,modulus=p)
        dr=sy.Poly(sum(z*(Y**(k*p)+alpha*Y**(k*p-2)) for k,z in enumerate(hm) if z),Y,modulus=p)
        gd=sy.gcd(f,dr).degree()
        obstruction=sum(z*pow(-alpha,k//2,p) for k,z in enumerate(hc) if z)%p==0
        need(gd==(2 if obstruction else 0),'gcd degree vs root multiplicity')
        gcdrows.append({'p':p,'c':c,'d':d,'gcd_degree':gd,'affected_root_count':2*p if obstruction else 0})
    return {'parameter_rows':count,'obstructions':rows,'simultaneous_controls':two,'full_Y_gcd_controls':gcdrows}


def qfactorial_controls():
    rows=[]
    for p in sy.primerange(5,102):
        B=p*(p-1);A=(p*p-1)//2;jet=[1,0,0];weight=0
        for k in range(1,A+1):
            j=2*k
            if j%p:
                f=[-j%p,-comb(j,2)%p,-comb(j,3)%p];weight+=1
            else:
                f=[-(j//p)%p,0,0];weight+=p
            jet=[v%p for v in jetmul(jet,f)]
        need(weight==B,'Q weight')
        want=[-1%p,pow(8,-1,p),-9*pow(128,-1,p)%p]
        need(jet==want,'actual normalized Q jet')
        rows.append({'p':int(p),'Q_jet':jet})
    return rows


def all_pivot_gaps():
    rows=[];pairs=0
    for p in [5,7,11,13]:
        N=p*p;rho=F(p,2);g=F(p-1,2);B=p*(p-1)
        for c in range(2,p,2):
            if c*N>1400:continue
            n=c*N;W=[0];T=[]
            for j in range(1,n+1):
                a=j;x=1
                while a%p==0:a//=p;x*=p
                W.append(W[-1]+x)
            T=[F(j)+(rho-1)*((j+p-1)//p) for j in range(n+1)]
            K=F(c*N,2)+c*B;E=K-F(N,2);D=E+N-p
            np=[];dp=[];mp=[];mingap=None
            for k in range(0,n+1,2):
                val=W[n]-W[(n-k)//2]+T[k]-W[k]
                if val==K:np.append(k)
                else:need(val>=K+F(B,2)+g,'even nonpivot gap')
                for u in range(k):
                    j=k-u;a=j;x=1
                    while a%p==0:a//=p;x*=p
                    val=W[n]-W[(n-k)//2]+T[u]-W[u]-x;pairs+=1
                    if val==D:dp.append([k,u])
                    else:need(val>=D+g,'ordinary derivative nonpivot gap')
            need(np==list(range(0,n+1,2*N)),'all even pivots')
            need(dp==[[l*N+N,l*N] for l in range(1,c,2)],'all derivative pivots including endpoint')
            for k in range(1,n,2):
                val=W[n-1]-W[(n-1-k)//2]+T[k]-W[k]
                if val==E:mp.append(k)
                else:need(val>=E+g,'neighbor nonpivot gap')
                for u in range(k):
                    j=k-u;a=j;x=1
                    while a%p==0:a//=p;x*=p
                    val=W[n-1]-W[(n-1-k)//2]+T[u]-W[u]-x;pairs+=1
                    need(val>=E,'full neighbor derivative lower bound')
            need(mp==list(range(N,n,2*N)),'all neighbor pivots')
            rows.append({'p':p,'c':c,'even_pivots':np,'derivative_pivots':dp,'neighbor_pivots':mp})
    return {'rows':rows,'complete_term_pairs':pairs}


def scalar_A(p,c,d,b):
    # Scalar ORIGINAL parity recurrence over F_p[t], not Newton products.
    N=p*p;B=p*(p-1);K=c*N//2+c*B;cap=K+b*p+3
    m=(d-1)//2;C=prod(range(1,2*m+2,2));Bt=prod(range(2,2*m+1,2));alpha=Bt*pow(C,-1,p)%p
    one=np.zeros(cap+1,dtype=np.int64);one[0]=1;E=one.copy();O=one.copy()
    def edge(j):
        z=np.zeros(cap+1,dtype=np.int64)
        for k in range(1,min(j,cap)+1):z[k]=comb(j,k)%p
        return z
    def times(a,edge):
        ans=np.zeros(cap+1,dtype=np.int64)
        for shift in np.flatnonzero(edge):ans[shift:]+=edge[shift]*a[:cap+1-shift]
        # No overflow: sum has <=cap terms each at most (p-1)^2.
        need(cap*(p-1)**2<2**63,'integer accumulation cap')
        return ans%p
    for j in range(1,c*N//2+1):
        Y=np.zeros_like(O);Y[p:]=(-alpha*O[:-p])%p
        E=(Y+times(E,edge(2*j-1)))%p
        O=(E+times(O,edge(2*j)))%p
    nonzero=np.flatnonzero(E)
    valuation=int(nonzero[0]) if len(nonzero) else None
    need(valuation is None or valuation>K+b*p,'scalar A insufficient lift')
    e=(p-1)*p*p;raw=c*N//2
    need(e+raw>K+b*p,'mixed-characteristic raw lattice margin')
    return {'p':p,'c':c,'d':d,'alpha_mod_p':alpha,'K':K,'required_strict_threshold':K+b*p,'first_nonzero_mod_p':valuation,'precision':cap,'minimal_s_pdiv_margin':e+raw-K}


def uniform_inequalities():
    # Each expression has nonnegative polynomial coefficients in a variable >=0.
    z=sy.Symbol('z');rows=[]
    for base,b in [(5,1),(7,2)]:
        p=z+base;N=p*p;B=p*(p-1)
        tests={'group_N':p*(p-2)/2-b*p,'group_C':p*(p-2)-b*p,'block_shift':N-p/2-b*p,'block_factorial':B-b*p,'even_nonpivot':(p*p-1)/2-b*p,'feedback_delta':B/2-b*p,'pivot_nonpivot':(p-1)/2-b,'coordinate':p/2-b}
        for name,ex in tests.items():
            poly=sy.Poly(ex,z)
            need(all(v>=0 for v in poly.all_coeffs()) and poly.eval(0)>0,'uniform strict margin '+name)
            rows.append({'range_p_at_least':base,'order':b,'quantity':name,'polynomial_in_p_minus_base':str(poly.as_expr())})
    return rows


def low_and_witness():
    X,a,A,M,Ap,Mp=sy.symbols('X a A M Ap Mp');rows=[]
    for d in [1,3,5,7,9]:
        edges=sy.symbols('b1:'+str(d))
        f0,f1=1,X;g0,g1=0,1
        for j in range(1,d):f0,f1=f1,sy.expand(X*f1-edges[j-1]*f0);g0,g1=g1,sy.expand(X*g1-edges[j-1]*g0)
        T=sy.cancel(f1/X);V=g1
        G,Gp=sy.symbols('G Gp')
        Fexpr=T*A-a*V*G
        deriv=sy.diff(T,X)*A+T*Ap-a*(sy.diff(V,X)*G+V*Gp)
        witness=T*deriv-sy.diff(T,X)*Fexpr
        rhs=T*T*Ap-a*(sy.diff(V,X)*T-V*sy.diff(T,X))*G-a*V*T*Gp
        need(sy.expand(witness-rhs)==0,'ordinary full derivative witness')
        rows.append({'odd_tail':d,'witness':'PASS'})
    low=[]
    for p,c,r,d in [(3,2,2,1),(5,4,2,3),(7,6,2,5),(5,4,3,3)]:
        n=c*p**r+d;Q0=[1];Q1=[0,1];D0=[];D1=[1]
        def add(a,b):
            z=[0]*max(len(a),len(b))
            for i,v in enumerate(a):z[i]=(z[i]+v)%p
            for i,v in enumerate(b):z[i]=(z[i]+v)%p
            while z and z[-1]==0:z.pop()
            return z
        for j in range(1,n):
            Q=add([0]+Q1,[j*v%p for v in Q0]);D=add(add(Q1,[0]+D1),[j*v%p for v in D0])
            Q0,Q1,D0,D1=Q1,Q,D1,D
        want=[0]*(c*p**r)+[z%p for z in hermite(d)]
        wantd=[0]*(c*p**r)+[d*z%p for z in hermite(d-1)]
        need(Q1==want and D1==wantd,'separate low ordinary derivative recurrence')
        low.append({'p':p,'c':c,'r':r,'d':d,'degree':n})
    return {'full_fraction_free_witnesses':rows,'separate_original_low_derivatives':low}


def original_Qstar_small_boundary():
    # Independent parity recurrences for P and its partial derivative in w=XÂ².
    p=5;c=4;d=3;N=p*p;cap=148;alpha=4;u=-alpha%p
    one=np.zeros(cap+1,dtype=np.int64);one[0]=1;zero=np.zeros_like(one)
    def edge(j):
        z=zero.copy()
        for k in range(1,min(j,cap)+1):z[k]=comb(j,k)%p
        return z
    def mul(a,b):
        return np.convolve(a,b)[:cap+1]%p
    def w(a):
        z=zero.copy();z[p:]=u*a[:-p]%p;return z
    def val(a):
        nz=np.flatnonzero(a);return int(nz[0]) if len(nz) else None
    def ratio(a,b):
        k=val(b);need(k is not None and k+2<=cap,'ratio precision')
        need(val(a) is None or val(a)>=k,'ratio integral')
        z=[]
        for i in range(3):z.append(int((a[k+i]-sum(z[j]*int(b[k+i-j]) for j in range(i)))*pow(int(b[k]),-1,p)%p))
        return z
    E=O=one.copy();Ew=Ow=zero.copy()
    for j in range(1,c*N//2+1):
        Om=O.copy();Owm=Ow.copy()
        Ew=(O+w(Ow)+mul(edge(2*j-1),Ew))%p
        E=(w(O)+mul(edge(2*j-1),E))%p
        Ow=(Ew+mul(edge(2*j),Ow))%p
        O=(E+mul(edge(2*j),O))%p
    a=(-edge(c*N))%p
    ar=ratio(2*w(Ew)%p,mul(a,Om))
    mr=ratio((Om+2*w(Owm))%p,Om)
    T=(w(one)+edge(c*N+1)+edge(c*N+2))%p
    V=(w(one)+edge(c*N+2))%p
    kap=ratio(V,T)
    kd=ratio(2*w(edge(c*N+1))%p,mul(T,T))
    km=jetmul(kap,mr)
    qs=[(ar[j]+kap[j]-km[j]-kd[j])%p for j in range(3)]
    need(ar==[1,3,0],'original derivative ratio p5')
    need(qs==[0,2,2],'complete original Qstar p5')
    need(val(E)==140,'scalar A exact finite diagnostic')
    need(ar[2]!=(u*9*pow(128,-1,p))%p,'invalid p5 order-two extrapolation not falsified')
    return {'p':p,'c':c,'d':d,'cutoff':cap,'A_scalar_order':val(E),'A_derivative_ratio':ar,'M_derivative_ratio':mr,'kappa':kap,'X_kappa_prime':kd,'full_Qstar':qs,'not_used_as_root_derivative':True}


def negative_gates():
    p=5;c=4;d=3;m=1;alpha=F(2,3)
    R=lambda u:u*u+6*u+3
    need((p-1)/2==2 and not (p-1)/2>2,'p5 second-order overreach not rejected')
    am=2*pow(3,-1,p)%p
    need(R(-am)%p==0 and R(-1)%p!=0,'wrong alpha substitution not rejected')
    N=p*p;B=p*(p-1);K=c*N//2+c*B;e=(p-1)*p*p
    need(not e>K+p and e+c*N//2>K+p,'false e-only margin not rejected')
    U=sy.Symbol('U');residual=sy.Poly((U*U+6*U+3)**p,U,modulus=p)
    need(residual.diff().is_zero,'residual differentiation negative setup')
    need(B//2>p-1,'F_U off-root counterexample gap')
    # At d=3, T/t = unit constant + t^(p-1) U. The derivative of normalized F
    # has t^(p-1) R_c(U)^p, while the correct strong bound on j_U is B/2.
    need(residual.mul_ground(1)!=sy.Poly(0,U,modulus=p),'F_U extra product term nonzero')
    need(2!=2*p,'gcd degree not multiplicity count')
    X,b1,b2=sy.symbols('X b1 b2')
    need(sy.expand((X*X-b2)-(X*X-b1))!=0,'wrong V edge start not rejected')
    return {'status':'PASS','rejected':['p5 strict second-order slack','replace arbitrary alpha by one','e-only ramification margin','differentiate Frobenius residual','assign J_U bound to F_U off roots','identify gcd degree with lifted root count','wrong associated tail edge start']}


def main():
    start=time.time()
    results={'status':'PASS','no_supplied_code_imported':True,'finite_controls_not_uniform_proof':True,
        'tail_jets':tail_controls(),'hermite_and_obstruction':polynomial_controls(),'Q_factorial':qfactorial_controls(),
        'uniform_margins':uniform_inequalities(),'original_tail_and_low':low_and_witness(),
        'all_terms':all_pivot_gaps(),
        'scalar_original_A':[scalar_A(*r) for r in [(5,4,3,1),(11,8,3,2),(11,8,7,2)]],
        'negative_controls':negative_gates(),'original_Qstar_small_boundary':original_Qstar_small_boundary()}
    results['elapsed_seconds']=round(time.time()-start,3)
    out=Path(__file__).with_name('INDEPENDENT_RESULTS.json');out.write_text(json.dumps(results,indent=2)+'\n')
    print(json.dumps({'status':'PASS','output':str(out),'sha256':hashlib.sha256(out.read_bytes()).hexdigest(),'elapsed_seconds':results['elapsed_seconds'],'complete_term_pairs':results['all_terms']['complete_term_pairs'],'parameter_rows':results['hermite_and_obstruction']['parameter_rows']},indent=2))

if __name__=='__main__':main()
