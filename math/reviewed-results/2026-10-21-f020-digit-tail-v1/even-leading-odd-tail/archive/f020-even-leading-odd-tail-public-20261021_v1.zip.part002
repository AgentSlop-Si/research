  require({r['source_path'] for r in rows}=={r['path'] for r in src['files']}|{'MANIFEST.json','SEAL.sha256'},'Source inventory differs')
  for e in src['files']:require(originals[packet+'/'+e['path']]=={k:e[k] for k in ['bytes','sha256']},'Source manifest entry differs')
 a=read('ACCEPTANCE.json');v=read('independent-review/VERDICT.json')
 require(a['status']=='ACCEPTED_WITHIN_STATED_SCOPE' and v['status']=='accepted','Fresh acceptance missing')
 require(a['source_manifests']==ORIGINAL_MANIFESTS,'Acceptance source identities differ')
 require(a['author_report_original']==originals['author/REPORT.md'] and a['author_report_original']['sha256']==AUTHOR_REPORT,'Author proof binding differs')
 require(a['independent_review_original']==originals['independent-review/INDEPENDENT_REVIEW.md'] and a['independent_review_original']['sha256']==AUDIT_REPORT,'Fresh review binding differs')
 require(a['author_report_public']==desc(ROOT/'author/REPORT.md') and a['independent_review_public']==desc(ROOT/'independent-review/INDEPENDENT_REVIEW.md'),'Public proof/review identity differs')
 require(a['independent_verdict_original']==originals['independent-review/VERDICT.json'],'Verdict identity differs')
 require(v['source_manifest_sha256']==ORIGINAL_MANIFESTS['author'] and v['source_report_sha256']==AUTHOR_REPORT and v['source_manifest_files_verified']==10,'Frozen acceptance incomplete')
 binding=read('independent-review/SOURCE_BINDING.json')
 require(binding['package']==binding['source_path']=='author' and binding['manifest_sha256']==ORIGINAL_MANIFESTS['author'] and binding['report_sha256']==AUTHOR_REPORT and binding['all_manifest_files_verified'] is True and binding['source_seal_matches'] is True,'Fresh source verification incomplete')
 require({r['path'] for r in binding['manifest_files']}=={r['path'] for r in read('author/MANIFEST.json')['files']},'Fresh bound inventory incomplete')
 for r in binding['manifest_files']:require(originals['author/'+r['path']]=={k:r[k] for k in ['bytes','sha256']},'Fresh source entry mismatch')
 deep_orig=dict(originals)
 for p in sorted((ROOT/'dependencies').rglob('SOURCE_LEDGER.json'),key=lambda p:len(p.parts)):
  data=json.loads(p.read_text());rows=data['files'] if isinstance(data,dict) else data
  for r in rows:
   if 'source_packet' in r and 'source_path' in r:deep_orig[(p.parent.relative_to(ROOT)/r['source_packet']/r['source_path']).as_posix()]=r['original']
   if r.get('export_path') is not None:deep_orig[(p.parent.relative_to(ROOT)/r['export_path']).as_posix()]=r['original']
 nbind=0
 for r in read('author/SOURCE_BINDINGS.json')['sources']:
  expected={k:r[k] for k in ['bytes','sha256']};name=r.get('original_path',r.get('original_manifest_path'));require(deep_orig[name]==expected,'Retained source identity differs')
  if 'retained_path' in r:require(originals['author/'+r['retained_path']]==expected,'Retained scientific copy differs')
  nbind+=1
 for packet in read('independent-review/BASELINE_BINDINGS.json'):
  prefix=packet['path']+'/';require(deep_orig[prefix+'MANIFEST.json']['sha256']==packet['manifest_sha256'],'Baseline manifest binding differs')
  require(packet['manifest_files_verified']==len(packet['files']),'Baseline source verification incomplete')
  for r in packet['files']:require(deep_orig[prefix+r['path']]=={k:r[k] for k in ['bytes','sha256']},'Baseline source entry differs');nbind+=1
 d=read('DEPENDENCIES.json');prior=[r for r in ledger if r['source_packet']=='leading-two-portable']
 require(d['root']=='dependencies/leading-two' and len(prior)==d['source_file_count']==365 and all(r['mode']=='exact' for r in prior),'Prior packet incomplete or changed')
 require(d['source_zip_sha256']==PRIOR_ZIP and d['source_zip_bytes']==1083885 and d['portable_manifest_sha256']==PRIOR_MANIFEST and desc(ROOT/d['root']/'MANIFEST.json')['sha256']==PRIOR_MANIFEST,'Prior packet identity differs')
 for name,identity in d['receipts'].items():require(desc(safe(d['receipt_root']+'/'+name))==identity,'Dependency receipt identity differs')
 release=read(d['receipt_root']+'/RELEASE_VALIDATION.json');replay=read(d['receipt_root']+'/RELEASE_COLD_REPLAY.json');neg=read(d['receipt_root']+'/RELEASE_COLD_NEGATIVE_CONTROLS.json');integrity=read(d['receipt_root']+'/RELEASE_COLD_VERIFICATION.json')
 require(desc(ROOT/d['receipt_root']/'RELEASE_VALIDATION.json')['sha256']==PRIOR_RELEASE,'Dependency final release changed')
 require(release['status']==replay['status']==neg['status']==integrity['status']=='PASS','Dependency evidence not passing')
 require(release['sha256']==PRIOR_ZIP and release['manifest']['sha256']==PRIOR_MANIFEST and release['public_files']==365 and release['archive_members_equal_public_tree'] is True and release['cold_tree_equal_frozen_public_tree_after_replay'] is True,'Dependency replay not bound to retained bytes')
 require(release['mathematical_programs_replayed']==replay['exact_program_count']==len(replay['results'])==29 and release['type_sensitive_comparison'] is True and release['negative_controls']==neg['negative_control_count']==22,'Dependency replay/control inventory differs')
 require(release['receipt_identities']=={k:v for k,v in d['receipts'].items() if k!='RELEASE_VALIDATION.json'},'Dependency receipt chain differs')
 cfg=read('REPLAY_CASES.json');require(cfg['ignored_nondeterministic_keys']==['seconds','elapsed_seconds','total_seconds'] and cfg['default_scope']=='current','Unapproved replay exclusions or default')
 require(len(cfg['cases'])==33 and sum(c['group']=='current' for c in cfg['cases'])==4 and sum(c['group']=='prior' for c in cfg['cases'])==29,'Replay set incomplete')
 inherited=json.loads(json.dumps(read(d['root']+'/REPLAY_CASES.json')['cases']))
 for c in inherited:
  c['group']='prior'
  for k in ['script','expected_output']:c[k]=d['root']+'/'+c[k]
  if 'additional_expected_outputs' in c:c['additional_expected_outputs']=[d['root']+'/'+x for x in c['additional_expected_outputs']]
  for x in c.get('support_files',[]):x['source']=d['root']+'/'+x['source']
  for x in c.get('inputs',[]):x['from_script']=d['root']+'/'+x['from_script']
 require(cfg['cases'][4:]==inherited,'Inherited execution inventory changed')
 require([r['checker'] for r in replay['results']]==[c['script'] for c in read(d['root']+'/REPLAY_CASES.json')['cases']] and all(r['all_mathematical_fields_match'] is True for r in replay['results']),'Retained receipt execution inventory mismatch')
 for c in cfg['cases']:
  for k in ['script','expected_output']:require(safe(c[k]).is_file(),'Missing replay input')
  for x in c.get('additional_expected_outputs',[]):require(safe(x).is_file(),'Missing extra replay output')
  if 'generated_output' in c:require(PurePosixPath(c['generated_output']).name==c['generated_output'],'Unsafe generated output')
  for x in c.get('support_files',[]):require(safe(x['source']).is_file(),'Missing checker support')
 tokens=['/'+'workspace'+'/','/'+'home'+'/','/'+'tmp'+'/','/'+'root'+'/','cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','codex'+':','chatgpt'+'.com','native'+'_plan','delivery'+'_context','coordinating '+'parent','parent '+'coordinator','The '+'parent','Global '+'owner scope']
 for name in actual:
  text=(ROOT/name).read_text();require(not any(t in name or t in text for t in tokens),'Private locator or coordination identifier: '+name)
