   require(p['scientific_content_changed'] is False and p['control_logic_changed'] is False and p['contributor_credit_preserved'] is True,'Scientific or credit change')
   require(row['original']!=row['exported'] and len(p['replacements'])>0,'Undisclosed projection')
   delta=0
   for e in p['replacements']:
    require(e['kind']=='locator','Unapproved projection kind');safe(root,e['replacement'])
    require(type(e['count']) is int and e['count']>0 and type(e['source_text_bytes']) is int and e['source_text_bytes']>0 and re.fullmatch('[a-f0-9]{64}',e['source_text_sha256']),'Invalid projection evidence')
    require((root/name).read_text().count(e['replacement'])>=e['count'],'Replacement missing')
    delta+=e['count']*(len(e['replacement'].encode())-e['source_text_bytes'])
   require(row['original']['bytes']+delta==row['exported']['bytes'],'Projection size arithmetic fails')
 for group,digest in ORIGINAL_MANIFESTS.items():
  src=read(root,group+'/MANIFEST.json');rows=[r for r in ledger if r['source_packet']==group]
  require(src['package']==group and originals[group+'/MANIFEST.json']['sha256']==digest,'Source manifest identity mismatch')
  require((root/group/'SEAL.sha256').read_text().split()==[digest,'MANIFEST.json'],'Original seal mismatch')
