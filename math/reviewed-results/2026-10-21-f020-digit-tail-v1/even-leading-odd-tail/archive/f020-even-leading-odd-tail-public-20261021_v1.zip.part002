PK␀␀␀␀␀␀␀!␀4Vh×À,␀␀À,␀␀÷␀␀␀f020-even-leading-odd-tail-public-20261021_v1/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/dependencies/even-low-digit/independent-review/check_independent.py#!/usr/bin/env python3
"""Fresh exact controls; no imports of candidate/reviewer code. Python stdlib only."""
import argparse, hashlib, json, math, random, time
from fractions import Fraction as F
from pathlib import Path

def vp(n,p):
    assert n
    k=0
    while n%p==0:n//=p;k+=1
    return k

def W(p,n):
    out=n;b=p
    while b<=n:out+=(b-b//p)*(n//b);b*=p
    return out

def parameters(p,r):
    N=p**r;h=r//2;beta=p**h;alpha=beta-(r%2==0);B=W(p,(N-1)//2)
    def T(n):
        return n+sum((p**j-p**(j-1))*(n//p**j) for j in range(1,h+1))-(n//beta if r%2==0 else 0)
    return N,beta,alpha,B,N+B-p,T,lambda n:W(p,n)-T(n)

def integer_controls():
    rng=random.Random(0xF020E020);out=[]
    for p in (3,5,7,11,13,19,37):
      for r in range(2,19):
        N,beta,alpha,B,D,T,R=parameters(p,r);A=(N-1)//2
        ms=list(range(N)) if N<=2500 else [0,1,2,3,beta-1,beta,beta+1,N-2,N-1]+[rng.randrange(N) for _ in range(1500)]
        for m in ms:
            assert R(m)<=W(p,m//2)
            if m>0 and m%2==0:assert R(m)<W(p,m//2)
            assert R(m)+R(N-1-m)==R(N-1)
        us=list(range(A+1)) if N<=2500 else [0,1,A-1,A]+[rng.randrange(A+1) for _ in range(1500)]
        for u in us:
            assert W(p,u)-R(2*u)<=B-R(N-1)
            if u:assert W(p,u)-R(2*u-1)<=B-R(N-1)
        C=N-alpha-B+R(N-1)
        assert C==(beta if r%2==0 else (p-1)*p**(r-1)//2)
        assert C>=alpha>F(p,2)
        assert r*N*(p-1)>D
        pairs=[(k,m) for k in range(1,N+1,2) for m in range(k)] if N<=729 else [(p*p,0)]+[(k:=2*rng.randrange((N+1)//2)+1,rng.randrange(k)) for _ in range(3000)]
        for k,m in pairs:
            b=W(p,(N-k)//2)+R(m)+p**vp(k-m,p)
            assert b<=B+p and (b<B+p or (k,m)==(p*p,0))
        evenpairs=[(k,m) for k in range(2,N,2) for m in range(k)] if N<=729 else [(k:=2*rng.randrange(1,(N+1)//2),rng.randrange(k)) for _ in range(3000)]
        for k,m in evenpairs:
            assert W(p,(N-1-k)//2)+R(m)+p**vp(k-m,p)<=B
        out.append(dict(p=p,r=r,N=N,alpha=alpha,B=B,D=D,cover_margin=C,digit_cases=len(ms),cover_cases=len(us),pure_derivative_cases=len(pairs),neighbor_derivative_cases=len(evenpairs)))
    # Exact equality endpoint in the strengthened digit payment.
    N,beta,alpha,B,D,T,R=parameters(3,2)
    assert (alpha,B,D,R(3),W(3,1))==(2,6,12,1,1)
    return out

# Elementary rational-polynomial operations, low-degree first.
def trim(a):
    while len(a)>1 and not a[-1]:a.pop()
    return a

def add(a,b):
    c=[F(0)]*max(len(a),len(b))
    for j,v in enumerate(a):c[j]+=v
    for j,v in enumerate(b):c[j]+=v
    return trim(c)

def scale(a,c):return trim([x*c for x in a])
def mul(a,b):
    c=[F(0)]*(len(a)+len(b)-1)
    for i,x in enumerate(a):
      for j,y in enumerate(b):c[i+j]+=x*y
    return trim(c)
def der(a):return [j*a[j] for j in range(1,len(a))] or [F(0)]
def shift(a,k=1):return [F(0)]*k+a

def identity_controls():
    rows=[]
    for q in (F(3,2),F(-3),F(5)):
        M=13;w=[F(1)];w2=[F(1)];newtons=[[F(1)]];P=[[F(1)],[F(0),F(1)]];H=[[F(1)],[F(1),F(1)]]
        for n in range(1,M+1):
            w.append(w[-1]*(1-q**n));w2.append(w2[-1]*(1-q**(2*n)))
            newtons.append(mul(newtons[-1],[q**(n-1),F(1)]))
        for n in range(1,M):
            P.append(add(shift(P[-1]),scale(P[-2],q**n-1)))
            H.append(add(mul(H[-1],[F(1),F(1)]),scale(shift(H[-2]),q**n-1)))
        for n in range(M+1):
            S=[F(0)];DS=[F(0)]
            for k in range(n%2,n+1,2):
                S=add(S,scale(newtons[k],w[n]/w[k]/w2[(n-k)//2]))
                for m in range(k):DS=add(DS,scale(shift(newtons[m],k-m-1),w[n]/w2[(n-k)//2]/w[m]/(1-q**(k-m))))
            assert S==H[n] and DS==der(H[n])
            if n:
                L=[F(0)]
                for j in range(n):L=add(L,scale(mul(P[j],P[j]),1/w[j]))
                R=scale(add(mul(der(P[n]),P[n-1]),scale(mul(P[n],der(P[n-1])),-1)),1/w[n-1])
                assert L==R
        for N in (3,5,7):
            aa=[[F(1)],[F(0),F(1)]];bb=[[F(0)],[F(1)]]
            for d in range(2,M-N+1):
                aa.append(add(shift(aa[-1]),scale(aa[-2],q**(N+d-1)-1)))
                bb.append(add(shift(bb[-1]),scale(bb[-2],q**(N+d-1)-1)))
            for d in range(1,M-N+1):assert P[N+d]==add(mul(aa[d],P[N]),scale(mul(bb[d],P[N-1]),q**N-1))
        rows.append(dict(q=str(q),degrees=list(range(M+1)),identities=['both-parity Newton','ordinary derivative double sum','original algebraic-square CD','shifted continuant']))
    return rows

class Cyclotomic:
    """Integer q-power basis with canonical monic cyclotomic reduction."""
    def __init__(self,p,s):
        self.p=p;self.order=p**s;self.gap=p**(s-1);self.e=(p-1)*self.gap
        self.zero=(0,)*self.e;self.one=(1,)+(0,)*(self.e-1)
        self.binomial=[[math.comb(j,k) for k in range(j+1)] for j in range(self.e)]
        self.vcache={}
    def plus(self,a,b):return tuple(x+y for x,y in zip(a,b))
    def times_int(self,a,n):return tuple(n*x for x in a)
    def qshift(self,a,n):
        # Reduce powers using q^order=1, then the monic Phi relation.
        c=[0]*self.order
        for j,x in enumerate(a):c[(j+n)%self.order]+=x
        for j in range(self.order-1,self.e-1,-1):
            if c[j]:
                x=c[j]
                for h in range(self.p):c[j-self.e+h*self.gap]-=x
        return tuple(c[:self.e])
    def val_unit(self,a):
        if a in self.vcache:return self.vcache[a]
        # Direct binomial q=1+t conversion, independently of the candidate.
        t=[0]*self.e
        for j,c in enumerate(a):
            if c:
                for k,b in enumerate(self.binomial[j]):t[k]+=c*b
        choices=[]
        for j,c in enumerate(t):
            if c:
                v=vp(c,self.p);u=(c//self.p**v)*((-1)**v)%self.p
                choices.append((j+self.e*v,u))
        z=min(choices) if choices else (None,None)
        self.vcache[a]=z;return z
    def polynomials(self,M):
        P=[[self.one],[self.zero,self.one]];H=[[self.one],[self.one,self.one]]
        for j in range(1,M):
            pp=[self.zero]*(j+2);hh=[self.zero]*(j+2)
            for k,v in enumerate(P[-1]):pp[k+1]=self.plus(pp[k+1],v)
            for k,v in enumerate(P[-2]):pp[k]=self.plus(pp[k],self.plus(self.qshift(v,j),self.times_int(v,-1)))
            for k,v in enumerate(H[-1]):
                hh[k]=self.plus(hh[k],v);hh[k+1]=self.plus(hh[k+1],v)
            for k,v in enumerate(H[-2]):hh[k+1]=self.plus(hh[k+1],self.plus(self.qshift(v,j),self.times_int(v,-1)))
            P.append(pp);H.append(hh)
        return P,H
    def translate(self,f,a):
        result=[self.zero]*len(f)
        for k,v in enumerate(f):
            if not any(v):continue
            for j in range(k+1):result[j]=self.plus(result[j],self.times_int(self.qshift(v,a*(k-j)),math.comb(k,j)*(-1)**(k-j)))
        return result

def hull(points):
    ans=[]
    for x,y in points:
        while len(ans)>1 and (y-ans[-1][1])*(ans[-1][0]-ans[-2][0])<=(ans[-1][1]-ans[-2][1])*(x-ans[-1][0]):ans.pop()
        ans.append((x,y))
    return ans

def factor_unit(p,j):return -(j//p**vp(j,p))%p

def actual_controls(p,r,s,centers):
    start=time.monotonic();N,beta,alpha,B,D,T,R=parameters(p,r);K=Cyclotomic(p,s);P,H=K.polynomials(N+p-2)
    Lunit=1
    for j in range(1,N+1):Lunit=Lunit*factor_unit(p,j)%p
    denominator=factor_unit(p,p*p)
    for j in range(1,(N-p*p)//2+1):denominator=denominator*factor_unit(p,2*j)%p
    Lunit=Lunit*pow(denominator,-1,p)%p
    disks=[]
    for a in centers:
        # Differentiate the exact original H polynomial BEFORE Taylor translation.
        dn=[K.times_int(H[N][j],j) for j in range(1,N+1)]
        dh=K.translate(dn,a);records=[]
        for j,c in enumerate(dh):
            v,u=K.val_unit(c)
            if v is not None:records.append(dict(j=j,value=v+j*alpha,coefficient_value=v,unit=u))
        assert records[0]['j']==0 and records[0]['value']==D and records[0]['unit']==Lunit
        assert all(z['value']>D for z in records[1:])
        hn=K.translate(H[N-1],a)
        nd=[K.times_int(H[N-1][j],j) for j in range(1,N)]
        hd=K.translate(nd,a)
        neighbor=[];neighbor_der=[]
        for j,c in enumerate(hn):
            v,u=K.val_unit(c)
            if v is not None:neighbor.append(dict(j=j,value=v+j*alpha,unit=u))
        for j,c in enumerate(hd):
            v,u=K.val_unit(c)
            if v is not None:neighbor_der.append(dict(j=j,value=v+j*alpha,unit=u))
        assert neighbor[0]['j']==0 and neighbor[0]['value']==B
        assert all(z['value']>B for z in neighbor[1:])
        assert all(z['value']>=B for z in neighbor_der)
        disks.append(dict(a=a,H_N_derivative=records,H_N_minus_one=neighbor,H_N_minus_one_derivative=neighbor_der))
    tails=[];hulls=[]
    for d in range(1,p,2):
        c=(d-1)//2;aa=[[K.one],[K.zero,K.one]];bb=[[K.zero],[K.one]]
        for j in range(2,d+1):
            av=[K.zero]*(j+1);bv=[K.zero]*j
            for k,v in enumerate(aa[-1]):av[k+1]=K.plus(av[k+1],v)
            for k,v in enumerate(aa[-2]):av[k]=K.plus(av[k],K.plus(K.qshift(v,N+j-1),K.times_int(v,-1)))
            for k,v in enumerate(bb[-1]):bv[k+1]=K.plus(bv[k+1],v)
            for k,v in enumerate(bb[-2]):bv[k]=K.plus(bv[k],K.plus(K.qshift(v,N+j-1),K.times_int(v,-1)))
            aa.append(av);bb.append(bv)
        av=[(j,*K.val_unit(v)) for j,v in enumerate(aa[d]) if any(v)];bv=[(j,*K.val_unit(v)) for j,v in enumerate(bb[d]) if any(v)]
        assert av[0][0:2]==(1,c) and bv[0][0:2]==(0,c)
        assert all(w>=c-(j-1)//2 for j,w,u in av)
        assert all(w>=c-j//2 for j,w,u in bv)
        # Exact origin hull of every admissible low digit.
        points=[(j,K.val_unit(v)[0]) for j,v in enumerate(P[N+d]) if any(v)];hh=hull(points)
        profiles=[dict(count=hh[k+1][0]-hh[k][0],value=str(F(hh[k][1]-hh[k+1][1],hh[k+1][0]-hh[k][0]))) for k in range(len(hh)-1)]
        assert sum(z['count'] for z in profiles if F(z['value'])==F(1,2))==2*c
        assert sum(z['count'] for z in profiles if F(z['value'])>F(1,2))==N+1
        assert all(F(z['value'])!=F(p,2) for z in profiles)
        allowed=lambda x:x==1 or (x>=p and x.denominator==1 and x.numerator in [p**j for j in range(1,r+1)]) or x>=alpha
        assert all(allowed(F(z['value'])) for z in profiles if F(z['value'])>F(1,2))
        if (p,r,s,d)==(3,2,3,1):assert hh==[(0,15),(4,6),(10,0)]
        tails.append(dict(d=d,A=av,B=bv));hulls.append(dict(d=d,degree=N+d,hull=hh,root_valuation_profile=profiles))
