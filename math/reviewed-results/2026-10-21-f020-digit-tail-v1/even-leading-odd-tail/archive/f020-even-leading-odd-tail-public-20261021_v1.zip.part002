"""Verify this frozen candidate and optionally replay only its fresh controls."""
from pathlib import Path
import argparse,hashlib,json,os,subprocess,sys,tempfile,resource

def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def require(ok,msg):
    if not ok:raise RuntimeError(msg)
def verify(root):
    require(root.is_dir() and not root.is_symlink(),'invalid root')
    man=json.loads((root/'MANIFEST.json').read_text());seal=json.loads((root/'SEAL.json').read_text())
    require(digest(root/'MANIFEST.json')==seal['manifest_sha256'],'manifest seal mismatch')
    expected={'MANIFEST.json','SEAL.json'}|{f['path'] for f in man['files']}
    actual=set()
    for p in root.rglob('*'):
        require(not p.is_symlink(),'symlink forbidden: '+str(p))
        if p.is_file():actual.add(p.relative_to(root).as_posix())
    require(actual==expected,'inventory extra/missing: '+str(sorted(actual^expected)))
    for f in man['files']:
        rel=Path(f['path']);require(not rel.is_absolute() and '..' not in rel.parts,'unsafe manifest path')
        p=root/rel
        require(p.stat().st_size==f['bytes'] and digest(p)==f['sha256'],'inventory mismatch: '+str(rel))
    sb=json.loads((root/'SOURCE_BINDINGS.json').read_text());named={s['name']:s for s in sb['sources']}
    for s in sb['sources']:
        p=root/s['snapshot']
        if 'snapshot_files' in s:
            require(digest(p/'MANIFEST.json')==s['manifest_sha256'],'source manifest pin')
            for f in s['snapshot_files']:require(digest(p/f['name'])==f['sha256'],'source evidence pin')
        else:require(digest(p)==s['sha256'],'source archive pin')
    for author,review in [('general-author','general-review'),('adjacent-lift-author','adjacent-lift-review'),('c2-odd-author','c2-odd-review'),('even-tail-author','even-tail-review')]:
        v=json.loads((root/named[review]['snapshot']/'VERDICT.json').read_text())
        require(v.get('author_manifest_sha256',v.get('candidate_manifest_sha256'))==named[author]['manifest_sha256'],'acceptance binding '+review)
        require(v.get('verdict','').startswith('ACCEPTED'),'source not accepted '+review)
    return {'inventory_files':len(man['files']),'source_acceptance_pairs':4,'source_programs_executed':False}
def limits():
    resource.setrlimit(resource.RLIMIT_CPU,(10,10));resource.setrlimit(resource.RLIMIT_AS,(256*1024**2,256*1024**2));resource.setrlimit(resource.RLIMIT_FSIZE,(4*1024**2,4*1024**2))
def cold(root):
    expected=(root/'CONTROL_RESULTS.json').read_bytes()
    with tempfile.TemporaryDirectory(prefix='f020-mixed-cold-') as d:
        for opt in (False,True):
            command=[sys.executable,'-I','-B']+(['-O'] if opt else [])+[str(root/'check_controls.py')]
            r=subprocess.run(command,cwd=d,env={'PATH':os.environ.get('PATH',''),'PYTHONDONTWRITEBYTECODE':'1'},capture_output=True,timeout=20,preexec_fn=limits)
            require(r.returncode==0,'control failed '+r.stderr.decode())
            require(r.stdout==expected,'control replay differs')
    return {'normal':'PASS_BYTE_IDENTICAL','optimized':'PASS_BYTE_IDENTICAL','accepted_programs_executed':False}
if __name__=='__main__':
    ap=argparse.ArgumentParser();ap.add_argument('--root',type=Path,default=Path(__file__).resolve().parent);ap.add_argument('--cold',action='store_true');a=ap.parse_args();root=a.root.resolve()
    result=verify(root)
    if a.cold:result['cold']=cold(root)
    print(json.dumps(result,indent=2,sort_keys=True))
