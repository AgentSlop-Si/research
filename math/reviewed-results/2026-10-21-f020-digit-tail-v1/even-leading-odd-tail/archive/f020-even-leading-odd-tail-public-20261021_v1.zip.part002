from pathlib import Path
import json,sympy as s
P=Path(__file__).parent;x=s.Symbol('Y')
a=json.loads((P/'EXACT_CHECKS.json').read_text());out=[]
for case in a['actual_cyclotomic_controls']:
    for v in case['records']:
        p=v['p'];c=v['c'];M=p**(v['r']-v['r']//2)
        H=s.Poly(sum(u*x**j for j,u in v['H_residual_terms']),x,modulus=p)
        D=s.Poly(sum(u*x**j for j,u in v['ordinary_derivative_residual_terms']),x,modulus=p)
        assert H.degree()==c*M and D.degree()==(c-1)*M
        assert s.gcd(H,D).degree()==0
        lo=min(j for j,u in v['H_residual_terms'])
        assert lo==(c%2)*M
        out.append({'p':p,'r':v['r'],'s':v['s'],'c':c,'center':v['center'],'actual_H_residual_degree':H.degree(),'actual_ordinary_derivative_residual_degree':D.degree(),'actual_residual_gcd_degree':0,'strict_interior_multiplicity':lo})
(P/'ACTUAL_RESIDUAL_COPRIMALITY.json').write_text(json.dumps(out,indent=2)+'\n')
print(len(out),'actual-field residual coprimality and multiplicity controls passed')
