 tokens=['/'+'workspace'+'/','/'+'home'+'/','/'+'tmp'+'/','/'+'root'+'/','cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','codex'+':','chatgpt'+'.com','delivery'+'_context','parent '+'coordinator']
