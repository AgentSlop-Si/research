PK␀␀␀␀␀␀␀!␀ë“©î'␀␀î'␀␀F␀␀␀f020-even-leading-odd-tail-public-20261021_v1/author/check_controls.py#!/usr/bin/env python3
"""Fresh bounded controls only. Standard library; never import source programs."""
from fractions import Fraction as F
from math import comb, factorial
import json


def need(x,msg):
    if not x: raise RuntimeError(msg)
def df(n):
    z=1
    for j in range(n,0,-2): z*=j
    return z
def rpoly(c):
    out=[0]*(c//2+1)
    for k in range(c//2+1): out[c//2-k]=factorial(c)//(2**k*factorial(k)*factorial(c-2*k))
    return out
def ev(a,x):
    z=0
    for k in reversed(a): z=z*x+k
    return z
def de(a): return [i*a[i] for i in range(1,len(a))]
def residue(x,p):
    x=F(x); return x.numerator*pow(x.denominator,-1,p)%p

def matching_sets(lo,hi):
    if lo>hi: return [()]
    return matching_sets(lo+1,hi)+[(lo,)+s for s in matching_sets(lo+2,hi)]
def mul(a,b):
    z=[F(0)]*(len(a)+len(b)-1)
    for i,x in enumerate(a):
        for j,y in enumerate(b): z[i+j]+=x*y
    return z
def add(a,b):
    z=[F(0)]*max(len(a),len(b))
    for i,x in enumerate(a):z[i]+=x
    for i,x in enumerate(b):z[i]+=x
    return z

def tail_jets(m):
    def get(lo):
        sums=[F(0)]*3
        for s in matching_sets(lo,2*m):
            if len(s)!=m:continue
            v=[F(1)]
            for j in s: v=mul(v,[F(j),F(j*(j-1),2),F(j*(j-1)*(j-2),6)])[:3]
            sums=add(sums,v)
        return sums
    T,V=get(1),get(2)
    C,B=df(2*m+1),df(2*m)
    need(T[0]==C and V[0]==B,'matching constants')
    T=[x/C for x in T];V=[x/B for x in V]
    kap=[F(1),V[1]-T[1],V[2]-T[2]-T[1]*(V[1]-T[1])]
    need(kap[1]==F(m,6),'tail first')
    need(kap[2]==F(m*(7*m-27),360),'tail second')
    return {'m':m,'T':[str(x) for x in T],'V':[str(x) for x in V],'kappa':[str(x) for x in kap]}

class Series:
    def __init__(self,p,H):self.p,self.H=p,H
    def const(self,a):return [a%self.p]+[0]*self.H
    def add(self,a,b):return [(x+y)%self.p for x,y in zip(a,b)]
    def neg(self,a):return [(-x)%self.p for x in a]
    def scale(self,a,k):return [(x*k)%self.p for x in a]
    def shift(self,a,n,k=1):return [0]*n+[(x*k)%self.p for x in a[:self.H+1-n]] if n<=self.H else self.const(0)
    def mul(self,a,b):
        z=self.const(0); ai=[(i,x) for i,x in enumerate(a) if x];bj=[(j,y) for j,y in enumerate(b) if y]
        for i,x in ai:
            for j,y in bj:
                if i+j>self.H:break
                z[i+j]=(z[i+j]+x*y)%self.p
        return z
    def edge(self,j):return [0]+[comb(j,k)%self.p if k<=j else 0 for k in range(1,self.H+1)]
    def val(self,a):return next((i for i,x in enumerate(a) if x),None)
    def ratio(self,a,b,depth=2):
        va,vb=self.val(a),self.val(b)
        need(vb is not None,'zero denominator')
        if va is None:return [0]*(depth+1)
        need(va>=vb,'negative ratio unsupported')
        z=[0]*(depth+1);inv=pow(b[vb],-1,self.p)
        for k in range(depth+1):
            aa=a[vb+k] if vb+k<len(a) else 0
            z[k]=(aa-sum(z[l]*(b[vb+k-l] if vb+k-l<len(b) else 0) for l in range(k)))*inv%self.p
        return z

# Exact original P and ordinary P' recurrences BEFORE specializing X^2.
def original_scalar(p,c,d,H):
    s=Series(p,H);U=-residue(F(df(d-1),df(d)),p)%p
    fp,f=s.const(1),s.const(1);gp,g=s.const(0),s.const(1)
    wanted={c*p*p-1,c*p*p,c*p*p+d};saved={}
    for j in range(1,c*p*p+d):
        b=s.edge(j)
        if j%2:
            nf=s.add(s.shift(f,p,U),s.mul(b,fp))
            ng=s.add(s.add(f,g),s.mul(b,gp))
        else:
            nf=s.add(f,s.mul(b,fp))
            ng=s.add(s.add(f,s.shift(g,p,U)),s.mul(b,gp))
        fp,f,gp,g=f,nf,g,ng
        if j+1 in wanted:saved[j+1]=(f,g)
    A,AD=saved[c*p*p];M,MD=saved[c*p*p-1]
    a=s.neg(s.edge(c*p*p))
    ar=s.ratio(s.shift(AD,p,U),s.mul(a,M))
    mr=s.ratio(MD,M)
    # Independent scalar continuants and partial derivatives in w=X^2.
    def tail(length,offset):
        pp,ff=s.const(1),s.const(1);hhp,hh=s.const(0),s.const(0)
        if length==0:return pp,hhp
        for j in range(1,length):
            b=s.edge(offset+j)
            if j%2:
                nn=s.add(s.shift(ff,p,U),s.mul(b,pp))
                hn=s.add(s.add(ff,s.shift(hh,p,U)),s.mul(b,hhp))
            else:
                nn=s.add(ff,s.mul(b,pp));hn=s.add(hh,s.mul(b,hhp))
            pp,ff,hhp,hh=ff,nn,hh,hn
        return ff,hh
    T,Tu=tail(d,c*p*p);V,Vu=tail(d-1,c*p*p+1)
    kap=s.ratio(V,T)
    kdnum=s.scale(s.shift(s.add(s.mul(Vu,T),s.neg(s.mul(V,Tu))),p,U),2)
    kd=s.ratio(kdnum,s.mul(T,T))
    km=[sum(kap[j]*mr[k-j] for j in range(k+1))%p for k in range(3)]
    qs=[(ar[k]+kap[k]-km[k]-kd[k])%p for k in range(3)]
    alpha=residue(F(df(d-1),df(d)),p);cfirst=residue(F(alpha*(2*d+1),24),p)
    need(qs[0]==0 and qs[1]==cfirst,'full scalar Qstar first correction')
    K=c*p*p//2+c*p*(p-1)
    need(s.val(A) is None or s.val(A)>K+p,'arbitrary-alpha scalar depth')
    return {'p':p,'c':c,'d':d,'cutoff':H,'U':U,'A_valuation_seen':s.val(A),'required_A_value_gt':K+p,'A_ratio':ar,'kappa':kap,'M_term':km,'kappa_derivative_term':kd,'Qstar':qs,'expected_first':cfirst,'scalar_P_prime_not_used_as_root_derivative':True}

def low_recurrence(p,c,d,r):
    n=c*p**r+d
    Q0,Q=[1],[0,1];D0,D=[0],[1]
    def ad(a,b):
        o=[0]*max(len(a),len(b))
        for i,x in enumerate(a):o[i]=(o[i]+x)%p
        for i,x in enumerate(b):o[i]=(o[i]+x)%p
        return o
    for j in range(1,n):
        q=ad([0]+Q,[(j*x)%p for x in Q0]);v=ad(ad(Q,[0]+D),[(j*x)%p for x in D0]);Q0,Q,D0,D=Q,q,D,v
    H=[0]*(d+1)
    for k in range(d//2+1):H[d-2*k]=factorial(d)//(2**k*factorial(k)*factorial(d-2*k))%p
    expected=[0]*(c*p**r)+H
    expectedD=[0]*(c*p**r)+[i*H[i]%p for i in range(1,len(H))]
    Q+=[0]*(len(expected)-len(Q));D+=[0]*(len(expectedD)-len(D))
    while Q and Q[-1]==0:Q.pop()
    while D and D[-1]==0:D.pop()
    while expected and expected[-1]==0:expected.pop()
    while expectedD and expectedD[-1]==0:expectedD.pop()
    need(Q==expected and D==expectedD,'low original derivative recurrence')
    return {'p':p,'c':c,'d':d,'r':r,'degree':n,'pass':True}

def main():
    out={}
    out['tail_matching_jets']=[tail_jets(m) for m in (0,1,2,4,5)]
    full_tail=[]
    for m in (0,1,2,4):
        d=2*m+1;b={j:(j+1)**2+1 for j in range(1,d)}
        fp,f=[F(1)],[F(0),F(1)];vp,v=[F(0)],[F(1)]
        for j in range(1,d):
            fp,f=f,add([F(0)]+f,[-b[j]*x for x in fp])
            vp,v=v,add([F(0)]+v,[-b[j]*x for x in vp])
        def matching_poly(lo):
            out=[F(0)]*(2*m+1)
            for S in matching_sets(lo,2*m):
                value=(-1)**len(S)
                for j in S:value*=b[j]
                out[2*m-2*len(S)]+=value
            return out
        ft=f[1:];vv=v
        while ft and ft[-1]==0:ft.pop()
        while vv and vv[-1]==0:vv.pop()
        mt,mv=matching_poly(1),matching_poly(2)
        while mt and mt[-1]==0:mt.pop()
        while mv and mv[-1]==0:mv.pop()
        need(ft==mt and vv==mv,'full short-tail matching recurrence')
        full_tail.append({'m':m,'pass':True})
    out['full_tail_matching_recurrence']=full_tail
    need(F((-F(3,4))*(7*(-F(3,4))-27),360)-F(9,128)==-F(1,320),'universal second coefficient')
    out['universal_second_coefficient']='-1/320'
    # Exact fraction-free cancellation with formal independent symbols.
    def term(*v):return tuple(sorted(v))
    expanded=[(1,term('T','Tp','A')),(1,term('T','T','Ap')),(-1,term('a','T','Vp','G')),(-1,term('a','T','V','Gp')),(-1,term('Tp','T','A')),(1,term('a','Tp','V','G'))]
    actual={}
    for value,key in expanded:actual[key]=actual.get(key,0)+value
    actual={k:v for k,v in actual.items() if v}
    expected={term('T','T','Ap'):1,term('a','T','Vp','G'):-1,term('a','Tp','V','G'):1,term('a','T','V','Gp'):-1}
    need(actual==expected,'fraction-free ordinary derivative witness')
    out['fraction_free_witness']='T F_prime - T_prime F = T^2 A_prime - a(V_prime T - V T_prime)G - aVT G_prime'
    fixtures=[]
    for p,c,d in ((5,4,3),(7,4,3),(11,8,1),(17,16,15),(43,24,21)):
        alpha=F(df(d-1),df(d));R=rpoly(c);val=residue(ev(R,-alpha),p)
        deriv=residue(ev(de(R),-alpha),p)
        fixtures.append({'p':p,'c':c,'d':d,'alpha':residue(alpha,p),'obstruction':val,'derivative_at_candidate':deriv,'affected_roots':2*p if val==0 else 0})
        if val==0:need(deriv!=0,'obstruction must be simple')
    need(fixtures[0]['obstruction']==0 and fixtures[0]['alpha']==4,'new p5 boundary')
    need(fixtures[-1]['obstruction']==0 and fixtures[-1]['alpha']==20 and 2*fixtures[-1]['d']+1==43,'non-c2 simultaneous fixture')
    out['selected_residue_fixtures']=fixtures
    out['original_scalar_control']=original_scalar(5,4,3,148)
    out['low_controls']=[low_recurrence(5,4,3,2),low_recurrence(5,4,3,3),low_recurrence(7,6,5,2)]
    # Symbolic uniform positive-gap forms in z=p-p0, recorded as exact polynomials.
    out['uniform_gap_certificates']={
      'first_p5_g_minus1':[1,F(1,2).__str__()],
      'first_p5_group_minus_p':[F(5,2).__str__(),3,F(1,2).__str__()],
      'second_p7_g_minus2':[1,F(1,2).__str__()],
      'second_p7_group_minus_2p':[F(7,2).__str__(),4,F(1,2).__str__()],
      'second_p7_delta_minus_2p':[7,F(9,2).__str__(),F(1,2).__str__()],
      'second_p7_even_nonpivot_minus_2p':[10,5,F(1,2).__str__()],
      'second_p7_N_minus_rho_minus_2p':[F(63,2).__str__(),F(23,2).__str__(),1],
      'lattice_minimum':'(p-c)B >= B > bp; coefficient lattice raw degree >= cN/2'}
    # Deliberate wrong alternatives must disagree at the new boundary.
    z=out['original_scalar_control'];p=5
    need(z['A_ratio'][2]!=residue(F(z['U']*9,128),p),'p5 unsupported second-order ratio must fail')
    need(z['Qstar'][1]!=residue(F(2*3+1,24),p),'omitted alpha mutant escaped')
    need(fixtures[0]['obstruction']!=residue(ev(rpoly(4),-1),5),'copied -1 obstruction mutant escaped')
    need(((-2*df(3)*residue(ev(de(rpoly(4)),-F(2,3)),5))%5)==2,'central base unit')
    out['negative_controls']=['copied U=-1 obstruction rejected','omitted alpha in first correction rejected','p3 g>1 rejected','p5 g>2 rejected','p5 unsupported second-order ratio rejected','second coefficient not zero as rational']
    need(F(3-1,2)<=1 and F(5-1,2)<=2,'gap negative controls')
    return out

if __name__=='__main__':print(json.dumps(main(),indent=2,sort_keys=True))
PK␀␀␀␀␀␀␀!␀Ð~ìÊ␀␀Ê␀␀M␀␀␀f020-even-leading-odd-tail-public-20261021_v1/author/check_freeze_controls.py#!/usr/bin/env python3
"""Fresh negative inventory controls against independent temporary copies."""
from pathlib import Path
import json,runpy,shutil,tempfile
root=Path(__file__).resolve().parent
verify=runpy.run_path(str(root/'verify.py'))['verify']
verify(root)
results=[]
with tempfile.TemporaryDirectory(prefix='f020-mixed-mutants-') as d:
 for kind in ('alter_report','missing_controls','extra_file','symlink','seal_mismatch'):
  dest=Path(d)/kind;shutil.copytree(root,dest)
  if kind=='alter_report':(dest/'REPORT.md').write_text((dest/'REPORT.md').read_text()+'\nMUTATION\n')
  elif kind=='missing_controls':(dest/'check_controls.py').unlink()
  elif kind=='extra_file':(dest/'unexpected.txt').write_text('unexpected')
  elif kind=='symlink':(dest/'unexpected-link').symlink_to(dest/'REPORT.md')
  else:
   s=json.loads((dest/'SEAL.json').read_text());s['manifest_sha256']='0'*64;(dest/'SEAL.json').write_text(json.dumps(s))
  try:verify(dest)
  except Exception as e:results.append({'mutation':kind,'rejected':True,'reason':str(e).split(':')[0]})
  else:raise RuntimeError('mutation accepted: '+kind)
print(json.dumps({'negative_inventory_controls':results,'source_programs_executed':False},indent=2,sort_keys=True))
