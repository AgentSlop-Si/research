␀␀S␀␀␀f020-even-leading-odd-tail-public-20261021_v1/independent-review/replay_controls.py#!/usr/bin/env python3
"""Resource-bounded fresh replay of the inspected new author/independent controls."""
import argparse,hashlib,json,os,resource,shutil,subprocess,sys,tempfile,time
from pathlib import Path

def need(x,msg):
    if not x:raise RuntimeError(msg)
def cap():
    resource.setrlimit(resource.RLIMIT_CPU,(120,120));resource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3));resource.setrlimit(resource.RLIMIT_FSIZE,(16*1024**2,16*1024**2))
def semantic(j):
    j=dict(j);j.pop('elapsed_seconds',None);return j
def run(candidate,review):
    out={'status':'PASS','cpu_seconds':120,'wall_seconds_per_run':150,'address_space_bytes':1024**3,'output_limit_bytes':16*1024**2,'numerical_threads':1,'runs':[]}
    env={'PATH':os.environ.get('PATH',''),'PYTHONDONTWRITEBYTECODE':'1','OPENBLAS_NUM_THREADS':'1','OMP_NUM_THREADS':'1','MKL_NUM_THREADS':'1'}
    expected_author=(candidate/'CONTROL_RESULTS.json').read_bytes();expected_own=semantic(json.loads((review/'INDEPENDENT_RESULTS.json').read_text()))
    for which,source in [('author',candidate/'check_controls.py'),('independent',review/'independent_controls.py')]:
        for optimized in [False,True]:
            with tempfile.TemporaryDirectory(prefix='f020-mixed-independent-cold-') as tmp:
                dest=Path(tmp)/source.name;shutil.copyfile(source,dest)
                command=[sys.executable,'-I','-B']+(['-O'] if optimized else [])+[str(dest)]
                start=time.monotonic();r=subprocess.run(command,cwd=tmp,env=env,capture_output=True,timeout=150,preexec_fn=cap);elapsed=time.monotonic()-start
                need(r.returncode==0,f'{which} cold failure {r.stderr.decode()}')
                if which=='author':
                    need(r.stdout==expected_author,'author byte comparison failed');digest=hashlib.sha256(r.stdout).hexdigest();comparison='BYTE_IDENTICAL'
                else:
                    got=semantic(json.loads((Path(tmp)/'INDEPENDENT_RESULTS.json').read_text()));need(got==expected_own,'independent semantic comparison failed')
                    digest=hashlib.sha256(json.dumps(got,sort_keys=True,separators=(',',':')).encode()).hexdigest();comparison='SEMANTIC_IDENTICAL_EXCLUDING_TIMING'
                out['runs'].append({'suite':which,'optimized':optimized,'elapsed_seconds':round(elapsed,3),'comparison':comparison,'semantic_or_byte_sha256':digest,'returncode':r.returncode})
    return out
if __name__=='__main__':
    ap=argparse.ArgumentParser();ap.add_argument('candidate',type=Path);ap.add_argument('--review',type=Path,default=Path(__file__).resolve().parent);a=ap.parse_args();print(json.dumps(run(a.candidate,a.review),indent=2,sort_keys=True))
