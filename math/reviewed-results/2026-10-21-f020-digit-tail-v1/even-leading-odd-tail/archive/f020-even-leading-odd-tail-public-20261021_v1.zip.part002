"""Read-only integrity, acceptance, scope, and dependency verification."""
from pathlib import Path,PurePosixPath
import hashlib,json,re,subprocess,sys,os
ROOT=Path(__file__).resolve().parent
AUTHOR_REPORT='47c704223199772787ac255f23bbe7eda83c0c627d57b73579299a547f060354'
AUTHOR_MANIFEST='2214a0ef237d03d3f94c9c3e7edb87e889070554dd57d79d05f70c5835f7fb5d'
REVIEW_MANIFEST='6bd5b2a08b0af6c77361062a7bbf8953863e2f3a4276762115c2ea766fe97b61'
REVIEW_REPORT='5c85f6008a8f329c37b4bdffaba92aec4403cf131502fe564faa62af397d87cc'
PRIOR_MANIFEST='8c483817bf11427a9c4c234392d0cf8c1376a63f6d927e5237ab68eaab5eed61'
PRIOR_ZIP='28757e1489389fd6d1354c7dadb137445cd2e81c4a87a33c157d8535b75d5b4c'
SCOPE_HASH='5e67d70f083be9f0bfc4bbdab0d19c99ec7f5f1e4734930c4cb52f7566636ff7'
REPLAY_HASH='6caf25eac6e6e95a9aba63fbae6f58e98a600657089b65934780532fb4dfd4ef'
def require(ok,reason):
 if not ok:raise ValueError(reason)
def sha(raw):return hashlib.sha256(raw).hexdigest()
def desc(path):
 raw=path.read_bytes();return {'bytes':len(raw),'sha256':sha(raw)}
def read(name):return json.loads((ROOT/name).read_text())
def safe_path(name):
 p=PurePosixPath(name);require(not p.is_absolute() and '..' not in p.parts and str(p)==name and '\\' not in name,'Unsafe package path');return ROOT/name

def main():
 require(__debug__,'Run with assertions enabled, without Python optimization.')
 for p in ROOT.rglob('*'):require(not p.is_symlink(),'Symlinks are not permitted')
 actual={p.relative_to(ROOT).as_posix() for p in ROOT.rglob('*') if p.is_file()};manifest=read('MANIFEST.json');seal=read('SEAL.json')
 require(desc(ROOT/'MANIFEST.json')['sha256']==seal['manifest_sha256'],'Manifest seal mismatch')
 names=[r['path'] for r in manifest['files']];require(len(names)==len(set(names)),'Duplicate manifest path')
 require(actual==set(names)|{'MANIFEST.json','SEAL.json'},'Missing or unexpected package file');require(len(actual)==seal['file_count'],'File count mismatch')
 for row in manifest['files']:require(desc(safe_path(row['path']))=={'bytes':row['bytes'],'sha256':row['sha256']},'Byte identity mismatch: '+row['path'])
 ledger=read('SOURCE_LEDGER.json')['files'];omissions=read('OMISSIONS.json');exports={};originals={}
 require(len({(r['source_packet'],r['source_path']) for r in ledger})==len(ledger),'Duplicate source identity')
 require(omissions['final_proofs_reviews_mathematical_checkers_or_data_omitted'] is False,'Scientific evidence omitted')
 require([r for r in ledger if r['mode']=='omitted']==omissions['frozen_source_omissions'],'Omission records disagree')
 for row in ledger:
  if row['mode']=='omitted':
   require(row['export_path'] is None and bool(row['reason']),'Invalid omission')
   require(row['source_path'].split('/')[-1]=='RUN_LOG.md' or row['source_path']=='verify_frozen.py','Unexpected omitted evidence');continue
  name=row['export_path'];require(name not in exports,'Duplicate exported identity');exports[name]=row;originals[name]=row['original'];path=safe_path(name)
  require(desc(path)==row['exported'],'Export identity mismatch: '+name)
  if row['mode']=='exact':require(row['original']==row['exported'],'Nonexact exact copy')
  else:
   require(row['mode']=='locator_only_projection' and row['projection']['scientific_content_changed'] is False,'Invalid projection')
   require(row['original']!=row['exported'],'Empty projection')
   for change in row['projection']['replacements']:
    require(re.fullmatch('[0-9a-f]{64}',change['source_locator_sha256']) is not None,'Invalid source locator digest');safe_path(change['replacement'])
    require(change['count']>0 and path.read_text().count(change['replacement'])>=change['count'],'Projection replacement missing')
 accept=read('ACCEPTANCE.json');expected={'author':AUTHOR_MANIFEST,'independent-review':REVIEW_MANIFEST}
 require(accept['status']=='PASS' and accept['original_source_manifest_sha256']==expected,'Incorrect acceptance')
 for namespace,expected_hash in expected.items():
  require(desc(ROOT/namespace/'MANIFEST.json')['sha256']==expected_hash,'Original manifest changed: '+namespace)
  require((ROOT/namespace/'SEAL.sha256').read_text().split()==[expected_hash,'MANIFEST.json'],'Original seal mismatch: '+namespace)
  source_rows=[row for row in ledger if row['source_packet']==namespace];manifest_rows=read(namespace+'/MANIFEST.json')['files']
  source_names={row['source_path'] for row in source_rows}
  require(source_names=={row['path'] for row in manifest_rows}|{'MANIFEST.json','SEAL.sha256'},'Original source inventory not exact: '+namespace)
  for row in manifest_rows:
   hits=[r for r in source_rows if r['source_path']==row['path']]
   require(len(hits)==1 and hits[0]['original']=={'bytes':row['bytes'],'sha256':row['sha256']},'Original manifest entry mismatch')
 for path,key in [('author/REPORT.md','author_report'),('author/MANIFEST.json','author_manifest'),('independent-review/INDEPENDENT_REVIEW.md','independent_review'),('independent-review/VERDICT.json','independent_verdict'),('independent-review/MANIFEST.json','independent_manifest')]:
  require(originals[path]==accept[key],'Acceptance source identity mismatch: '+path)
 require(originals['author/REPORT.md']['sha256']==AUTHOR_REPORT and originals['independent-review/INDEPENDENT_REVIEW.md']['sha256']==REVIEW_REPORT,'Frozen report changed')
 verdict=read('independent-review/VERDICT.json')
 require(verdict.get('verdict',verdict.get('status'))=='PASS','Independent acceptance is not PASS')
 require(verdict.get('author_report_sha256',verdict.get('candidate_report_sha256'))==AUTHOR_REPORT,'Independent acceptance report mismatch')
 require(verdict.get('author_manifest_sha256',verdict.get('candidate_manifest_sha256'))==AUTHOR_MANIFEST,'Independent acceptance manifest mismatch')
 for field in ['mathematical_revisions_requested','revisions_required','requested_revisions']:
  if field in verdict:require(verdict[field] in [[],False,None],'Outstanding mathematical revision')
 require('not a proof lemma' in accept['low_digit_review_role'],'Low-digit audit role missing')
 require('collaborator supplied the digit lemma' in accept['inherited_collaboration_role'] and 'separate fresh independent final acceptance' in accept['inherited_collaboration_role'],'Inherited collaboration distinction missing')
 for namespace in ['author','independent-review/sources/author-final']:
  require(originals[namespace+'/MANIFEST.json']['sha256']==AUTHOR_MANIFEST,'Frozen author snapshot mismatch')
  for row in read('author/MANIFEST.json')['files']:
   hits=[r for r in ledger if r['export_path']==namespace+'/'+row['path'] or (r['source_packet']=='independent-review' and r['source_path']=='sources/author-final/'+row['path'] and namespace!='author') or (r['source_packet']=='author' and r['source_path']==row['path'] and namespace=='author')]
   require(len(hits)==1 and hits[0]['original']=={'bytes':row['bytes'],'sha256':row['sha256']},'Author snapshot source mismatch')
  for binding in read(namespace+'/SOURCE_BINDINGS.json'):
   identity={'bytes':binding['bytes'],'sha256':binding['sha256']};mapped=binding['original_path'];safe_path(mapped)
   require(originals.get(namespace+'/'+binding['retained_path'])==identity and originals.get(mapped)==identity,'Accepted pure-power source binding mismatch')
 for binding in read('independent-review/SOURCE_BINDINGS.json'):
  identity={'bytes':binding['bytes'],'sha256':binding['sha256']};safe_path(binding['original_path'])
  require(originals.get('independent-review/'+binding['retained_path'])==identity and originals.get(binding['original_path'])==identity,'Independent review source binding mismatch')
 candidate=read('independent-review/CANDIDATE_VERIFICATION.json')
 require(candidate['passed'] is True and candidate['author_report_sha256']==AUTHOR_REPORT and candidate['author_manifest_sha256']==AUTHOR_MANIFEST,'Frozen-byte replay not accepted')
 for key in ['inventory_exact','seal_valid','retained_sources_identical','isolated_author_replay_equal_excluding_time','author_bytes_unchanged_after_replay']:require(candidate[key] is True,'Incomplete frozen-byte verification')
 dep=read('DEPENDENCIES.json');require(dep['source_zip_sha256']==PRIOR_ZIP and accept['prior_portable_zip_sha256']==PRIOR_ZIP,'Prior ZIP identity changed')
 require(dep['portable_manifest_sha256']==PRIOR_MANIFEST and accept['prior_portable_manifest_sha256']==PRIOR_MANIFEST and desc(ROOT/'dependencies/pure-power/MANIFEST.json')['sha256']==PRIOR_MANIFEST,'Prior manifest identity changed')
 prior_rows=[r for r in ledger if r['source_packet']=='pure-power-portable'];require(len(prior_rows)==204 and dep['source_file_count']==204 and all(r['mode']=='exact' for r in prior_rows),'Prior portable dependency not complete and byte-identical')
 require(desc(ROOT/'CLAIM_SCOPE.json')['sha256']==SCOPE_HASH,'Theorem scope changed')
 require(desc(ROOT/'REPLAY_CASES.json')['sha256']==REPLAY_HASH,'Mathematical replay scope changed')
 config=read('REPLAY_CASES.json');cases=config['cases'];require(len(cases)==19 and sum(c['group']=='current' for c in cases)==5 and sum(c['group']=='prior' for c in cases)==14,'Incorrect replay program set')
 require(config['ignored_nondeterministic_keys']==['seconds','elapsed_seconds','total_seconds'],'Replay exclusions changed')
 for case in cases:
  for key in ['script','expected_output']:require(safe_path(case[key]).is_file(),'Missing checker or result')
  require(PurePosixPath(case['generated_output']).name==case['generated_output'],'Unsafe generated filename')
 tokens=['/'+'workspace'+'/','/'+'home'+'/','/'+'tmp'+'/','/'+'root'+'/','docs.google.com'+'/spreadsheets','cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','codex'+':','chatgpt'+'.com','native'+'_plan','delivery'+'_context','supplied by the '+'parent']
 for name in actual:
  text=(ROOT/name).read_text();require(not any(t in name or t in text for t in tokens),'Private locator or coordination token: '+name)
  require(re.search(r'f020_[a-z_]+_20\d{6}',name+'\n'+text) is None,'Original source-directory label: '+name)
 env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
 prior=subprocess.run([sys.executable,str(ROOT/'dependencies/pure-power/verify_package.py')],cwd=ROOT,env=env,text=True,capture_output=True)
 require(prior.returncode==0,'Prior complete dependency verification failed: '+prior.stderr)
 prior_result=json.loads(prior.stdout)
 return {'status':'PASS','public_files':len(actual),'source_entries':len(ledger),'locator_only_projections':sum(r['mode']=='locator_only_projection' for r in ledger),'explicit_omissions':sum(r['mode']=='omitted' for r in ledger),'independent_acceptance_bound_to_frozen_bytes':True,'root_only_derivative_scope_verified':True,'source_bindings_verified':True,'collaborative_and_independent_roles_preserved':True,'complete_prior_dependency':prior_result,'all_member_privacy_scan':'PASS','original_undistributed_bytes_reconstructed':False,'mathematical_replay':False}
if __name__=='__main__':print(json.dumps(main(),indent=2))
