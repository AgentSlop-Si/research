def require(test,message):
 if not test:raise ValueError(message)
def sha(b):return hashlib.sha256(b).hexdigest()
def desc(p):
 b=p.read_bytes();return {'bytes':len(b),'sha256':sha(b)}
def strict_equal(a,b):
 if type(a) is not type(b):return False
 if isinstance(a,dict):return a.keys()==b.keys() and all(strict_equal(a[k],b[k]) for k in a)
 if isinstance(a,list):return len(a)==len(b) and all(strict_equal(x,y) for x,y in zip(a,b))
 return a==b
def safe(root,name):
 p=PurePosixPath(name);require(type(name) is str and not p.is_absolute() and '..' not in p.parts and '\\' not in name and str(p)==name,'Unsafe relative path');return root/name
def read(root,name):return json.loads(safe(root,name).read_text())
def source_metadata(root):
 """Only call after verify; rebuild historical metadata from verified source identities."""
 cfg=[('comparison',ORIGINAL_MANIFESTS['comparison'],10),('dependencies/accepted-theorem/author','9159078187512872a2e297b0ae0b53493d3b8ddcb39f891561d5190e2f0282cb',10),('dependencies/accepted-theorem/independent-review','3c25ca2780ab2f50537fe9c8a8442318b4d20fe6d21e58d489d8c172c2fcd636',13)]
