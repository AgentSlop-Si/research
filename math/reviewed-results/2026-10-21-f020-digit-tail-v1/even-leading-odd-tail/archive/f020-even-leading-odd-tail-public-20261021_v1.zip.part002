"""Read-only verification of public bytes, frozen acceptance, scientific scope, and source chain."""
from pathlib import Path,PurePosixPath
import hashlib,json,re,subprocess,sys,os
ROOT=Path(__file__).resolve().parent
AUTHOR_REPORT='aa6dc8a3181a8064261ddaf5012584139b522860f5fe51ba8aa27b94ead3d83f'
AUTHOR_MANIFEST='3cb73ce47384069bcaa2570bb93cb5df6658916f791165de38b5200ac7fa7c5d'
ROUTE_MANIFEST='cae6174be795809d126a2b45cf50d3728846e92f29567425feac7ae1fb8539f2'
REVIEW_MANIFEST='988dc7d180345d44b85a9246691b026fb21516304d5eea33186b3a6ccafa4124';REVIEW_REPORT='d292e538275ad62d84311230e5d7f32fa1b889b19cb1b3aa350af31be3744a07'
PRIOR_MANIFEST='c150b74c7dfd9fc2cb4e385119c94772c4896bda91066617a1b93e673b61e476'
PRIOR_ZIP='d68af05305b28c56830b0f1e3700bc63f9d7f1d1e9d591e9f9a54bc618e776c5'
SCOPE_HASH='429b2392b09ef01d84d6fcda085c20bfd4826c3967222609792f60887fe20bb3';REPLAY_HASH='c0779d67f16342f6561c5db675c0814bcff5aafee2232e5c758697283cd9b8e9';ACCEPTANCE_HASH='39132e372fb0d4af405b100000e6c26cc282617d80eb73a7f525ef21ac7bf0ee'
REPLAY_COUNT=26
def require(ok,reason):
 if not ok:raise ValueError(reason)
def sha(raw):return hashlib.sha256(raw).hexdigest()
def desc(path):
 raw=path.read_bytes();return {'bytes':len(raw),'sha256':sha(raw)}
def read(name):return json.loads((ROOT/name).read_text())
def safe_path(name):
 p=PurePosixPath(name);require(not p.is_absolute() and '..' not in p.parts and str(p)==name and '\\' not in name,'Unsafe package path');return ROOT/name

def main():
 require(__debug__,'Run with assertions enabled, without Python optimization.')
 for p in ROOT.rglob('*'):require(not p.is_symlink(),'Symlinks are not permitted')
 actual={p.relative_to(ROOT).as_posix() for p in ROOT.rglob('*') if p.is_file()};manifest=read('MANIFEST.json');seal=read('SEAL.json')
 require(desc(ROOT/'MANIFEST.json')['sha256']==seal['manifest_sha256'],'Manifest seal mismatch')
 names=[r['path'] for r in manifest['files']];require(len(names)==len(set(names)),'Duplicate manifest path')
 require(actual==set(names)|{'MANIFEST.json','SEAL.json'},'Missing or unexpected package file');require(len(actual)==seal['file_count'],'File count mismatch')
 for row in manifest['files']:require(desc(safe_path(row['path']))=={'bytes':row['bytes'],'sha256':row['sha256']},'Byte identity mismatch: '+row['path'])
 ledger=read('SOURCE_LEDGER.json')['files'];omissions=read('OMISSIONS.json');exports={};originals={}
 require(len({(r['source_packet'],r['source_path']) for r in ledger})==len(ledger),'Duplicate source identity')
 require(omissions['final_proofs_reviews_mathematical_checkers_or_data_omitted'] is False,'Scientific evidence omitted')
 require([r for r in ledger if r['mode']=='omitted']==omissions['frozen_source_omissions'],'Omission records disagree')
 for row in ledger:
  safe_path(row['source_path'])
  if row['mode']=='omitted':
   require(row['export_path'] is None and bool(row['reason']),'Invalid omission')
   require(PurePosixPath(row['source_path']).name in ['RUN_LOG.md','verify_frozen.py'],'Unexpected omitted evidence');continue
  name=row['export_path'];require(name not in exports,'Duplicate exported identity');exports[name]=row;originals[name]=row['original'];path=safe_path(name)
  require(desc(path)==row['exported'],'Export identity mismatch: '+name)
  if row['mode']=='exact':require(row['original']==row['exported'],'Nonexact exact copy')
  else:
   require(row['mode']=='provenance_only_projection' and row['projection']['scientific_content_changed'] is False,'Invalid projection')
   require(row['original']!=row['exported'],'Empty projection')
   for change in row['projection']['replacements']:
    require(re.fullmatch('[0-9a-f]{64}',change['source_text_sha256']) is not None,'Invalid original text digest')
    require(change['kind'] in ['locator','coordination_prose'],'Invalid projection category')
    if change['kind']=='locator':safe_path(change['replacement'])
    require(change['count']>0 and path.read_text().count(change['replacement'])>=change['count'],'Projection replacement missing')
 accept=read('ACCEPTANCE.json');expected={'author':AUTHOR_MANIFEST,'exploratory-review':ROUTE_MANIFEST,'independent-review':REVIEW_MANIFEST}
 require(desc(ROOT/'ACCEPTANCE.json')['sha256']==ACCEPTANCE_HASH,'Acceptance identities or review roles changed')
 require(accept['status']=='PASS' and accept['original_source_manifest_sha256']==expected,'Incorrect acceptance')
 for namespace,expected_hash in expected.items():
  require(desc(ROOT/namespace/'MANIFEST.json')['sha256']==expected_hash,'Original manifest changed: '+namespace)
  require((ROOT/namespace/'SEAL.sha256').read_text().split()==[expected_hash,'MANIFEST.json'],'Original seal mismatch: '+namespace)
  source_rows=[row for row in ledger if row['source_packet']==namespace];manifest_rows=read(namespace+'/MANIFEST.json')['files']
  require({row['source_path'] for row in source_rows}=={row['path'] for row in manifest_rows}|{'MANIFEST.json','SEAL.sha256'},'Original source inventory not exact: '+namespace)
  for row in manifest_rows:
   hits=[r for r in source_rows if r['source_path']==row['path']]
   require(len(hits)==1 and hits[0]['original']=={'bytes':row['bytes'],'sha256':row['sha256']},'Original manifest entry mismatch')
 for path,key in [('author/REPORT.md','author_report'),('author/MANIFEST.json','author_manifest'),('independent-review/INDEPENDENT_REVIEW.md','independent_review'),('independent-review/VERDICT.json','independent_verdict'),('independent-review/MANIFEST.json','independent_manifest'),('exploratory-review/INDEPENDENT_REVIEW.md','exploratory_review'),('exploratory-review/VERDICT.json','exploratory_verdict')]:require(originals[path]==accept[key],'Acceptance source identity mismatch: '+path)
 require(desc(ROOT/'author/REPORT.md')['sha256']==AUTHOR_REPORT,'Frozen mathematical report changed')
 require(originals['independent-review/INDEPENDENT_REVIEW.md']['sha256']==REVIEW_REPORT,'Fresh report source identity changed')
 verdict=read('independent-review/VERDICT.json')
 require(verdict.get('verdict',verdict.get('status'))=='PASS','Fresh final acceptance is not PASS')
 require(verdict.get('author_report_sha256',verdict.get('candidate_report_sha256'))==AUTHOR_REPORT,'Final acceptance report mismatch')
 require(verdict.get('author_manifest_sha256',verdict.get('candidate_manifest_sha256'))==AUTHOR_MANIFEST,'Final acceptance manifest mismatch')
 for field in ['mathematical_revisions_requested','revisions_required','requested_revisions']:
  if field in verdict:require(verdict[field] in [[],False,None],'Outstanding mathematical revision')
 route=read('exploratory-review/VERDICT.json');require(route['verdict']=='PASS_ROUTE_VERIFICATION' and route['fresh_final_independent_acceptance'] is False,'Exploratory review mislabeled as final acceptance')
 require(route['author_report_sha256']==AUTHOR_REPORT and route['author_manifest_sha256']==AUTHOR_MANIFEST,'Route audit source mismatch')
 require(route['all_odd_low_digits_reviewed'] is True and route['isolated_author_replay_passed'] is True,'Incomplete exploratory scope')
 candidate=read('independent-review/CANDIDATE_VERIFICATION.json')
 require(candidate['author_report_sha256']==AUTHOR_REPORT and candidate['author_manifest_sha256']==AUTHOR_MANIFEST and candidate['exact_inventory'] is True and candidate['all_passed'] is True,'Fresh frozen-byte verification incomplete')
 for row in candidate['manifest_files']:
  matches=[x for x in ledger if x['source_packet']=='author' and x['source_path']==row['path']]
  require(len(matches)==1 and matches[0]['original']=={'bytes':row['bytes'],'sha256':row['sha256']} and row['status']=='PASS','Fresh candidate verification entry mismatch')
 comparison=read('independent-review/REPLAY_COMPARISON.json')
 for value in comparison.values():require(value is True,'Fresh isolated author replay incomplete')
 require(desc(ROOT/'exploratory-review/author_replay/check_exact.py')==desc(ROOT/'author/check_exact.py'),'Archived author replay checker differs')
 require((ROOT/'independent-review/AUTHOR_ADVERSE_REPLAY.log').read_bytes()==(ROOT/'author/ADVERSE_HULLS.log').read_bytes(),'Fresh adverse replay differs')
 binding_count=0
 for name in list(exports):
  if not name.endswith('/SOURCE_BINDINGS.json') or name.startswith('dependencies/'):continue
  rows=read(name)
  if not isinstance(rows,list):continue
  for binding in rows:
   if not all(k in binding for k in ['retained_path','bytes','sha256']):continue
   source=binding.get('source_path',binding.get('original_path'))
   if source is None:continue
   safe_path(source);identity={'bytes':binding['bytes'],'sha256':binding['sha256']}
   retained=(PurePosixPath(name).parent/binding['retained_path']).as_posix()
   # A copied binding document preserves its own historical relative base.
   if retained not in originals and name.endswith('/sources/SOURCE_BINDINGS.json'):retained='author/'+binding['retained_path']
   require(originals.get(source)==identity and originals.get(retained)==identity,'Scientific source binding mismatch: '+name);binding_count+=1
 dep=read('DEPENDENCIES.json');require(dep['source_zip_sha256']==PRIOR_ZIP and accept['prior_portable_zip_sha256']==PRIOR_ZIP,'Prior archive identity changed')
 require(dep['portable_manifest_sha256']==PRIOR_MANIFEST and accept['prior_portable_manifest_sha256']==PRIOR_MANIFEST and desc(ROOT/'dependencies/odd-low-digit/MANIFEST.json')['sha256']==PRIOR_MANIFEST,'Prior manifest identity changed')
 prior_rows=[r for r in ledger if r['source_packet']=='odd-low-digit-portable'];require(len(prior_rows)==260 and dep['source_file_count']==260 and all(r['mode']=='exact' for r in prior_rows),'Prior dependency is not complete and byte-identical')
 require(desc(ROOT/'CLAIM_SCOPE.json')['sha256']==SCOPE_HASH,'Theorem scope changed');require(desc(ROOT/'REPLAY_CASES.json')['sha256']==REPLAY_HASH,'Mathematical replay scope changed')
 config=read('REPLAY_CASES.json');cases=config['cases'];require(len(cases)==REPLAY_COUNT and sum(c['group']=='prior' for c in cases)==19,'Incorrect replay program set')
 require(config['ignored_nondeterministic_keys']==['seconds','elapsed_seconds','total_seconds'],'Replay exclusions changed')
 for case in cases:
  for key in ['script','expected_output']:require(safe_path(case[key]).is_file(),'Missing checker or result')
  if 'generated_output' in case:require(PurePosixPath(case['generated_output']).name==case['generated_output'],'Unsafe generated filename')
  for item in case.get('support_files',[]):require(safe_path(item['source']).is_file(),'Missing checker support file');require(PurePosixPath(item['target']).name==item['target'],'Unsafe support filename')
 tokens=['/'+'workspace'+'/','/'+'home'+'/','/'+'tmp'+'/','/'+'root'+'/','docs.google.com'+'/spreadsheets','cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','codex'+':','chatgpt'+'.com','native'+'_plan','delivery'+'_context','parent '+'workflow','file-writing '+'call','file-write '+'call','conversation/'+'tool sequence']
 for name in actual:
  text=(ROOT/name).read_text();require(not any(t in name or t in text for t in tokens),'Private locator or coordination token: '+name)
  require(re.search(r'f020_[a-z_]+_20\d{6}',name+'\n'+text) is None,'Original source-directory label: '+name)
 env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
 prior=subprocess.run([sys.executable,str(ROOT/'dependencies/odd-low-digit/verify_package.py')],cwd=ROOT,env=env,text=True,capture_output=True);require(prior.returncode==0,'Prior dependency verification failed: '+prior.stderr)
 return {'status':'PASS','public_files':len(actual),'source_entries':len(ledger),'provenance_only_projections':sum(r['mode']=='provenance_only_projection' for r in ledger),'explicit_omissions':sum(r['mode']=='omitted' for r in ledger),'fresh_acceptance_bound_to_frozen_full_family':True,'exploratory_and_fresh_review_roles_distinct':True,'scientific_source_bindings_checked':binding_count,'all_low_digits_only_combination_verified':True,'complete_prior_dependency':json.loads(prior.stdout),'all_member_privacy_scan':'PASS','original_undistributed_bytes_reconstructed':False,'mathematical_replay':False}
if __name__=='__main__':print(json.dumps(main(),indent=2))
