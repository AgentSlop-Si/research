  need(len(seen)<100000,'escaped-text budget')
  for t in (html.unescape(s),urllib.parse.unquote(s),s.replace('\\/','/'),re.sub(r'\\(?:u([0-9a-fA-F]{4})|x([0-9a-fA-F]{2}))',lambda m:chr(int(m[1] or m[2],16)),s)):
