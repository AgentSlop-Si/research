␀␀ú␀␀␀f020-even-leading-odd-tail-public-20261021_v1/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/dependencies/even-low-digit/exploratory-review/check_integer_bounds.py#!/usr/bin/env python3
from functools import lru_cache
from pathlib import Path
import json,random,time
OUT=Path(__file__).parent
@lru_cache(None)
def W(p,m):
 result=m;d=p
 while d<=m:result+=(d-d//p)*(m//d);d*=p
 return result

def vp(m,p):
 a=0
 while m%p==0:m//=p;a+=1
 return a

def setup(p,r):
 N=p**r;h=r//2;beta=p**h;alpha=beta-(r%2==0);B=r*(p-1)*p**(r-1)//2
 def T(m):return m+sum((p**j-p**(j-1))*(m//p**j) for j in range(1,h+1))-(m//beta if r%2==0 else 0)
 def R(m):return W(p,m)-T(m)
 return N,h,beta,alpha,B,T,R

def case(p,r,full=True):
 N,h,beta,alpha,B,T,R=setup(p,r);A=(N-1)//2;rng=random.Random(20261020+p+r)
 ms=range(N) if full else sorted({0,1,2,N-1,*[rng.randrange(N) for _ in range(10000)]})
 for m in ms:
  assert R(m)<=W(p,m//2),(p,r,'digit',m)
  if m and not m%2:assert R(m)<W(p,m//2)
  assert R(m)+R(N-1-m)==R(N-1),(p,r,'complement',m)
 assert B-R(N-1)<=N-alpha
 margin=N-alpha-B+R(N-1)
 expected=beta if not r%2 else ((p-1)//2)*p**(r-1)
 assert margin==expected
 us=range(A+1) if full else sorted({0,A,*[rng.randrange(A+1) for _ in range(10000)]})
 mingap=10**1000
 for u in us:
  assert W(p,N-1)-W(p,N-1-2*u)==W(p,2*u)
  gap=N-alpha-W(p,u)+R(2*u)
  assert gap>=margin
  mingap=min(mingap,gap)
  if u:assert W(p,A-u)+R(2*u)<B
 def pairs(parity):
  if full:
   for k in range(1 if parity else 2,N+1 if parity else N,2):
    for m in range(k):yield k,m
  else:
   for _ in range(20000):
    k=2*rng.randrange((N+1)//2)+1 if parity else 2*rng.randrange(1,(N+1)//2)
    yield k,rng.randrange(k)
 count=[0,0];best=[None,None]
 for parity in [0,1]:
  for k,m in pairs(parity):
   j=k-m;bound=W(p,(N-(0 if parity else 1)-k)//2)+R(m)+p**vp(j,p)
   if parity:
    if (k,m)==(p*p,0):assert bound==B+p
    else:assert bound<B+p,(p,r,'base derivative',k,m,bound,B+p)
   else:assert bound<=B,(p,r,'neighbor derivative',k,m,bound,B)
   count[parity]+=1
   if best[parity] is None or bound>best[parity][0]:best[parity]=(bound,k,m)
 return {'p':p,'r':r,'N':N,'alpha':alpha,'beta':beta,'B':B,'complete_grid':full,'digit_cases':len(ms),'cover_cases':len(us),'cover_gap_before_d0_min':mingap,'uniform_gap_before_d0':margin,'neighbor_derivative_terms':count[0],'base_derivative_terms':count[1],'maxima':best}
if __name__=='__main__':
 start=time.monotonic();out=[]
 for p,r in [(3,r) for r in range(2,7)]+[(5,r) for r in range(2,5)]+[(7,2),(7,3),(11,2),(13,2)]+[(p,r) for p in [3,5,7,11,31] for r in [10,11,20,21,30,31]]:
  result=case(p,r,p**r<=1000);out.append(result);print('PASS',p,r,'exhaustive' if result['complete_grid'] else 'sampled',flush=True)
  (OUT/'INTEGER_CHECKS.json').write_text(json.dumps(out,indent=2)+'\n')
 print('ALL INTEGER CHECKS PASS',round(time.monotonic()-start,3),flush=True)
