  text=(root/name).read_text();require(not any(t in name+'\n'+text for t in tokens),'Private locator or coordination identifier: '+name)
  require(re.search(r'f020_[a-z_]+_20\d{6}',name+'\n'+text) is None,'Private source label: '+name)
 result={'status':'PASS','public_files':len(actual),'new_source_files':23,'projected_source_files':sum(r['mode']=='public_projection' for r in ledger),'source_binding_entries_verified':bindings,'primary_references':6,'material_full_text_gaps':4,'source_identity_and_privacy_check':'PASS','new_mathematical_audit':False,'historical_novelty_established':False,'network_used':False}
 if recursive:
  env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
