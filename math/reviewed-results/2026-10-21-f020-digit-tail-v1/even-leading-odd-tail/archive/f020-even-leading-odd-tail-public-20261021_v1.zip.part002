  require(p.returncode==0,'Accepted theorem dependency verification failed: '+p.stderr[-1000:]);result['retained_theorem_verification']=json.loads(p.stdout)
 return result
if __name__=='__main__':
 try:print(json.dumps(verify(),indent=2))
 except Exception as e:print(json.dumps({'status':'FAIL','reason':str(e)}));raise SystemExit(1)
