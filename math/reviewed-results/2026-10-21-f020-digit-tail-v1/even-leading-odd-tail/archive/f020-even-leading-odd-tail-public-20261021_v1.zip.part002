  else:
   require(row['mode']=='public_projection','Unknown projection or omission')
   p=row['projection'];require(p['scientific_content_changed'] is False and p['mathematical_and_code_bytes_changed'] is False and p['contributor_credit_preserved'] is True,'Scientific projection forbidden')
   require(row['original']!=row['exported'] and not name.endswith('.py'),'Empty or code projection')
   for c in p['replacements']:
    require(c['kind'] in ['locator','attribution_role'] and type(c['count']) is int and c['count']>0 and type(c['source_text_bytes']) is int and c['source_text_bytes']>0 and re.fullmatch('[0-9a-f]{64}',c['source_text_sha256']),'Invalid projection record')
