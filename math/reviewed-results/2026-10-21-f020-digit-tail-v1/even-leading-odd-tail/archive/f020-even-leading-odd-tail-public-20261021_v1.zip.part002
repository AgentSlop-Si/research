PK␀␀␀␀␀␀␀!␀C”À␀␀À␀␀á␀␀␀f020-even-leading-odd-tail-public-20261021_v1/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/independent-review/check_formal_identities.pyfrom fractions import Fraction as F
from math import comb
from pathlib import Path
import json
O=Path(__file__).parent

def add(a,b):
 c=[F(0)]*max(len(a),len(b))
 for j,x in enumerate(a):c[j]+=x
 for j,x in enumerate(b):c[j]+=x
 while len(c)>1 and not c[-1]:c.pop()
 return c

def scale(a,s):return [x*s for x in a]
def mul(a,b):
 c=[F(0)]*(len(a)+len(b)-1)
 for j,x in enumerate(a):
  for k,y in enumerate(b):c[j+k]+=x*y
 return c

def derivative(a):return [j*a[j] for j in range(1,len(a))]
def exact_identities(q,limit):
 w=[F(1)];ev=[F(1)];H=[[F(1)]];P=[[F(1)],[F(0),F(1)]];NN=[[F(1)]]
 for n in range(1,limit+1):
  w.append(w[-1]*(1-q**n));ev.append(ev[-1]*(1-q**(2*n)))
  row=[(H[-1][k] if k<n else F(0))+(q**(n-k)*H[-1][k-1] if k else F(0)) for k in range(n+1)]
  H.append(row);NN.append(mul(NN[-1],[q**(n-1),F(1)]))
  if n>1:P.append(add([F(0)]+P[-1],scale(P[-2],q**(n-1)-1)))
 for n in range(1,limit+1):
  newt=[F(0)]
  for k in range(n%2,n+1,2):newt=add(newt,scale(NN[k],w[n]/w[k]/ev[(n-k)//2]))
  assert newt==H[n],(q,n,'both parity')
  nd=[F(0)]
  for m in range(n):nd=add(nd,[F(0)]*(n-m-1)+scale(NN[m],w[n]/w[m]/(1-q**(n-m))))
  assert nd==derivative(NN[n]),(q,n,'ordinary Newton derivative')
  hd=[F(0)]
  for k in range(2 if n%2==0 else 1,n+1,2):
   for m in range(k):hd=add(hd,[F(0)]*(k-m-1)+scale(NN[m],w[n]/ev[(n-k)//2]/w[m]/(1-q**(k-m))))
  assert hd==derivative(H[n]),(q,n,'ordinary H derivative')
  laur=[F(0)]*(2*n+1)
  for j,x in enumerate(P[n]):
   for k in range(j+1):laur[n+j-2*k]+=x*comb(j,k)
  assert laur[::2]==H[n] and not any(laur[1::2]),(q,n,'P-H normalization')
  lhs=[F(0)]
  for j in range(n):lhs=add(lhs,scale(mul(P[j],P[j]),w[n-1]/w[j]))
  rhs=add(mul(derivative(P[n]),P[n-1]),scale(mul(P[n],derivative(P[n-1])),-1))
  assert lhs==rhs,(q,n,'algebraic square CD')
 return {'q':str(q),'degrees':list(range(1,limit+1)),'both_parity_Newton':True,'ordinary_N_derivative':True,'ordinary_H_derivative':True,'original_P_H_identity':True,'ordinary_square_CD':True}
rows=[exact_identities(F(2),18),exact_identities(F(-2),18),exact_identities(F(2,3),18)]
(O/'FORMAL_IDENTITY_CHECKS.json').write_text(json.dumps(rows,indent=2)+'\n')
print('All formal identity controls passed:',len(rows)*18,'exact q,degree pairs')
PK␀␀␀␀␀␀␀!␀øb./4␀␀4␀␀Û␀␀␀f020-even-leading-odd-tail-public-20261021_v1/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/independent-review/check_independent.py"""Independent leading-two falsification controls. Exact arithmetic; no external I/O."""
from fractions import Fraction as F
from math import comb
from pathlib import Path
import json,time
OUT=Path(__file__).parent

def v_p(j,p):
    if not j: raise ValueError('zero')
    a=0
    while j%p==0: j//=p;a+=1
    return a

def integer_controls():
    result=[]
    cases=[(3,r) for r in range(2,10)]+[(5,r) for r in range(2,7)]+[(7,r) for r in range(2,6)]+[(11,r) for r in range(2,5)]+[(17,3),(31,2)]
    for p,r in cases:
        N=p**r;n=2*N;h=r//2;beta=p**h
        rho=F(beta,2) if r%2==0 else F(p**(h-1)*(2*p-1),2)
        B=F(r*(p-1)*p**(r-1),2)
        W=[0];twiceT=[0];powers=[0]
        for j in range(1,n+1):
            weight=p**v_p(j,p);powers.append(weight)
            W.append(W[-1]+weight);twiceT.append(twiceT[-1]+min(2*weight,int(2*rho)))
        twiceR=[2*w-t for w,t in zip(W,twiceT)]
        assert W[N]==N+2*B and W[n]==2*W[N]
        equal=[]
        for m in range(n+1):
            assert twiceR[m]<=W[m],(p,r,m)
            if twiceR[m]==W[m]:equal.append(m)
            if m<n:assert twiceR[m]+twiceR[n-1-m]==twiceR[n-1]
        assert equal==[0,N,n]
        assert F(twiceR[n-1],2)==W[N]-N+rho
        covergaps=[2*N-int(2*rho)-2*W[u]+twiceR[2*u-1] for u in range(1,N+1)]
        assert min(covergaps)>=0
        maxbracket=F(W[N],2)+B+p
        full=n<=1400;winners=[];mingap=None
        if full:
            for k in range(2,n+1,2):
                for m in range(k):
                    twicebracket=2*W[(n-k)//2]+twiceR[m]+2*powers[k-m]
                    gap=2*maxbracket-twicebracket
                    assert gap>=0,(p,r,k,m,gap)
                    if gap==0:winners.append([k,m])
                    else:mingap=gap if mingap is None else min(mingap,gap)
            assert winners==[[N+p*p,N]],(p,r,winners)
        # All possible ordinary-derivative j, including the endpoint j=2N.
        jscores=[F(2*powers[j]-W[j-1],2) for j in range(1,n+1)]
        assert max(jscores)==p and [j+1 for j,x in enumerate(jscores) if x==p]==[p*p]
        result.append({'p':p,'r':r,'n':n,'rho':str(rho),'half_W_equality':equal,'cover_min_gap':str(F(min(covergaps),2)),'full_double_sum':full,'winners':winners,'nonpivot_min_gap':str(F(mingap,2)) if mingap is not None else None})
    return result

class Cyclotomic:
    # Use the full cyclic group algebra first, unlike the author ring representation.
    # Canonical Phi reduction is performed only when extracting a valuation.
    def __init__(self,p,s):
        self.p=p;self.L=p**s;self.b=self.L//p;self.e=self.L-self.b
    def scalar(self,x):return [x]+[0]*(self.L-1)
    def add(self,a,b):return [x+y for x,y in zip(a,b)]
    def mul(self,a,b):
        out=[0]*self.L
        for i,x in enumerate(a):
            if x:
                for j,y in enumerate(b):
                    if y:out[(i+j)%self.L]+=x*y
        return out
    def shift(self,a,k):
        k%=self.L
        return a[-k:]+a[:-k] if k else a[:]
    def valuation_unit(self,a):
        v=a[:self.e]
        for j in range(self.b):
            x=a[self.e+j]
            for k in range(self.p-1):v[j+k*self.b]-=x
        tc=[0]*self.e
        for i,x in enumerate(v):
            if x:
                for j in range(i+1):tc[j]+=x*comb(i,j)
        weights=[]
        for j,x in enumerate(tc):
            if x:
                a=v_p(x,self.p)
                weights.append((j+self.e*a,((x//self.p**a)*(-1)**a)%self.p))
        return min(weights) if weights else None

def cyclotomic_control(p,r,s,centers):
    start=time.monotonic();R=Cyclotomic(p,s);N=p**r;n=2*N;h=r//2;beta=p**h
    rho=F(beta,2) if r%2==0 else F(p**(h-1)*(2*p-1),2)
    B=F(r*(p-1)*p**(r-1),2);D=F(3*N,2)+2*B-p;WN=N+2*B
    # Original Gaussian Pascal recursion, not the Rogers-Szego recurrence.
    row=[R.scalar(1)]
    for a in range(1,n+1):
        row=[R.add(row[j] if j<a else R.scalar(0),R.shift(row[j-1],a-j) if j else R.scalar(0)) for j in range(a+1)]
    def edge_unit(j):return -(j//p**v_p(j,p))%p
    def product(xs):
        a=1
        for x in xs:a=a*x%p
        return a
    Au=product(edge_unit(j) for j in range(1,n+1))*pow(product(edge_unit(j) for j in range(2,n+1,2)),-1,p)%p
    Cu=product(edge_unit(j) for j in range(1,n+1))*pow(product(edge_unit(j) for j in range(2,N-p*p+1,2))*product(edge_unit(j) for j in range(1,N+1))*edge_unit(p*p)%p,-1,p)%p
    records=[]
    for a in centers:
        tay=[]
        for j in range(n+1):
            acc=R.scalar(0)
            for k in range(j,n+1):
                mul=comb(k,j)*(-1)**(k-j)
                term=R.shift(row[k],a*(k-j))
                for t,x in enumerate(term):acc[t]+=mul*x
            tay.append(R.valuation_unit(acc))
        hweights=[(F(v)+j*rho,j,u) for j,x in enumerate(tay) if x for v,u in [x]]
        dweights=[(F(v)+v_p(j,p)*R.e+(j-1)*rho,j-1,u*(j//p**v_p(j,p))*(-1)**v_p(j,p)%p) for j,x in enumerate(tay) if j and x for v,u in [x]]
        hmin=min(x[0] for x in hweights);dmin=min(x[0] for x in dweights)
        hres=[(j,u) for w,j,u in hweights if w==hmin];dres=[(j,u) for w,j,u in dweights if w==dmin]
        def basis_unit(length):
            return product(((j-a)//p**v_p(j-a,p))%p for j in range(length) if (j-a)%beta)
        expectedH=[(0,Au),(n//beta,basis_unit(n))]
        expectedD=[(N//beta,Cu*basis_unit(N)%p)]
        assert hmin==WN and hres==expectedH,(p,r,s,a,hmin,hres,expectedH)
        assert dmin==D and dres==expectedD,(p,r,s,a,dmin,dres,expectedD)
        records.append({'a':a,'H_weight':str(hmin),'H_residual_terms':hres,'H_normalized_residual_terms':[(j,u*pow(Au,-1,p)%p) for j,u in hres],'ordinary_derivative_weight':str(dmin),'ordinary_derivative_residual_terms':dres,'minimum_other_H_gap':str(min(w-WN for w,j,u in hweights if w>WN)),'minimum_other_derivative_gap':str(min(w-D for w,j,u in dweights if w>D))})
        print('actual field passed',p,r,s,'center',a,'D',D,'e',R.e,flush=True)
    return {'p':p,'r':r,'s':s,'n':n,'rho':str(rho),'ramification_e':R.e,'D':str(D),'D_exceeds_e':D>R.e,'centers':records,'seconds':round(time.monotonic()-start,3)}

def main():
    out={'scope':'Independent exact finite falsification controls, not a substitute for the uniform proof.'}
    out['integer_controls']=integer_controls();print('integer controls passed',flush=True)
    out['actual_cyclotomic_controls']=[]
    for case in [(3,2,3,range(3)),(3,2,4,[0,1]),(3,3,4,range(3)),(5,2,3,range(5)),(3,4,5,[0,1,3,8])]:
        out['actual_cyclotomic_controls'].append(cyclotomic_control(*case))
        (OUT/'EXACT_INDEPENDENT_CHECKS.json').write_text(json.dumps(out,indent=2)+'\n')
    print('all independent controls passed',flush=True)
if __name__=='__main__':main()
