def verify(root=ROOT,recursive=True):
 root=Path(root)
 require(__debug__,'Assertions must be enabled')
 for p in root.rglob('*'):require(not p.is_symlink(),'Symlinks forbidden')
 actual={p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file()}
