PK␀␀␀␀␀␀␀!␀)<&ƒ␀␀␀␀Q␀␀␀f020-even-leading-odd-tail-public-20261021_v1/independent-review/verify_author.py#!/usr/bin/env python3
"""Independent exact author/snapshot verification. No candidate code imported."""
import argparse,hashlib,json,zipfile
from pathlib import Path,PurePosixPath
PIN='0eefd9ffec434bd8d05eb8c5143a9025b7826f351863777867d7b27bb277603c'
REPORT='2736127334ee95a7090f1ea293b05bdf61a7fc5f9f4afb1b996395b4e9c7fa37'
def need(x,msg):
    if not x:raise RuntimeError(msg)
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def safe(s):
    q=PurePosixPath(s);need(not q.is_absolute() and '..' not in q.parts,'unsafe manifest path');return q

def check_tree(root,pin,exact=False):
    need(root.is_dir() and not root.is_symlink(),'bad source root')
    need(sha(root/'MANIFEST.json')==pin,'immutable manifest mismatch')
    man=json.loads((root/'MANIFEST.json').read_text());seen=set()
    for item in man['files']:
        name=item['path'];safe(name);need(name not in seen,'duplicate manifest path');seen.add(name)
        file=root/name;need(file.is_file() and not file.is_symlink(),'missing or symlink')
        for parent in file.parents:
            if parent==root:break
            need(not parent.is_symlink(),'symlink ancestor')
        need(file.stat().st_size==item.get('bytes',item.get('size')),'length mismatch')
        need(sha(file)==item['sha256'],'file hash mismatch')
    if exact:
        actual=set()
        for f in root.rglob('*'):
            need(not f.is_symlink(),'symlink within candidate')
            if f.is_file():actual.add(f.relative_to(root).as_posix())
        need(actual==seen|{'MANIFEST.json','SEAL.json'},'candidate inventory mismatch')
        seal=json.loads((root/'SEAL.json').read_text())
        need(seal['manifest_sha256']==pin,'seal pin mismatch')
        need(seal['report_sha256']==REPORT==sha(root/'REPORT.md'),'report pin mismatch')
    return len(seen)

def run(root,originals=False):
    count=check_tree(root,PIN,True);sb=json.loads((root/'SOURCE_BINDINGS.json').read_text());names={x['name']:x for x in sb['sources']};rows=[]
    for s in sb['sources']:
        snap=root/s['snapshot'];safe(s['snapshot'])
        if 'snapshot_files' in s:
            need(sha(snap/'MANIFEST.json')==s['manifest_sha256'],'snapshot manifest mismatch')
            for f in s['snapshot_files']:
                safe(f['name']);need(sha(snap/f['name'])==f['sha256'],'snapshot file mismatch')
            files=None
            if originals:
                original=Path(s['source_path']);files=check_tree(original,s['manifest_sha256'])
                for f in s['snapshot_files']:need((original/f['name']).read_bytes()==(snap/f['name']).read_bytes(),'snapshot not exact original')
            rows.append({'name':s['name'],'manifest_sha256':s['manifest_sha256'],'selected_evidence_files':len(s['snapshot_files']),'full_original_files_checked':files})
        else:
            need(sha(snap)==s['sha256'],'archive pin mismatch')
            with zipfile.ZipFile(snap) as z:
                files=[i for i in z.infolist() if not i.is_dir()];ns=[i.filename for i in files]
                need(len(ns)==len(set(ns)),'duplicate archive path')
                for i in files:
                    safe(i.filename);need((i.external_attr>>16)&0o170000!=0o120000,'archive symlink')
                need(z.testzip() is None,'archive CRC failure')
            rows.append({'name':s['name'],'archive_sha256':s['sha256'],'archive_files':len(files),'archive_crc':'PASS'})
    pairs=[]
    for author,review in [('general-author','general-review'),('adjacent-lift-author','adjacent-lift-review'),('c2-odd-author','c2-odd-review'),('even-tail-author','even-tail-review')]:
        v=json.loads((root/names[review]['snapshot']/'VERDICT.json').read_text())
        need(v.get('author_manifest_sha256',v.get('candidate_manifest_sha256'))==names[author]['manifest_sha256'],'review author mismatch')
        need(v.get('verdict','').startswith('ACCEPTED'),'not accepted')
        rp=v.get('author_report_sha256',v.get('candidate_report_sha256'))
        if rp:need(rp==names[author]['report_sha256'],'review report mismatch')
        pairs.append({'author':author,'review':review,'acceptance_binding':'PASS'})
    return {'status':'PASS','author_manifest_sha256':PIN,'author_report_sha256':REPORT,'author_bound_file_count':count,'selected_sources':rows,'acceptance_pairs':pairs,'source_programs_executed':False,'original_source_bytes_checked':originals}
if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('candidate',type=Path);p.add_argument('--originals',action='store_true');a=p.parse_args();print(json.dumps(run(a.candidate,a.originals),indent=2,sort_keys=True))
PK␀␀␀␀␀␀␀!␀è÷Q␀␀␀␀Q␀␀␀f020-even-leading-odd-tail-public-20261021_v1/independent-review/verify_review.py#!/usr/bin/env python3
"""Verify exact reviewer inventory; pass the external immutable manifest pin."""
import argparse,hashlib,json
from pathlib import Path,PurePosixPath

def run(root,pin=None):
    def need(x,msg):
        if not x:raise RuntimeError(msg)
    def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
    m=json.loads((root/'MANIFEST.json').read_text());s=json.loads((root/'SEAL.json').read_text());h=sha(root/'MANIFEST.json')
    need(h==s['manifest_sha256'],'seal mismatch')
    if pin:need(h==pin,'external immutable pin mismatch')
    expected={'MANIFEST.json','SEAL.json'};seen=set()
    for row in m['files']:
        name=row['path'];rel=PurePosixPath(name);need(not rel.is_absolute() and '..' not in rel.parts,'unsafe path');need(name not in seen,'duplicate path');seen.add(name);expected.add(name)
        p=root/name;need(p.is_file() and not p.is_symlink(),'missing/symlink');need(p.stat().st_size==row['bytes'] and sha(p)==row['sha256'],'content mismatch')
    actual=set()
    for p in root.rglob('*'):
        need(not p.is_symlink(),'symlink')
        if p.is_file():actual.add(p.relative_to(root).as_posix())
    need(actual==expected,'inventory mismatch')
    return {'status':'PASS','manifest_sha256':h,'bound_files':len(seen),'external_pin_checked':pin is not None}
if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--root',type=Path,default=Path(__file__).resolve().parent);p.add_argument('--manifest');a=p.parse_args();print(json.dumps(run(a.root,a.manifest),indent=2,sort_keys=True))
