   need(row['mode']=='locator_projection' and (n.endswith('.json') or n=='author/sources/c2-odd-review/INDEPENDENT_REVIEW.md')and row['collection']in SOURCES,'projection scope');count+=1;context=raw;size=row['original']['bytes'];need(bool(row['changes']),'empty projection')
   for i,c in enumerate(row['changes']):
    keys(c,('kind','old_locator_bytes','old_locator_sha256','new_locator','count','context_marker'));need(c['kind']=='operational_locator_only' and type(c['count'])is int and c['count']>0,'projection kind');identity({'bytes':c['old_locator_bytes'],'sha256':c['old_locator_sha256']});new=c['new_locator'].encode();need(raw.count(new)==c['count'] and c['context_marker']==f'<OPERATIONAL_LOCATOR_{i}>','projection count');context=context.replace(new,c['context_marker'].encode());size+=(len(new)-c['old_locator_bytes'])*c['count'];occurrences+=c['count']
   need(len(raw)==size and sha(context)==row['unchanged_context_sha256'],'projection unchanged context')
 for row in inv['omissions']:
  key=(row['collection'],route(row['source_path']));need(key not in originals and row['source_path'].endswith('.zip'),'source omission');identity(row['original']);originals[key]=row['original']
 for coll in SOURCES:
  need(sha((root/coll/'MANIFEST.json').read_bytes())==SOURCES[coll]==read(root/coll/'SEAL.json')['manifest_sha256'],'current source seal');m=read(root/coll/'MANIFEST.json');names=set()
  for x in m['files']:
   n=route(x['path']);need(n not in names,'source duplicate');names.add(n);same(originals[(coll,n)],{k:x[k]for k in('bytes','sha256')},'original current source identity')
  same({n for c,n in originals if c==coll},names|{'MANIFEST.json','SEAL.json'},'current original source exact accounting')
  same(inventory(root/coll),{n[len(coll)+1:]for n in by if n.startswith(coll+'/')},'current source export set')
 for role in inv['selected_snapshot_inventory_roles']:
  coll=role['collection'];prefix=route(role['root']);m=read(root/coll/prefix/'MANIFEST.json');need(sha((root/coll/prefix/'MANIFEST.json').read_bytes())==role['manifest_sha256']==read(root/coll/prefix/'SEAL.json')['manifest_sha256'],'selected source seal');missing={x['path']:x for x in role['missing_original_inventory_files']};present=[]
  for x in m['files']:
   n=route(x['path']);key=(coll,prefix+'/'+n)
   if key in originals:same(originals[key],{k:x[k]for k in('bytes','sha256')},'selected source exact identity');present.append(n)
   else:need(n in missing,'undeclared snapshot omission');same({k:missing[n][k]for k in('bytes','sha256')},{k:x[k]for k in('bytes','sha256')},'snapshot missing identity')
  same(sorted(present),sorted(role['retained_listed_files']),'snapshot retained list');same(set(missing),{x['path']for x in m['files']}-set(present),'snapshot exact missing list');need(role['original_inventory_completely_retained']is(not missing),'snapshot completeness qualification')
 hist=read(root/'provenance/HISTORICAL_ARCHIVE_LEDGER.json');need(hist['raw_logs_exported']is False and hist['fresh_historical_execution']is False,'history disclosure');archives={a['original_archive']['sha256']:a for a in hist['archives']};need(len(archives)==3,'three accepted history archive layers');logs=0
 for a in hist['archives']:
  identity(a['original_archive']);need(a['envelope_retained']is False,'historical envelope qualification');coll=a['collection'];members={}
  for x in a['members']:
   n=route(x['path']);need(n not in members,'historical duplicate');members[n]=x;identity(x['original']);disp=x['disposition']
   if disp=='retained_verbatim':need(x['stored_path']in by and by[x['stored_path']]['mode']=='verbatim','history retained mapping');same(by[x['stored_path']]['original'],x['original'],'history retained identity')
   elif disp=='raw_runtime_log_omitted':need(n.endswith('.log')and(coll,n)not in originals,'only raw logs omitted');logs+=1
   else:need(disp=='expanded_archive_envelope_omitted'and n.endswith('.zip')and x['nested_archive_sha256']in archives,'archive expansion');same(archives[x['nested_archive_sha256']]['original_archive'],x['original'],'nested archive identity')
  prefix=a['original_root'];m=read(root/next(x['stored_path']for x in a['members']if x['path']==prefix+'/MANIFEST.json'));need(sha((root/next(x['stored_path']for x in a['members']if x['path']==prefix+'/MANIFEST.json')).read_bytes())==a['original_manifest_sha256'],'archive original manifest pin')
  expected={prefix+'/'+x['path']for x in m['files']}|{prefix+'/MANIFEST.json',prefix+'/SEAL.json'};same(set(members),expected,'exact historical archive member accounting')
  for x in m['files']:same(members[prefix+'/'+x['path']]['original'],{k:x[k]for k in('bytes','sha256')},'historical original inventory member')
 for x in inv['omissions']:same(archives[x['original']['sha256']]['original_archive'],x['original'],'omitted source archive expanded')
 same(inventory(root/'accepted-history'),{n[len('accepted-history/'):]for n in by if n.startswith('accepted-history/')},'history exact export set')
 return {'retained_files':len(by),'projected_files':count,'projected_locator_occurrences':occurrences,'omitted_archive_envelopes':len(archives),'omitted_raw_logs':logs,'selected_partial_inventories':sum(not x['original_inventory_completely_retained']for x in inv['selected_snapshot_inventory_roles']),'missing_selected_original_files':sum(len(x['missing_original_inventory_files'])for x in inv['selected_snapshot_inventory_roles'])}

def semantics(root):
 v=read(root/'independent-review/VERDICT.json');scope=read(root/'SCOPE.json');accept=read(root/'provenance/ACCEPTANCE_BINDING.json');binding=read(root/'author/SOURCE_BINDINGS.json');claim=read(root/'author/CLAIM_SCOPE.json')
 need(v['verdict']==accept['mathematical_verdict']=='ACCEPTED_WITHIN_EXACT_STATED_SCOPE','exact acceptance');need(v['author_manifest_sha256']==SOURCES['author']==accept['author_manifest_sha256'] and accept['review_manifest_sha256']==SOURCES['independent-review'],'acceptance identity');need(v['author_report_sha256']==sha((root/'author/REPORT.md').read_bytes()),'accepted report')
 same(accept['author_report'],ident((root/'author/REPORT.md').read_bytes()),'author report');same(accept['review_report'],ident((root/'independent-review/INDEPENDENT_REVIEW.md').read_bytes()),'review report');same(accept['review_verdict'],ident((root/'independent-review/VERDICT.json').read_bytes()),'verdict');same(scope['accepted_verdict'],v,'entire accepted scope');same(scope['author_claim'],claim,'entire author scope');need(accept['public_packaging_independently_accepted']is False,'no self acceptance')
 for k in ['all_original_derivative_pivots_retained','full_Mprime_bound_retained','all_competitor_and_lattice_margins_retained','original_P_H_squarefree','original_algebraic_square_CD_nonzero_at_every_P_root','public_byte_audit_pending']:need(scope[k]is True,'scope '+k)
 for k in ['arbitrary_n_claim','odd_c_claim','global_F020_F023_closed','FFT_or_cost_claim','historical_novelty_claim']:need(scope[k]is False,'scope '+k)
 need(scope['H_derivative_multiplier_residue']=='(-1)^(c/2+m)'and scope['p5_boundary']=='c=4,d=3 included; only first lift can apply at p=5','sign/boundary')
 sources={x['name']:x for x in binding['sources']};need(len(sources)==9,'exact selected evidence')
 for author,review in [('general-author','general-review'),('adjacent-lift-author','adjacent-lift-review'),('c2-odd-author','c2-odd-review'),('even-tail-author','even-tail-review')]:
  au=sources[author];rv=sources[review];p=root/'author'/au['snapshot'];q=root/'author'/rv['snapshot'];need(sha((p/'MANIFEST.json').read_bytes())==au['manifest_sha256'] and sha((q/'MANIFEST.json').read_bytes())==rv['manifest_sha256'],'accepted dependency pins');ver=read(q/'VERDICT.json');need(ver['verdict'].startswith('ACCEPTED')and ver.get('author_manifest_sha256',ver.get('candidate_manifest_sha256'))==au['manifest_sha256'],'accepted dependency relationship')
  for field in('author_report_sha256','candidate_report_sha256'):
   if field in ver:need(ver[field]==sha((p/'REPORT.md').read_bytes()),'dependency report binding')
 same(read(root/'author/sources/general-author/SOURCE_BINDINGS.json')['mathematical_dependencies'],[],'general authority self-contained')
 need(sources['accepted-p3-central-family']['sha256']=='667b37740cd2229082899e726a6efdb7e2be8b2e5d177eed5d3869bbcb79ec4e','p3 accepted archive identity')
 policy=read(root/'REPLAY_POLICY.json');same(policy['timing_exceptions'],['review result: /elapsed_seconds only'],'exact timing exception');same(policy['scientific_source_adapters'],[],'no scientific edits');need(policy['historical_programs_freshly_replayed']is False and policy['original_inventory_wrappers_replayed']is False,'no replay inflation')

def integrity(root=ROOT):
 actual=inventory(root);m=read(root/'MANIFEST.json');seal=read(root/'SEAL.json');keys(m,('schema_version','package','files'));keys(seal,('algorithm','manifest','manifest_sha256','file_count'));need(type(m['schema_version'])is int and m['schema_version']==1 and m['package']==PACKAGE,'manifest schema');need(seal['algorithm']=='SHA-256' and seal['manifest']=='MANIFEST.json' and seal['manifest_sha256']==sha((root/'MANIFEST.json').read_bytes()),'public manifest seal');need(type(seal['file_count'])is int and seal['file_count']==len(actual),'public file count');names=[]
 for row in m['files']:
  keys(row,('path','bytes','sha256'));n=route(row['path']);identity({k:row[k]for k in ('bytes','sha256')});names.append(n);same(ident((root/n).read_bytes()),{k:row[k]for k in ('bytes','sha256')},'public member identity: '+n)
 need(names==sorted(set(names)) and actual==set(names)|{'MANIFEST.json','SEAL.json'} and not {'MANIFEST.json','SEAL.json'}&set(names),'exact public inventory')
 dirs={str(p.relative_to(root)) for p in root.rglob('*') if p.is_dir()};expected_dirs={str(p) for n in actual for p in PurePosixPath(n).parents if str(p)!='.'};need(dirs==expected_dirs,'extra directory')
 for n,h in ANCHORS.items():need(sha((root/n).read_bytes())==h,'fixed administrative/scientific anchor: '+n)
 for n in sorted(actual):privacy(n,(root/n).read_bytes())
 src=source_check(root);semantics(root)
 return {'status':'PASS','public_regular_files':len(actual),'source_representation':src,'optimized_python':bool(sys.flags.optimize),'public_packaging_independently_accepted':False}

def reseal(root):
 files=[{'path':p,**ident((root/p).read_bytes())} for p in sorted(inventory(root)-{'MANIFEST.json','SEAL.json'})];(root/'MANIFEST.json').write_text(json.dumps({'schema_version':1,'package':PACKAGE,'files':files},indent=2,sort_keys=True)+'\n');(root/'SEAL.json').write_text(json.dumps({'algorithm':'SHA-256','manifest':'MANIFEST.json','manifest_sha256':sha((root/'MANIFEST.json').read_bytes()),'file_count':len(files)+2},indent=2,sort_keys=True)+'\n')
def negatives(root=ROOT):
 integrity(root);rows=[]
 for kind in ['changed_proof','missing_file','extra_file','extra_directory','symlink_file','symlink_directory','rehashed_proof','duplicate_json_key','unsafe_path','duplicate_manifest_member','wrong_seal','boolean_byte_count','negative_byte_count','float_byte_count','nonfinite_json']:
  with tempfile.TemporaryDirectory(prefix='public-inventory-mutant-') as td:
   d=Path(td)/'copy';shutil.copytree(root,d)
   if kind=='changed_proof':(d/'author/REPORT.md').write_bytes(b'changed')
   elif kind=='missing_file':(d/'author/REPORT.md').unlink()
   elif kind=='extra_file':(d/'EXTRA').write_text('extra')
   elif kind=='extra_directory':(d/'EXTRA').mkdir()
   elif kind=='symlink_file':(d/'author/REPORT.md').unlink();(d/'author/REPORT.md').symlink_to(root/'author/REPORT.md')
   elif kind=='symlink_directory':(d/'LINK').symlink_to(root/'author',target_is_directory=True)
   elif kind=='rehashed_proof':(d/'author/REPORT.md').write_bytes(b'changed');reseal(d)
   elif kind=='duplicate_json_key':p=d/'MANIFEST.json';p.write_text(p.read_text().replace('{','{"files": [],',1));s=read(d/'SEAL.json');s['manifest_sha256']=sha(p.read_bytes());(d/'SEAL.json').write_text(json.dumps(s))
   elif kind=='wrong_seal':s=read(d/'SEAL.json');s['manifest_sha256']='0'*64;(d/'SEAL.json').write_text(json.dumps(s))
   else:
    m=read(d/'MANIFEST.json')
    if kind=='unsafe_path':m['files'][0]['path']='../outside'
    elif kind=='boolean_byte_count':m['files'][0]['bytes']=True
    elif kind=='negative_byte_count':m['files'][0]['bytes']=-1
    elif kind=='float_byte_count':m['files'][0]['bytes']=float(m['files'][0]['bytes'])
    elif kind=='nonfinite_json':m['files'][0]['bytes']=float('nan')
    else:m['files'].append(m['files'][0])
    p=d/'MANIFEST.json';p.write_text(json.dumps(m));s=read(d/'SEAL.json');s['manifest_sha256']=sha(p.read_bytes());(d/'SEAL.json').write_text(json.dumps(s))
   rejected=False
   try:integrity(d)
   except (ValueError,OSError,KeyError,TypeError):rejected=True
   need(rejected,'accepted inventory mutant '+kind);rows.append({'mutation':kind,'rejected':True})
 members={PACKAGE+'/'+n:(root/n).read_bytes() for n in inventory(root)};raw=canonical_zip(members)
 tests={'prefix':b'prefix'+raw,'suffix':raw+b'suffix','eocd_comment':raw[:-2]+b'\x01\x00'+b'x'}
 for kind in ['compressed','timestamp','member_extra','archive_symlink','unsafe_archive_path','duplicate_archive_member','case_collision']:
  b=io.BytesIO()
  with zipfile.ZipFile(b,'w') as z:
   for i,(n,data) in enumerate(sorted(members.items())):
    info=zipfile.ZipInfo('../escape' if kind=='unsafe_archive_path' and i==0 else n,(1981,1,1,0,0,0) if kind=='timestamp' and i==0 else (1980,1,1,0,0,0));info.create_system=3;info.external_attr=(0o120777 if kind=='archive_symlink' and i==0 else 0o100644)<<16;info.compress_type=zipfile.ZIP_DEFLATED if kind=='compressed' else zipfile.ZIP_STORED
    if kind=='member_extra' and i==0:info.extra=b'\x01\x00\x00\x00'
    z.writestr(info,data)
   if kind in ('duplicate_archive_member','case_collision'):
    n,data=next(iter(sorted(members.items())));n=n if kind=='duplicate_archive_member' else n.upper()
    with warnings.catch_warnings():warnings.simplefilter('ignore');z.writestr(n,data)
  tests[kind]=b.getvalue()
 for kind,data in tests.items():
  rejected=False
  try:canonical_members(data)
  except (ValueError,OSError,zipfile.BadZipFile,UnicodeError,struct.error):rejected=True
  need(rejected,'accepted archive mutant '+kind);rows.append({'mutation':'archive_'+kind,'rejected':True})
 canonical_members(raw);integrity(root);return {'status':'PASS','optimized_python':bool(sys.flags.optimize),'mutations':rows,'original_unchanged':True}
def main():
 p=argparse.ArgumentParser();p.add_argument('--archive');p.add_argument('--expect-sha256');p.add_argument('--extract');p.add_argument('--negative-controls',action='store_true');a=p.parse_args()
 if a.archive:
  need(a.expect_sha256 is not None and HEX.fullmatch(a.expect_sha256),'trusted archive digest required');raw=Path(a.archive).read_bytes();need(sha(raw)==a.expect_sha256,'archive SHA-256 mismatch');canonical_members(raw)
  if a.extract:
   dest=Path(a.extract);extract(raw,dest);out=integrity(dest/PACKAGE)
  else:
   with tempfile.TemporaryDirectory(prefix='exact-zip-check-')as td:dest=Path(td)/'new';extract(raw,dest);out=integrity(dest/PACKAGE)
 else:need(not a.extract and not a.expect_sha256,'archive required');out=integrity()
 if a.negative_controls:out['negative_controls']=negatives()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=='__main__':
 try:main()
 except Exception as e:print('FAIL: '+str(e),file=sys.stderr);sys.exit(1)
