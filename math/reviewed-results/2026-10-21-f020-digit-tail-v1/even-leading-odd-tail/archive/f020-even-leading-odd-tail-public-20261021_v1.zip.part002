   need(central+46<=len(raw)-22 and raw[central:central+4]==b'PK\x01\x02','central record span');ch=struct.unpack('<4s6H3I5H2I',raw[central:central+46]);need(ch[3]==flags and ch[4]==method and ch[7]==crc and ch[8]==cs and ch[9]==us and ch[10]==ns and ch[11]==ch[12]==ch[13]==0 and ch[16]==pos,'central/local consistency');need(raw[central+46:central+46+ns]==name,'central name identity');central+=46+ns;pos=end
  need(pos==cdoff and central==len(raw)-22,'no ZIP prefix, suffix, gap or hidden record')

def zip_members(raw):
