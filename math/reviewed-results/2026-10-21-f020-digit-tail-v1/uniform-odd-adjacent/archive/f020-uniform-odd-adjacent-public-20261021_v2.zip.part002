from fractions import Fraction
from math import comb
import json
O=Path(__file__).parent

def trim(a):
 while len(a)>1 and a[-1]==0:a.pop()
 return a

def add(a,b):
 c=[0]*max(len(a),len(b))
 for j,v in enumerate(a):c[j]+=v
 for j,v in enumerate(b):c[j]+=v
 return trim(c)

def mul(a,b):
 c=[0]*(len(a)+len(b)-1)
 for j,v in enumerate(a):
  for k,w in enumerate(b):c[j+k]+=v*w
 return trim(c)

def scale(a,x):return trim([x*c for c in a])
def der(a):return trim([j*a[j] for j in range(1,len(a))] or [0])
def mod(a,p):return trim([x%p for x in a])
def rem(a,b,p):
 a=mod(a,p);b=mod(b,p)
 while len(a)>=len(b) and a!=[0]:
  v=a[-1]*pow(b[-1],-1,p)%p;d=len(a)-len(b)
  for j,w in enumerate(b):a[j+d]=(a[j+d]-v*w)%p
  trim(a)
 return a

def gcd(a,b,p):
 while b!=[0]:a,b=b,rem(a,b,p)
 return mod(scale(a,pow(a[-1],-1,p)),p)

def prime(n):
 d=2
 while d*d<=n:
  if n%d==0:return False
  d+=1
 return n>=2

def exact_identities():
 out=[]
 for q in [Fraction(2),Fraction(-3,2),Fraction(5,3)]:
  L=20;P=[[1],[0,1]];H=[[1],[1,1]];w=[1]
  for k in range(1,L+1):
   w.append(w[-1]*(1-q**k))
   if k<L:
    P.append(add([0]+P[-1],scale(P[-2],q**k-1)))
    H.append(add(mul([1,1],H[-1]),[0]+scale(H[-2],q**k-1)))
  for n in range(1,L+1):
   vv={}
   for j,c in enumerate(P[n]):
    for k in range(j+1):vv[n+j-2*k]=vv.get(n+j-2*k,0)+c*comb(j,k)
   assert all(vv.get(2*j,0)==v for j,v in enumerate(H[n]))
   lhs=[0]
   for j in range(n):lhs=add(lhs,scale(mul(P[j],P[j]),Fraction(1)/w[j]))
   rhs=scale(add(mul(der(P[n]),P[n-1]),scale(mul(der(P[n-1]),P[n]),-1)),Fraction(1)/w[n-1])
   assert lhs==rhs
  for N in [3,9,11]:
   As=[[1],[0,1]];Bs=[[0],[1]]
   for d in range(2,L-N+1):
    As.append(add([0]+As[-1],scale(As[-2],q**(N+d-1)-1)))
    Bs.append(add([0]+Bs[-1],scale(Bs[-2],q**(N+d-1)-1)))
   for d in range(1,L-N+1,2):
    a,b=As[d],Bs[d];an=1-q**N;f=P[N+d]
    assert f==add(mul(a,P[N]),scale(mul(b,P[N-1]),-an))
    # Cleared root-dependent elimination, exact identity before evaluating roots.
    lhs=add(mul(a,der(f)),scale(mul(der(a),f),-1))
    rhs=add(mul(mul(a,a),der(P[N])),scale(add(mul(add(mul(der(b),a),scale(mul(b,der(a)),-1)),P[N-1]),mul(mul(a,b),der(P[N-1]))),-an))
    assert lhs==rhs
  out.append({'q':str(q),'maximum_degree':L,'ordinary_CD_identity':True,'HP_identity':True,'all_odd_tail_elimination':True})
 return out

def finite():
 out=[]
 for p,r,s in [(3,2,3),(3,2,4),(3,3,4),(3,4,5),(5,2,3),(5,3,4),(7,2,3),(7,3,4),(11,2,3)]:
  N=p**r;M=p**s;ell=M+1
  while not prime(ell):ell+=M
  q=2
  while not (pow(q,M,ell)==1 and pow(q,M//p,ell)!=1):q+=1
  P=[[1],[0,1]];H=[[1],[1,1]]
  for j in range(1,N+p-1):
   P.append(mod(add([0]+P[-1],scale(P[-2],pow(q,j,ell)-1)),ell))
   H.append(mod(add(mul([1,1],H[-1]),[0]+scale(H[-2],pow(q,j,ell)-1)),ell))
  for d in range(1,p,2):
   n=N+d
   gp=gcd(P[n],mod(der(P[n]),ell),ell);gh=gcd(H[n],mod(der(H[n]),ell),ell);gc=gcd(P[n],P[n-1],ell)
   assert gp==gh==gc==[1]
   out.append({'p':p,'r':r,'s':s,'n':n,'prime':ell,'primitive_q':q,'P_derivative_gcd':gp,'H_derivative_gcd':gh,'consecutive_gcd':gc})
 return out
if __name__=='__main__':
 out={'rational_identities':exact_identities(),'finite_field_certificates':finite()}
 (O/'ORIGINAL_CHECKS.json').write_text(json.dumps(out,indent=2)+'\n');print('ALL ORIGINAL IDENTITIES AND',len(out['finite_field_certificates']),'FINITE CERTIFICATES PASS')
PK␀␀␀␀␀␀␀!␀)ûDù␀␀ù␀␀ù␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/dependencies/even-low-digit/exploratory-review/check_recorded_units.pyfrom pathlib import Path
import json
O=Path(__file__).parent
cases=json.loads((O/'CENTER_HULLS.json').read_text());out=[]
def edgeunit(j,p):
 while j%p==0:j//=p
 return -j%p

def prod(xs,p):
 a=1
 for x in xs:a=a*x%p
 return a
for c in cases:
 p,N=c['p'],c['N'];A=(N-1)//2
 uW=prod((edgeunit(j,p) for j in range(1,N+1)),p)
 uL=uW*pow(edgeunit(p*p,p)*prod((edgeunit(2*j,p) for j in range(1,(N-p*p)//2+1)),p)%p,-1,p)%p
 uV=prod((edgeunit(j,p) for j in range(1,N)),p)*pow(prod((edgeunit(2*j,p) for j in range(1,A+1)),p),-1,p)%p
 for r in c['disk_certificates']:
  target=uL if r['degree']==N else uV
  index=1 if r['degree']==N else 0
  got=next(x['unit'] for x in r['records'] if x['j']==index)
  assert got==target,(c,r['degree'],r['center'],target,got)
  out.append({'p':p,'r':c['r'],'s':c['s'],'degree':r['degree'],'center':r['center'],'unit':got,'factor_product_unit':target})
(O/'UNIT_CHECKS.json').write_text(json.dumps(out,indent=2)+'\n')
print('ALL',len(out),'RECORDED ACTUAL-FIELD UNITS MATCH FACTOR PRODUCT')
PK␀␀␀␀␀␀␀!␀]t)¾␀␀¾␀␀ø␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/accepted-history/history-c86929554da6cba6/f020-single-leading-digit-comparison/dependencies/accepted-theorem/dependencies/leading-two/dependencies/even-low-digit/exploratory-review/sources/ATTRIBUTION.md# Development and review attribution

The author developed the enlarged-cap route for n=N+1: alpha=beta-1 for even r, the strengthened digit inequality, the complete recurrence-based root cover, and the root-dependent ordinary derivative separation. The author also derived the odd-tail extension to all d=2c+1<p while preparing the full report.

A concurrent exploratory reviewer independently checked the integer inequalities and actual-field translated Newton hulls. During exploration that reviewer suggested an alternative neighboring-polynomial reflection identity for a smaller central cap; this alternative was not used in the final proof. The reviewer later sent an odd-tail valuation suggestion overlapping the author's extension. The entire expanded-family proof had already been written before the overlapping suggestion arrived. This chronology is documented in the development record, rather than inferred from file timestamps.

The overlap is nevertheless disclosed rather than describing the concurrent review as a pristine final acceptance of the full expanded scope. This package is an author candidate, and a new independent adversarial reviewer must audit and bind the frozen full-family artifact before acceptance. The core requested n=N+1 theorem is the c=0 specialization; the larger d=2c+1<p scope is explicitly identified in the theorem and must be included in that fresh audit.

The accepted odd-degree low-digit artifact and prior pure-power reports are retained as sources. Their authors and reviewers established those earlier scopes; this package does not retroactively claim those contributions. The provisional two-root heuristic was rejected by exact arithmetic and was not used in the proof.
