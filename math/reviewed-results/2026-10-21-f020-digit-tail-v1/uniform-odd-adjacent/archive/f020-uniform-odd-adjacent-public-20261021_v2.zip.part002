"""Read-only inventory and accepted-source bindings. No imported source code."""
import argparse, hashlib, json, zipfile
from pathlib import Path, PurePosixPath

def require(value,message):
    if not value:raise RuntimeError(message)
def digest(data):return hashlib.sha256(data).hexdigest()
def safe(path):
    pp=PurePosixPath(path)
    require(not pp.is_absolute() and '..' not in pp.parts,'unsafe manifest member')
    return pp

def run(root):
    seal=json.loads((root/'SEAL.json').read_text());manifest=json.loads((root/'MANIFEST.json').read_text())
    require(digest((root/'MANIFEST.json').read_bytes())==seal['manifest_sha256'],'manifest seal')
    require(digest((root/'REPORT.md').read_bytes())==seal['report_sha256'],'report seal')
    expected={str(safe(x['path'])) for x in manifest['files']}
    require(len(expected)==len(manifest['files']),'duplicate members')
    actual={str(x.relative_to(root)) for x in root.rglob('*') if x.is_file() and x.name not in []}
    require(not any(x.is_symlink() for x in root.rglob('*')),'symlinks rejected')
    require(actual==expected|{'MANIFEST.json','SEAL.json'},'extra or missing package file')
    for item in manifest['files']:
        data=(root/str(safe(item['path']))).read_bytes()
        require(len(data)==item['bytes'] and digest(data)==item['sha256'],'member '+item['path'])
    sources=json.loads((root/'SOURCE_BINDINGS.json').read_text())
    source_paths={str(x.relative_to(root)) for x in (root/'sources').rglob('*') if x.is_file()}
    require(source_paths=={x['path'] for x in sources['sources']},'source inventory exactness')
    for item in sources['sources']:
        data=(root/str(safe(item['path']))).read_bytes()
        require(len(data)==item['bytes'] and digest(data)==item['sha256'],'source '+item['path'])
    c3=root/'sources/accepted-c3-author';cm=json.loads((c3/'MANIFEST.json').read_text())
    for item in cm['files']:
        data=(c3/str(safe(item['path']))).read_bytes()
        require(len(data)==item['bytes'] and digest(data)==item['sha256'],'c3 retained manifest '+item['path'])
    ca=json.loads((root/'sources/accepted-c3-review/ACCEPTANCE_BINDING.json').read_text())
    require(digest((c3/'MANIFEST.json').read_bytes())==ca['author_manifest_sha256'],'accepted c3 author manifest')
    require(digest((c3/'REPORT.md').read_bytes())==ca['author_report']['sha256'],'accepted c3 report')
    require(digest((root/'sources/accepted-c3-review/INDEPENDENT_REVIEW.md').read_bytes())==ca['review_report']['sha256'],'accepted c3 public review')
    ec=root/'sources/even-second-layer-comparison';ea=json.loads((ec/'ACCEPTANCE_BINDING.json').read_text())
    require(digest((ec/'AUTHOR_REPORT.md').read_bytes())==ea['author_report_sha256'],'even scalar-source report')
    require(digest((ec/'REVIEW.md').read_bytes())==ea['review_report_sha256'],'even scalar-source review')
    require(digest((ec/'VERDICT.json').read_bytes())==ea['review_verdict_sha256'],'even scalar-source verdict')
    checked=[]
    with zipfile.ZipFile(c3/'sources/accepted-single-leading-digit-comparison.zip') as z:
        for name in ['f020-single-leading-digit-comparison/MANIFEST.json','f020-single-leading-digit-comparison/dependencies/accepted-theorem/MANIFEST.json']:
            raw=z.read(name);zm=json.loads(raw);prefix=str(PurePosixPath(name).parent)
            for item in zm['files']:
                data=z.read(prefix+'/'+str(safe(item['path'])))
                require(len(data)==item['bytes'] and digest(data)==item['sha256'],'archive member '+item['path'])
            checked.append({'manifest':name,'sha256':digest(raw),'entries':len(zm['files'])})
        base='f020-single-leading-digit-comparison/dependencies/accepted-theorem/'
        for relative in ['ACCEPTANCE.json','author/REPORT.md','independent-review/INDEPENDENT_REVIEW.md','independent-review/VERDICT.json']:
            require((c3/'sources/leading-digit'/relative).read_bytes()==z.read(base+relative),'readable leading-digit source '+relative)
    return {'status':'PASS','files':len(expected),'retained_c3_manifest_entries':len(cm['files']),'archive_manifests':checked,'source_programs_executed':False}

def main():
    parser=argparse.ArgumentParser();parser.add_argument('--root',type=Path,default=Path(__file__).resolve().parent);args=parser.parse_args()
    print(json.dumps(run(args.root),indent=2,sort_keys=True))
if __name__=='__main__':main()
