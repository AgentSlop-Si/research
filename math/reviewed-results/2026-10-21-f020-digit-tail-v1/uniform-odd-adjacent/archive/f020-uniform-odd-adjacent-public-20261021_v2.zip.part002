"""Read-only exact inventory, source, scoped-acceptance and retained-receipt verifier."""
from pathlib import Path,PurePosixPath
import hashlib,json,os,re,subprocess,sys
ROOT=Path(__file__).resolve().parent
ANCHORS={'SOURCE_LEDGER.json': 'dcac7554381274be77e6226c3f85166ace171254dd39119ab67fa55622fc7c8d', 'OMISSIONS.json': '475c3186caaa78567f631f3b2f912c62899170fb2d63e0430bf148583f23b6d6', 'DEPENDENCIES.json': '910c4fafa59f689aefe34891c55621ecf49309e3125a8b85bf5145845ce4a6fc', 'ACCEPTANCE.json': 'a740f4ddb4f682417c0fee0f4e55c032169a832a599d276843968366eacc931a', 'CLAIM_SCOPE.json': '69d76a2acc952310e77a4c385968fa68c5e56d3f60b656a859e0ae5c6c1d4e83', 'REPLAY_CASES.json': '60ee5799af45a347ee9df1d1a573bfe000e791cdd629e385ebe8b100e221260a'}
ORIGINAL_MANIFESTS={'author':'9159078187512872a2e297b0ae0b53493d3b8ddcb39f891561d5190e2f0282cb','independent-review':'3c25ca2780ab2f50537fe9c8a8442318b4d20fe6d21e58d489d8c172c2fcd636'}
AUTHOR_REPORT='012c2bdcf24d01c15641c938ac7b240c078ed8089e46fd9d0ebe0e34069092a6'
AUDIT_REPORT='f9b97587ed3c76a915d053d12642ae4113c1426058e9b1effeeacfe6b8db6b43'
PRIOR_MANIFEST='4f7a26b247d12df5490d155de2743113a6752853e9df804b4aace08c7b9dd2ee'
PRIOR_ZIP='9e2a039298a8880df44dc47a347e0b53e887593e522234c99e3deb0d7251e666'
PRIOR_RELEASE='dd79248d7a0101b928c0de6435d5c43def27f1cfee880cd32364169eb13945a9'
def require(ok,msg):
 if not ok:raise ValueError(msg)
def sha(b):return hashlib.sha256(b).hexdigest()
def desc(p):
 b=p.read_bytes();return {'bytes':len(b),'sha256':sha(b)}
def read(name):return json.loads((ROOT/name).read_text())
def safe(name):
 p=PurePosixPath(name);require(not p.is_absolute() and '..' not in p.parts and '\\' not in name and str(p)==name,'Unsafe relative path');return ROOT/name
def main():
 require(__debug__,'Run with assertions enabled, without Python optimization.')
 for p in ROOT.rglob('*'):require(not p.is_symlink(),'Symlink forbidden')
 actual={p.relative_to(ROOT).as_posix() for p in ROOT.rglob('*') if p.is_file()}
 m=read('MANIFEST.json');s=read('SEAL.json');names=[r['path'] for r in m['files']]
 require(len(names)==len(set(names)),'Duplicate inventory member')
 require(desc(ROOT/'MANIFEST.json')['sha256']==s['manifest_sha256'],'Manifest seal mismatch')
 require(actual==set(names)|{'MANIFEST.json','SEAL.json'},'Missing or unexpected package file')
 require(len(actual)==s['file_count'],'File count mismatch')
 for r in m['files']:require(desc(safe(r['path']))=={k:r[k] for k in ['bytes','sha256']},'Member mismatch: '+r['path'])
 for path,digest in ANCHORS.items():require(desc(ROOT/path)['sha256']==digest,'Fixed semantic anchor changed: '+path)
 ledger=read('SOURCE_LEDGER.json')['files'];exports={};originals={}
 require(len({(r['source_packet'],r['source_path']) for r in ledger})==len(ledger),'Repeated source identity')
 for row in ledger:
  safe(row['source_path']);originals[row['source_packet']+'/'+row['source_path']]=row['original']
  name=row['export_path'];require(name not in exports,'Repeated export');exports[name]=row;originals[name]=row['original']
  require(desc(safe(name))==row['exported'],'Source public identity changed: '+name)
  if row['mode']=='exact':require(row['original']==row['exported'],'Exact copy differs')
  else:
   require(row['mode']=='public_projection','Unknown projection or omission')
   p=row['projection'];require(p['scientific_content_changed'] is False and p['mathematical_and_code_bytes_changed'] is False and p['contributor_credit_preserved'] is True,'Scientific projection forbidden')
   require(row['original']!=row['exported'] and not name.endswith('.py'),'Empty or code projection')
   for c in p['replacements']:
    require(c['kind'] in ['locator','attribution_role'] and type(c['count']) is int and c['count']>0 and type(c['source_text_bytes']) is int and c['source_text_bytes']>0 and re.fullmatch('[0-9a-f]{64}',c['source_text_sha256']),'Invalid projection record')
