 require(accept['source_manifests']==ORIGINAL_MANIFESTS and verdict['comparison_manifest_sha256']==ORIGINAL_MANIFESTS['comparison'],'Wrong accepted source')
 require(verdict['report_sha256']==accept['comparison_report_original_sha256']==originals['comparison/REPORT.md']['sha256']=='986b15c01a608b789a9328eeeee342ec77299bb7e14870a4c0ea03adc90e71c5','Wrong comparison report')
 require(verdict['historical_novelty']==accept['historical_novelty']=='not established' and verdict['literature_completeness']==accept['literature_completeness']=='not claimed','Overstated novelty/completeness')
 require(verdict['full_text_gaps']==accept['gaps'] and len(accept['gaps'])==4 and verdict['required_fixes']==accept['required_fixes']==[],'Gap or disposition change')
 om=read(root,'OMISSIONS.json');require(om['all_new_comparison_and_review_source_files_retained'] is True and om['new_source_omissions']==[] and om['third_party_full_papers_included'] is False,'Retention boundary changed')
 cases=read(root,'REPLAY_CASES.json');require(cases['ignored_json_fields']==[] and cases['type_strict'] is True and len(cases['cases'])==2,'Replay weakened')
 independent=cases['cases'][1];code=(root/independent['script']).read_bytes();marker=independent['body_marker'].encode()
 require(code.count(marker)==1 and sha(marker+code.split(marker,1)[1])==independent['body_sha256'],'Independent numerical body differs')
 require(read(root,'comparison/CHECK_RESULTS.json')['counts']==cases['cases'][0]['expected_counts'] and read(root,'review/INDEPENDENT_CHECKS.json')['counts']==independent['expected_counts'],'Wrong controls inventory')
