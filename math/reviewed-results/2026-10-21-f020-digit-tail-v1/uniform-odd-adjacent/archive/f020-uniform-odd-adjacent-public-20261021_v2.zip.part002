PK␀␀␀␀␀␀␀!␀­b—¬l␀␀l␀␀I␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/independent-review/verify.py#!/usr/bin/env python3
"""Read-only inventory verification; optional replay executes reviewer code only."""
from pathlib import Path, PurePosixPath
import argparse, hashlib, json, os, resource, shutil, subprocess, sys, tempfile
ROOT=Path(__file__).resolve().parent

def require(x,message):
    if not x: raise RuntimeError(message)
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def inventory(root,expected=None):
    manifest=root/'MANIFEST.json'; seal=json.loads((root/'SEAL.json').read_text());actual_hash=sha(manifest)
    require(seal['manifest_sha256']==actual_hash,'seal manifest mismatch')
    if expected:require(actual_hash==expected,'external manifest anchor mismatch')
    obj=json.loads(manifest.read_text()); entries=obj['files'];listed=set()
    for ent in entries:
        rel=ent['path'];p=PurePosixPath(rel)
        require(not p.is_absolute() and '..' not in p.parts and rel not in listed,'unsafe or duplicate inventory path')
        listed.add(rel);target=root/rel
        require(target.is_file() and not target.is_symlink(),'missing or symlink member: '+rel)
        require(all(not parent.is_symlink() for parent in target.parents if parent!=root.parent),'symlink parent')
        require(target.stat().st_size==ent['bytes'] and sha(target)==ent['sha256'],'content mismatch: '+rel)
    actual={p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file() or p.is_symlink()}
    require(actual==listed|{'MANIFEST.json','SEAL.json'},'unlisted or missing package file')
    return {'manifest_sha256':actual_hash,'verified_entries':len(entries),'status':'PASS'}
def limits():
    resource.setrlimit(resource.RLIMIT_CPU,(150,150));resource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3));resource.setrlimit(resource.RLIMIT_FSIZE,(32*1024**2,32*1024**2))
def replay():
    checks=[('checks.py','CONTROL_RESULTS.json'),('second_layer.py','SECOND_LAYER_RESULTS.json'),('structural_second_layer.py','STRUCTURAL_SECOND_LAYER_RESULTS.json')]
    rows=[]
    with tempfile.TemporaryDirectory(prefix='f020-odd-review-replay-') as temp:
        temp=Path(temp)
        env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1',PYTHONDONTWRITEBYTECODE='1')
        for script,result in checks:
            shutil.copyfile(ROOT/'private'/script,temp/script)
            p=subprocess.run([sys.executable,str(temp/script)],cwd=temp,env=env,text=True,capture_output=True,timeout=180,preexec_fn=limits)
            require(p.returncode==0,script+' failed: '+p.stdout+'\n'+p.stderr)
            require((temp/result).read_bytes()==(ROOT/'private'/result).read_bytes(),'cold replay bytes differ: '+result)
            rows.append({'script':script,'result_sha256':sha(temp/result),'byte_identical':True,'stdout':p.stdout})
    return {'only_new_reviewer_code_executed':True,'source_programs_executed':False,'resource_caps':{'cpu_seconds_per_program':150,'wall_seconds_per_program':180,'address_space_bytes':1024**3,'file_size_bytes':32*1024**2},'programs':rows,'status':'PASS'}
def main():
    ap=argparse.ArgumentParser();ap.add_argument('--expect-manifest');ap.add_argument('--replay',action='store_true');args=ap.parse_args()
    out={'inventory':inventory(ROOT,args.expect_manifest)}
    if args.replay:out['replay']=replay();out['post_replay_inventory']=inventory(ROOT,args.expect_manifest)
    print(json.dumps(out,indent=2,sort_keys=True))
if __name__=='__main__':main()
