"""Exact transcription/falsification controls, not a finite substitute for the proof."""
import json,math,random,time
from fractions import Fraction
from pathlib import Path
import sympy as sp
OUT=Path(__file__).resolve().parent

def W(p,m):
    ans=m;pw=p
    while pw<=m: ans+=(pw-pw//p)*(m//pw);pw*=p
    return ans

def pp(p,j):
    assert j>0
    a=1
    while j%p==0:j//=p;a*=p
    return a

def setup(p,r):
    N=p**r;h=r//2;beta=p**h;alpha=beta-(r%2==0);B=r*(p-1)*p**(r-1)//2;D=N+B-p
    def T(m):
        ans=m;pw=p
        for _ in range(h):ans+=(pw-pw//p)*(m//pw);pw*=p
        return ans-(m//beta if r%2==0 else 0)
    def R(m):return W(p,m)-T(m)
    return N,beta,alpha,B,D,T,R

def integer_checks():
    rng=random.Random(20261020);rows=[]
    for p in (3,5,7,11,17,31):
      for r in range(2,17):
        N,beta,alpha,B,D,T,R=setup(p,r);A=(N-1)//2
        ms=list(range(N)) if N<=3000 else [0,1,2,N-1,N-2]+[rng.randrange(N) for _ in range(2000)]
        for m in ms:
            assert R(m)<=W(p,m//2)
            if m>0 and m%2==0:assert R(m)<W(p,m//2)
            assert R(m)+R(N-1-m)==R(N-1)
        C=N-alpha-(B-R(N-1))
        assert C==(beta if r%2==0 else (p-1)*p**(r-1)//2)
        assert C>=alpha and alpha>Fraction(p,2)
        us=list(range(A+1)) if N<=3000 else [0,1,A]+[rng.randrange(A+1) for _ in range(1000)]
        for u in us:
            assert W(p,u)-R(2*u)<=B-R(N-1)
            if u:assert W(p,u)-R(2*u-1)<=B-R(N-1)
        # All or sampled ordinary derivative double-summand comparisons.
        pairs=[(k,m) for k in range(1,N+1,2) for m in range(k)] if N<=625 else [(p*p,0)]+[(2*rng.randrange((N+1)//2)+1,0) for _ in range(1000)]
        if N>625:
            for _ in range(2000):
                k=2*rng.randrange((N+1)//2)+1;pairs.append((k,rng.randrange(k)))
        winners=[]
        for k,m in pairs:
            bracket=W(p,(N-k)//2)+R(m)+pp(p,k-m)
            assert bracket<=B+p,(p,r,k,m,bracket,B+p)
            if bracket==B+p:assert (k,m)==(p*p,0);winners.append((k,m))
        rows.append(dict(p=p,r=r,N=N,beta=beta,alpha=alpha,B=B,D=D,cover_margin=C,digit_tests=len(ms),cover_tests=len(us),derivative_tests=len(pairs)))
    return rows

def rational_checks():
    X,z=sp.symbols('X z');rows=[]
    for q in (sp.Rational(2),sp.Rational(-2),sp.Rational(1,2)):
        M=14;w=[sp.Integer(1)];w2=[sp.Integer(1)];P=[sp.Integer(1),X];H=[sp.Integer(1),1+z];Nb=[sp.Integer(1)]
        for j in range(1,M+1):w.append(w[-1]*(1-q**j));w2.append(w2[-1]*(1-q**(2*j)));Nb.append(sp.expand(Nb[-1]*(z+q**(j-1))))
        for j in range(1,M):P.append(sp.expand(X*P[-1]-(1-q**j)*P[-2]));H.append(sp.expand((1+z)*H[-1]-z*(1-q**j)*H[-2]))
        for n in range(M+1):
            new=sum(w[n]*Nb[k]/(w[k]*w2[(n-k)//2]) for k in range(n%2,n+1,2))
            assert sp.expand(new-H[n])==0
            derivative=sum(w[n]*z**(k-m-1)*Nb[m]/(w2[(n-k)//2]*w[m]*(1-q**(k-m))) for k in range(n%2,n+1,2) if k for m in range(k))
            assert sp.expand(derivative-sp.diff(H[n],z))==0
            if n:
                cd=sum(P[j]**2/w[j] for j in range(n))
                assert sp.expand(cd-(sp.diff(P[n],X)*P[n-1]-P[n]*sp.diff(P[n-1],X))/w[n-1])==0
        N=7;aa=[sp.Integer(1),X];bb=[sp.Integer(0),sp.Integer(1)]
        for d in range(2,8):aa.append(sp.expand(X*aa[-1]-(1-q**(N+d-1))*aa[-2]));bb.append(sp.expand(X*bb[-1]-(1-q**(N+d-1))*bb[-2]))
        for d in range(1,8):assert sp.expand(P[N+d]-aa[d]*P[N]+(1-q**N)*bb[d]*P[N-1])==0
        rows.append(dict(q=str(q),newton_degrees=list(range(M+1)),ordinary_derivative_degrees=list(range(M+1)),CD_degrees=list(range(1,M+1)),tail_base=N,tail_degrees=list(range(1,8))))
    return rows

def hermite_checks():
    X=sp.Symbol('X');rows=[]
    for p in (3,5,7,11,17,31):
        H=[sp.Poly(1,X,modulus=p),sp.Poly(X,X,modulus=p)]
        for n in range(1,3*p+p-1):H.append(sp.Poly(X*H[-1].as_expr()-n*H[-2].as_expr(),X,modulus=p))
        for n in range(p,len(H)):
            a,d=divmod(n,p);assert H[n]==sp.Poly(X**(a*p)*H[d].as_expr(),X,modulus=p)
        for d in range(1,p,2):
            assert int(H[d].coeff_monomial(X))%p
            assert sp.gcd(H[d],H[d].diff()).degree()==0
        rows.append(dict(p=p,block_degrees=len(H),odd_digits=list(range(1,p,2))))
    return rows

def field_case(p,r,s,centers):
    start=time.monotonic();N,beta,alpha,B,D,T,R=setup(p,r);order=p**s;gap=order//p;e=order-gap
    def rot(v,a):
        a%=order;out=[0]*e
        for j,c in enumerate(v):
            if not c:continue
            k=(j+a)%order
            if k<e:out[k]+=c
            else:
                for h in range(p-1):out[k-e+h*gap]-=c
        return out
    one=[1]+[0]*(e-1);old=[one];cur=[one,one];saved={}
    for n in range(1,N+1):
        if n in (N-1,N):saved[n]=cur
        if n==N:break
        nxt=[[0]*e for _ in range(n+2)]
        for j,v in enumerate(cur):
            for k,c in enumerate(v):nxt[j][k]+=c;nxt[j+1][k]+=c
        for j,v in enumerate(old):
            sh=rot(v,n)
            for k,(a,b) in enumerate(zip(sh,v)):nxt[j+1][k]+=a-b
        old,cur=cur,nxt
    def valuation(v):
        if not any(v):return None
        cs=v[:]
        for a in range(e-2,-1,-1):
            for j in range(a,e-1):cs[j]+=cs[j+1]
        out=[]
        for j,c in enumerate(cs):
            if not c:continue
            a=0
            while c%p==0:c//=p;a+=1
            out.append((j+a*e,c*(-1)**a%p))
        return min(out)
    rows=[]
    for n,H in saved.items():
      for a in centers:
        cs=[[0]*e for _ in range(n+1)]
        for k,v in enumerate(H):
          for j in range(k+1):
            sh=rot(v,a*(k-j));f=math.comb(k,j)*(-1)**(k-j)
            for b,c in enumerate(sh):cs[j][b]+=f*c
        rec=[]
        for j,v in enumerate(cs):
            vv=valuation(v)
            if vv is None:continue
            w,u=vv;vjp=0;jj=j
            if j:
                while jj%p==0:jj//=p;vjp+=1
            rec.append(dict(j=j,coefficient_weight=w,unit=u,disk_weight=w+j*alpha,derivative_disk_weight=w+(j-1)*alpha+e*vjp if j else None))
        if n==N:
            der=[x for x in rec if x['j']]
            assert der[0]['j']==1 and der[0]['derivative_disk_weight']==D,(p,r,s,a,D,der[0])
            assert all(x['derivative_disk_weight']>D for x in der[1:]),(p,r,s,a,'derivative gap')
        else:
            assert rec[0]['j']==0 and rec[0]['disk_weight']==B
            assert all(x['disk_weight']>B for x in rec[1:])
            assert all(x['derivative_disk_weight']>=B for x in rec if x['j'])
        rows.append(dict(n=n,center=a,records=rec))
    return dict(p=p,r=r,s=s,N=N,beta=beta,alpha=alpha,e=e,B=B,D=D,cases=rows,seconds=round(time.monotonic()-start,3))

def modular_certificates():
    rows=[];X=sp.Symbol('X')
    for p,r,s in ((3,2,3),(3,3,4),(3,4,5),(5,2,3),(5,3,4),(7,2,3)):
        order=p**s;ell=order+1
        while not sp.isprime(ell):ell+=order
        generator=int(sp.primitive_root(ell));q=pow(generator,(ell-1)//order,ell)
        assert pow(q,order,ell)==1 and pow(q,order//p,ell)!=1
        maxn=p**r+p-2;P=[sp.Poly(1,X,modulus=ell),sp.Poly(X,X,modulus=ell)]
        for n in range(1,maxn):P.append(sp.Poly(X*P[-1].as_expr()-(1-pow(q,n,ell))*P[-2].as_expr(),X,modulus=ell))
        degrees=[]
        for d in range(1,p,2):
            n=p**r+d;assert sp.gcd(P[n],P[n].diff()).degree()==0,(p,r,s,ell,n)
            degrees.append(n)
        rows.append(dict(p=p,r=r,s=s,order=order,reduction_prime=ell,q=q,degrees=degrees,ordinary_gcd_degree=0))
    return rows

if __name__=='__main__':
    result={}
    for key,fn in [('integer',integer_checks),('rational',rational_checks),('hermite',hermite_checks),('modular',modular_certificates)]:
        start=time.monotonic();result[key]=fn();print(key,'PASS',round(time.monotonic()-start,3),flush=True)
        (OUT/'EXACT_CHECKS.json').write_text(json.dumps(result,indent=2)+'\n')
    result['actual_field']=[]
    for args in ((3,2,3,range(3)),(3,3,4,range(3)),(3,4,5,range(9)),(5,2,3,range(5)),(5,3,4,(0,1,4))):
        row=field_case(*args);result['actual_field'].append(row);print('actual-field',args[:3],'PASS',row['seconds'],flush=True)
        (OUT/'EXACT_CHECKS.json').write_text(json.dumps(result,indent=2)+'\n')
    print('ALL EXACT CONTROLS PASS',flush=True)
