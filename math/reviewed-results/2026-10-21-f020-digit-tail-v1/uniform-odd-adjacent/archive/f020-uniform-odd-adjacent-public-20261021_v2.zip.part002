"""Cold-capable exact replay, isolated from frozen evidence and using no network."""
import hashlib,json,os,shutil,subprocess,sys,tempfile
from pathlib import Path
sys.dont_write_bytecode=True
from verify_package import verify,strict_equal,desc
ROOT=Path(__file__).resolve().parent
def replay():
 import sympy
 if not __debug__ or sympy.__version__!='1.14.0':raise RuntimeError('Assertions and SymPy 1.14.0 required')
 before=verify(ROOT);config=json.loads((ROOT/'REPLAY_CASES.json').read_text());results=[]
 expected={c['output']:(ROOT/c['output']).read_bytes() for c in config['cases']}
 with tempfile.TemporaryDirectory(prefix='leading-comparison-replay-') as tmp:
  work=Path(tmp)/'packet';shutil.copytree(ROOT,work);env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
  for c in config['cases']:
   script=c.get('adapter',c['script'])
   p=subprocess.run([sys.executable,str(work/script)],cwd=tmp,env=env,text=True,capture_output=True,timeout=1800)
   if p.returncode!=0:raise RuntimeError('Control failed: '+c['script']+' '+(p.stderr or p.stdout).replace(str(work),'<replay-root>')[-3000:])
   got=(work/c['output']).read_bytes();want=expected[c['output']]
   if not strict_equal(json.loads(got),json.loads(want)):raise RuntimeError('Type-strict exact output mismatch: '+c['output'])
   if got!=want:raise RuntimeError('Output bytes differ: '+c['output'])
   results.append({'script':c['script'],'execution':c['execution'],'adapter':c.get('adapter'),'output':c['output'],'output_sha256':hashlib.sha256(got).hexdigest(),'counts':json.loads(got)['counts'],'type_strict_all_fields_match':True,'byte_identical':True})
  verify(work)
 after=verify(ROOT)
 if before!=after:raise RuntimeError('Frozen package changed')
 return {'status':'PASS','python':sys.version.split()[0],'sympy':sympy.__version__,'network_used':False,'frozen_package_unchanged':True,'full_scripts_executed':1,'exact_independent_mathematical_suffixes_executed':1,'independent_historical_integrity_preamble':'replaced in memory by verified public/source-ledger metadata as disclosed','ignored_json_fields':[],'results':results,'new_mathematical_audit':False,'retained_theorem_controls_freshly_executed':False}
if __name__=='__main__':
 try:print(json.dumps(replay(),indent=2))
 except Exception as e:print(json.dumps({'status':'FAIL','reason':str(e)}));raise SystemExit(1)
