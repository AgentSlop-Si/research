HEX=re.compile('[0-9a-f]{64}\\Z')
def need(ok,msg):
 if not ok:raise ValueError(msg)
def sha(b):return hashlib.sha256(b).hexdigest()
def ident(b):return {'bytes':len(b),'sha256':sha(b)}
def pairs(items):
 d={}
 for k,v in items:need(k not in d,'duplicate JSON key');d[k]=v
 return d
def loads(b):return json.loads(b,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in ()).throw(ValueError('nonfinite JSON')))
def read(p):return loads(p.read_bytes())
def exact(a,b):
 if type(a)is not type(b):return False
 if type(a)is dict:return a.keys()==b.keys() and all(exact(a[k],b[k]) for k in a)
 if type(a)is list:return len(a)==len(b) and all(exact(x,y) for x,y in zip(a,b))
 return a==b
def same(a,b,msg):need(exact(a,b),msg)
def keys(d,k):need(type(d)is dict and d.keys()==set(k),'object fields')
def identity(d):
 keys(d,('bytes','sha256'));need(type(d['bytes'])is int and d['bytes']>=0,'length type');need(type(d['sha256'])is str and HEX.fullmatch(d['sha256'])is not None,'digest format')
def route(s):
 need(type(s)is str and bool(s) and '\\' not in s and not any(ord(c)<32 or ord(c)==127 for c in s),'path spelling')
 p=PurePosixPath(s);need(not p.is_absolute() and str(p)==s and not any(t in ('.','..','') for t in p.parts) and ':' not in s,'unsafe path')
 need('__pycache__' not in p.parts and p.suffix not in ('.pyc','.pyo'),'bytecode forbidden');return s
def inventory(root):
 need(root.is_dir() and not root.is_symlink(),'root type');files=set();fold=set()
 for p in root.rglob('*'):
  need(not p.is_symlink(),'symlink forbidden');rel=route(p.relative_to(root).as_posix());need(rel.casefold() not in fold,'case collision');fold.add(rel.casefold())
  if p.is_file():files.add(rel)
  else:need(p.is_dir(),'nonregular member')
 return files
def text_variants(text):
 seen=set();queue=[text]
 while queue:
  s=queue.pop()
  if s in seen:continue
  seen.add(s);yield s
  need(len(seen)<100000,'escaped-text budget')
  for t in (html.unescape(s),urllib.parse.unquote(s),s.replace('\\/','/'),re.sub(r'\\(?:u([0-9a-fA-F]{4})|x([0-9a-fA-F]{2}))',lambda m:chr(int(m[1] or m[2],16)),s)):
   if t not in seen:queue.append(t)
  if s.lstrip().startswith(('{','[','"')):
   try:v=loads(s)
   except (ValueError,TypeError):pass
   else:
    def strings(v):
     if type(v)is str:yield v
     elif type(v)is list:
      for x in v:yield from strings(x)
     elif type(v)is dict:
      for k,x in v.items():yield k;yield from strings(x)
    queue.extend(t for t in strings(v) if t not in seen)
  for token in re.findall(r'(?<![A-Za-z0-9+/_-])[A-Za-z0-9+/_-]{24,}={0,2}(?![A-Za-z0-9+/_-])',s):
   try:t=base64.b64decode(token+'='*((-len(token))%4),altchars=b'-_',validate=True).decode('utf8')
   except (ValueError,UnicodeError):continue
   if t not in seen and all(c.isprintable() or c in '\r\n\t' for c in t):queue.append(t)
def privacy(name,raw,depth=0):
 need(depth<=4,'recursive archive depth')
 if name.endswith('.zip') or raw[:4]==b'PK\x03\x04':
  members=zip_members(raw)
  for n,b in members.items():privacy(n,b,depth+1)
  return
 try:text=raw.decode('utf8')
 except UnicodeError:raise ValueError('unclassified binary member: '+name)
 if name.endswith('.json'):loads(text)
 tokens=['/'+p+'/' for p in ('work'+'space','home','root','tmp','users','mnt','media')]+['cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','delivery'+'_context','thread'+'_id','lib'+'file_','codex'+':','chatgpt'+'.com']
 for s in itertools.chain(text_variants(name),text_variants(text)):
  local_scan=s.lower().replace('https://users.math.msu.edu'+'/'+'users'+'/bsagan/', 'verified-public-citation/')
  need(not any(t in local_scan for t in tokens),'private locator or coordination text: '+name)
  need(re.search(r'[A-Za-z]:[\\/](?:Users|Documents)[\\/]',s,re.I)is None,'private drive locator')
  need(re.search('-----BEGIN '+r'(?:RSA |EC |OPENSSH )?PRIVATE KEY-----',s)is None,'key marker')
  need(re.search(r'(?:gh[pousr]_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{32,})',s)is None,'credential marker')
  extra=['file'+':'+ '//','sandbox'+':'+ '//','sediment'+':'+ '//','functions'+'.exec','cloud'+'_browser_handoff','library'+'_file_id','/'+'var'+'/folders/']
  need(not any(t.lower() in s.lower() for t in extra),'private scheme or coordination marker')
  need(re.search(r'Bearer\s+[A-Za-z0-9._-]{20,}',s,re.I)is None,'bearer marker')
  need(re.search(r'\b(?:password|api_key|client_secret|access_token|refresh_token)\s*[=:]\s*[\"\'][^\"\']{12,}',s,re.I)is None,'credential assignment')
def envelope(raw):
 need(len(raw)>=22 and raw[-22:-18]==b'PK\x05\x06','exact terminal EOCD required')
 sig,disk,cdisk,n1,n2,cdsize,cdoff,comment=struct.unpack('<4s4H2IH',raw[-22:]);need(disk==cdisk==comment==0 and n1==n2 and n2<=3000,'single disk non-ZIP64 envelope');need(cdoff+cdsize==len(raw)-22,'central directory envelope')
 with zipfile.ZipFile(io.BytesIO(raw)) as z:
  infos=z.infolist();need(len(infos)==n2,'EOCD entry count');pos=0;central=cdoff
  for i in infos:
   need(i.header_offset==pos and pos+30<=cdoff,'local span contiguity')
   h=struct.unpack('<4s5H3I2H',raw[pos:pos+30]);sig,version,flags,method,tm,dt,crc,cs,us,ns,xs=h
   need(sig==b'PK\x03\x04' and version<=20 and flags&~0x800==0 and method in (0,8),'local header profile');need(flags==i.flag_bits and method==i.compress_type and crc==i.CRC and cs==i.compress_size and us==i.file_size and xs==0,'local header consistency')
   name=raw[pos+30:pos+30+ns];need(name.decode('utf8' if flags&0x800 else 'cp437')==i.orig_filename,'local name consistency');start=pos+30+ns+xs;end=start+cs;need(end<=cdoff,'local data span');comp=raw[start:end]
   if method==8:
    d=zlib.decompressobj(-15);data=d.decompress(comp,64*1024**2+1);need(d.eof and not d.unused_data and not d.unconsumed_tail,'exact deflate stream envelope');data+=d.flush()
   else:data=comp
   need(len(data)==us and zlib.crc32(data)&0xffffffff==crc,'local data length/CRC')
   need(central+46<=len(raw)-22 and raw[central:central+4]==b'PK\x01\x02','central record span');ch=struct.unpack('<4s6H3I5H2I',raw[central:central+46]);need(ch[3]==flags and ch[4]==method and ch[7]==crc and ch[8]==cs and ch[9]==us and ch[10]==ns and ch[11]==ch[12]==ch[13]==0 and ch[16]==pos,'central/local consistency');need(raw[central+46:central+46+ns]==name,'central name identity');central+=46+ns;pos=end
  need(pos==cdoff and central==len(raw)-22,'no ZIP prefix, suffix, gap or hidden record')

def zip_members(raw):
 envelope(raw)
 out={};fold=set()
 with zipfile.ZipFile(io.BytesIO(raw)) as z:
  need(not z.comment,'archive comment forbidden');infos=z.infolist();need(len(infos)<=3000 and sum(i.file_size for i in infos)<=64*1024**2,'archive budget')
  for i in infos:
   need(i.orig_filename==i.filename and not i.comment and not i.extra,'hidden member metadata');n=route(i.filename);need(not i.is_dir() and not i.flag_bits&1,'directory/encrypted archive entry');need(n not in out and n.casefold() not in fold,'duplicate/case archive entry')
   need(stat.S_IFMT(i.external_attr>>16) in (0,stat.S_IFREG),'archive member type');fold.add(n.casefold());out[n]=z.read(i)
  for n in out:need(not any('/'.join(n.split('/')[:j]).casefold() in fold for j in range(1,len(n.split('/')))),'archive file/directory conflict')
  need(z.testzip() is None,'CRC failure')
 return out
def extract(raw,dest):
 need(not dest.exists() and not dest.is_symlink(),'extraction destination exists');members=canonical_members(raw)
 for n,b in members.items():privacy(n,b)
 dest.mkdir(parents=True)
 try:
  for n,b in members.items():
   p=dest/n;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
 except Exception:shutil.rmtree(dest);raise
 return len(members)
def canonical_zip(members):
 b=io.BytesIO()
 with zipfile.ZipFile(b,'w',compression=zipfile.ZIP_STORED) as z:
  for n,data in sorted(members.items()):
   route(n);i=zipfile.ZipInfo(n,(1980,1,1,0,0,0));i.create_system=3;i.external_attr=0o100644<<16;i.compress_type=zipfile.ZIP_STORED;z.writestr(i,data)
 return b.getvalue()
def canonical_members(raw):
 members=zip_members(raw);need(raw==canonical_zip(members),'noncanonical archive bytes');need({n.split('/')[0] for n in members}=={PACKAGE},'archive package root');return members

def source_check(root):
 inv=read(root/'provenance/SOURCE_INVENTORY.json');same(inv['source_manifest_sha256'],SOURCES,'frozen source identities')
