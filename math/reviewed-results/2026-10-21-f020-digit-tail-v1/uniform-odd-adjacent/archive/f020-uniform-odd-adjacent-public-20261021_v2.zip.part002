"""Replay the enumerated exact mathematical controls in isolated temporary copies."""
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed
import argparse,hashlib,json,os,shutil,subprocess,sys,tempfile,time
ROOT=Path(__file__).resolve().parent
IGNORED={'seconds','elapsed_seconds','total_seconds'}
def without_timing(value):
 if isinstance(value,dict):return {k:without_timing(v) for k,v in value.items() if k not in IGNORED}
 if isinstance(value,list):return [without_timing(v) for v in value]
 return value
def compare_exact(fresh,frozen,label):
 if json.dumps(without_timing(fresh),sort_keys=True,separators=(',',':'),allow_nan=False)!=json.dumps(without_timing(frozen),sort_keys=True,separators=(',',':'),allow_nan=False):raise ValueError('Mathematical output mismatch: '+label)
def inventory():return {p.relative_to(ROOT).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in ROOT.rglob('*') if p.is_file()}
def main():
 if not __debug__:raise SystemExit('Run with assertions enabled, without Python optimization.')
 parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--jobs',type=int,default=1,choices=range(1,20));args=parser.parse_args()
 subprocess.run([sys.executable,str(ROOT/'verify_package.py')],check=True,stdout=subprocess.DEVNULL)
 config=json.loads((ROOT/'REPLAY_CASES.json').read_text());before=inventory();started=time.monotonic();completed={}
 with tempfile.TemporaryDirectory(prefix='leading-two-replay-') as temp:
  def run(index,case):
   print('Running '+case['script'],file=sys.stderr,flush=True)
   work=Path(temp)/str(index);work.mkdir();target=work/Path(case['script']).name;shutil.copyfile(ROOT/case['script'],target)
   for item in case.get('support_files',[]):shutil.copyfile(ROOT/item['source'],work/item['target'])
   for item in case.get('inputs',[]):
    source_index=next(i for i,c in enumerate(config['cases']) if c['script']==item['from_script'])
    shutil.copyfile(Path(temp)/str(source_index)/item['generated_output'],work/item['generated_output'])
   env=os.environ.copy();env['OPENBLAS_NUM_THREADS']='1';env['OMP_NUM_THREADS']='1';env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
   child=subprocess.run([sys.executable,str(target),*case.get('args',[])],cwd=work,env=env,text=True,capture_output=True,timeout=3600)
   if child.returncode or child.stderr:raise RuntimeError({'checker':case['script'],'returncode':child.returncode,'stdout':child.stdout,'stderr':child.stderr})
   if case.get('output_kind','json')=='stdout':
    if child.stdout!=(ROOT/case['expected_output']).read_text():raise ValueError('Exact stdout mismatch: '+case['script'])
   else:
    fresh=json.loads((work/case['generated_output']).read_text());frozen=json.loads((ROOT/case['expected_output']).read_text());compare_exact(fresh,frozen,case['script'])
    for additional in case.get('additional_expected_outputs',[]):compare_exact(fresh,json.loads((ROOT/additional).read_text()),additional)
   print('PASS '+case['script'],file=sys.stderr,flush=True)
   return {'checker':case['script'],'expected_output':case['expected_output'],'group':case['group'],'all_mathematical_fields_match':True,'output_kind':case.get('output_kind','json')}
  pending=set(range(len(config['cases'])))
  while pending:
   ready=[i for i in sorted(pending) if all(any(j in completed and c['script']==v['from_script'] for j,c in enumerate(config['cases'])) for v in config['cases'][i].get('inputs',[]))]
   if not ready:raise ValueError('Cyclic replay dependencies')
   with ThreadPoolExecutor(max_workers=args.jobs) as executor:
    futures={executor.submit(run,index,config['cases'][index]):index for index in ready}
    for f in as_completed(futures):completed[futures[f]]=f.result();pending.remove(futures[f])
 if inventory()!=before:raise ValueError('Frozen package changed during replay')
 subprocess.run([sys.executable,str(ROOT/'verify_package.py')],check=True,stdout=subprocess.DEVNULL)
 return {'status':'PASS','exact_program_count':len(completed),'current_program_count':sum(c['group']=='current' for c in config['cases']),'historical_program_count':sum(c['group']=='prior' for c in config['cases']),'results':[completed[i] for i in sorted(completed)],'ignored_nondeterministic_keys':sorted(IGNORED),'elapsed_seconds':round(time.monotonic()-started,3),'frozen_package_unchanged':True,'older_prerequisite_execution_bundles_replayed':False,'network_used':False}
if __name__=='__main__':print(json.dumps(main(),indent=2))
