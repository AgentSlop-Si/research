  n=route(row['stored_path']);key=(row['collection'],route(row['source_path']));need(n not in by and key not in originals,'source duplicate');by[n]=row;originals[key]=row['original'];identity(row['original']);identity(row['exported']);same(ident((root/n).read_bytes()),row['exported'],'source export identity');same(row['original'],row['exported'],'verbatim source bytes');same(row['changes'],[],'no source changes');need(row['mode']=='verbatim','only unchanged sources')
