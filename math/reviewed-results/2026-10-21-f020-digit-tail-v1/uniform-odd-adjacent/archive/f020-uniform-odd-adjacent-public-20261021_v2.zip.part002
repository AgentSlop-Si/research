PK␀␀␀␀␀␀␀!␀é¤xk™␀␀™␀␀`␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/author/sources/accepted-c3-author/check_controls.py#!/usr/bin/env python3
"""Fresh bounded controls. No archived program is imported or executed."""
import json, math
from fractions import Fraction as Q
from pathlib import Path
import numpy as np
import sympy as S

def require(x,msg):
    if not x: raise RuntimeError(msg)

def vp(n,p):
    if n==0:return 10**9
    a=0
    while n%p==0:n//=p;a+=1
    return a

def field_case(p,r,s):
    N=p**r;n=3*N+1;e=(p-1)*p**(s-1);block=p**(s-1);order=p**s
    B=r*(p-1)*p**(r-1)//2;K=Q(3*N,2)+3*B;E=N+3*B;D=2*N+3*B-p
    h=r//2;L=N//p**h;rho=Q(p**h,2) if r%2==0 else Q(p**(h-1)*(2*p-1),2)
    modulus=p**3
    require(3*e>N+E+2*rho,'Insufficient precision')
    prev=np.zeros((n+1,e),dtype=np.int64);prev[0,0]=1
    cur=np.zeros_like(prev);cur[1,0]=1;saved={}
    for j in range(1,n):
        padded=np.zeros((n+1,order),dtype=np.int64);padded[:,:e]=prev
        rot=np.roll(padded,j,axis=1);high=rot[:,e:order]
        shifted=rot[:,:e].copy()
        for a in range(p-1):shifted[:,a*block:(a+1)*block]-=high
        nxt=(-prev+shifted)%modulus;nxt[1:]+=cur[:-1];nxt%=modulus
        prev,cur=cur,nxt
        if j+1 in (n-2,n-1,n):saved[j+1]=cur.copy()
    pascal=np.zeros((e,e),dtype=np.int64)
    for j in range(e):
        for k in range(j+1):pascal[j,k]=math.comb(j,k)%modulus
    translated={k:(v@pascal)%modulus for k,v in saved.items()}
    def deriv(a):
        out=np.zeros_like(a)
        for j in range(1,n+1):out[j-1]=j*a[j]%modulus
        return out
    def shift(a,d):
        out=np.zeros_like(a);out[d:]=a[:-d];return out
    def multiply_edge(a):
        # q-basis arithmetic for a_(3N), followed by exact Pascal substitution.
        padded=np.zeros((n+1,order),dtype=np.int64);padded[:,:e]=a
        rot=np.roll(padded,3*N,axis=1);high=rot[:,e:order]
        z=rot[:,:e].copy()
        for u in range(p-1):z[:,u*block:(u+1)*block]-=high
        return ((a-z)%modulus)@pascal%modulus
    A=translated[n-1];M=translated[n-2];F=translated[n]
    Ap=deriv(A);Mp=deriv(M);Fp=deriv(F)
    # J=X F'-F is a polynomial, unlike root-only F'/normalizer residual claims.
    J=(shift(Fp,1)-F)%modulus
    require(np.array_equal(J,(shift(Ap,2)+multiply_edge(saved[n-2])-shift(multiply_edge(deriv(saved[n-2])),1))%modulus),'J identity')
    def coeff_value(row):
        vals=[(i+e*vp(int(x),p),i,int(x)) for i,x in enumerate(row) if x]
        if not vals:return None
        value,i,x=min(vals);v=vp(x,p);return value,(x//p**v*(-1)**v)%p
    def initial(a):
        vals=[(Q(v[0])+j*rho,j,v[1]) for j,row in enumerate(a) if (v:=coeff_value(row)) is not None]
        low=min(x[0] for x in vals)
        return low,{j:u for w,j,u in vals if w==low}
    av,ai=initial(A);mv,mi=initial(M);dv,di=initial(Ap);mpv,mpi=initial(Mp);fv,fi=initial(F);jv,ji=initial(J)
    require(av==K and set(ai)=={L,3*L} and (ai[L]*mi[2*L]-3*ai[3*L]*mi[0])%p==0,'A residual')
    require(mv==E and set(mi)=={0,2*L} and mi[0]!=0 and mi[2*L]!=0,'M residual')
    require(dv==D and set(di)=={0,2*L} and (di[0]*mi[2*L]-di[2*L]*mi[0])%p==0,'A derivative residual')
    require(mpv>=E,'M derivative bound')
    require(fv==K+rho and set(fi)=={L+1,3*L+1} and (fi[L+1]*ai[3*L]-fi[3*L+1]*ai[L])%p==0,'F residual and low multiplicity')
    const=coeff_value(F[0]);require(const[0]==N+E,'Constant valuation')
    if r==2:
        require(di[0]==(-3*mi[0])%p,'Actual A derivative to M unit ratio')
        expected={0:(-3*mi[0])%p,2:(-3*mi[0])%p,2*p:(-3*mi[0])%p,2*p+2:(-3*mi[0])%p}
        require(jv==N+E and ji==expected,'Central J actual units')
    else:
        require(jv==N+E and set(ji)=={0,2*L} and (ji[0]*mi[2*L]-ji[2*L]*mi[0])%p==0,'Central separated J')
    return {'parameters':[p,r,s],'ring':f'(Z/{modulus})[q]/Phi_{order}(q)','ramification':e,'precision_value':3*e,'weights':{k:str(v) for k,v in [('A',av),('M',mv),('A_prime',dv),('M_prime',mpv),('F',fv),('J',jv)]},'initials':{'A':ai,'M':mi,'A_prime':di,'F':fi,'J':ji},'F_constant_value':const[0],'interior_residual_multiplicity':L+1,'status':'PASS'}

def symbolic():
    X,q=S.symbols('X q');P=[S.Integer(1),X]
    for j in range(1,8):P.append(S.expand(X*P[j]-(1-q**j)*P[j-1]))
    rows=[]
    for b in (3,5,7):
        F=P[b+1];A=P[b];M=P[b-1];a=1-q**b
        require(S.expand(X*S.diff(F,X)-F-X**2*S.diff(A,X)-a*M+a*X*S.diff(M,X))==0,'symbolic J')
        require(S.expand(F.subs(X,0)-(-1)**((b+1)//2)*S.prod(1-q**j for j in range(1,b+1,2)))==0,'constant product')
        rows.append(b+1)
    Z=S.symbols('Z');M3=Z**3+3*Z;M2=Z**2+1
    require(S.resultant(M3,M2,Z)==4,'Hermite resultant')
    require(S.rem(Z**2+1,Z**2+3,Z)==-2,'boundary noncancellation')
    return {'original_recurrence_target_degrees':rows,'hermite_resultant':4,'central_remainder':-2,'status':'PASS'}

def floor_controls():
    rows=[]
    for p,r in [(5,2),(5,3),(7,2)]:
        N=p**r;B=r*(p-1)*p**(r-1)//2;E=N+3*B;h=r//2
        rho=Q(p**h,2) if r%2==0 else Q(p**(h-1)*(2*p-1),2)
        W=[0];T=[Q(0)]
        for j in range(1,3*N+1):W.append(W[-1]+p**vp(j,p));T.append(T[-1]+min(p**vp(j,p),rho))
        R=[Q(w)-t for w,t in zip(W,T)];b=3*N-1
        require([k for k in range(0,b+1,2) if W[b]-W[(b-k)//2]-R[k]==E]==[0,2*N],'neighbor equality terms')
        maxscore=max(Q(W[(b-k)//2])+R[m]+p**vp(k-m,p) for k in range(2,b+1,2) for m in range(k))
        require(maxscore<=E,'neighbor all ordinary derivative terms')
        rows.append({'p':p,'r':r,'neighbor_equality_k':[0,2*N],'derivative_max_bracket':str(maxscore),'E':E})
    return rows

def main():
    result={'status':'PASS','source_programs_executed':False,'controls_only_not_family_proof':True,'symbolic':symbolic(),'neighbor_floor_controls':floor_controls(),'actual_original_recurrence':[field_case(5,2,3),field_case(5,3,4)]}
    print(json.dumps(result,indent=2,sort_keys=True))
if __name__=='__main__':main()
