  require((root/group/'SEAL.sha256').read_text().split()==[digest,'MANIFEST.json'],'Original seal mismatch')
  require({r['source_path'] for r in rows}=={r['path'] for r in src['files']}|{'MANIFEST.json','SEAL.sha256'},'Source files omitted or inserted')
  for r in src['files']:require(originals[group+'/'+r['path']]=={k:r[k] for k in ['bytes','sha256']},'Source entry mismatch')
