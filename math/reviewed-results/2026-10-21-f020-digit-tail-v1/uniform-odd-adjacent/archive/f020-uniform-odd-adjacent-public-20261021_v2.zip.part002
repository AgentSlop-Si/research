PK␀␀␀␀␀␀␀!␀«ÏÂ/}+␀␀}+␀␀E␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/author/check_controls.py#!/usr/bin/env python3
"""Fresh bounded falsification controls. No source program is imported/executed."""
import argparse, hashlib, json, math
from fractions import Fraction
from pathlib import Path
import numpy as np
ROOT=Path(__file__).resolve().parent

def require(test, message):
    if not test: raise RuntimeError(message)

def vp(a,p):
    if not a: return 10**12
    n=0
    while a%p==0:a//=p;n+=1
    return n

def hermite(c):
    out={}
    for u in range(c//2+1):
        out[c-2*u]=math.factorial(c)//(2**u*math.factorial(u)*math.factorial(c-2*u))
    return out

def obstruction(c):
    co={j//2:a for j,a in hermite(c).items()}
    b=sum(a*(-1)**j for j,a in co.items())
    derivative=sum(j*a*(-1)**(j-1) for j,a in co.items() if j)
    return b,derivative

def all_terms(p,c,r):
    N=p**r;B=r*(p-1)*p**(r-1)//2;n=c*N
    h=r//2;rho2=p**h if r%2==0 else p**(h-1)*(2*p-1)
    E2=(c-1)*N+2*c*B;D2=(c+1)*N+2*c*B-2*p
    edges=[0]+[p**vp(j,p) for j in range(1,n+1)]
    w=[0];t2=[0]
    for j in range(1,n+1):w.append(w[-1]+edges[j]);t2.append(t2[-1]+min(2*edges[j],rho2))
    rr2=[2*x-y for x,y in zip(w,t2)]
    require([m for m in range(n+1) if 2*w[m]-2*t2[m]==0]==list(range(0,n+1,N)), 'half-W equality set')
    pivots=[];derivative_min=10**12;count=0
    for k in range(0,n,2):
        val2=2*w[n-1]-2*w[(n-1-k)//2]-rr2[k]
        require(val2>=E2,'neighbor polynomial bound')
        if val2==E2:pivots.append(k)
        if k:
            for m in range(k):
                v2=2*w[n-1]-2*w[(n-1-k)//2]-rr2[m]-2*edges[k-m]
                derivative_min=min(derivative_min,v2);count+=1
                require(v2>=E2,'whole neighbor derivative bound')
    require(pivots==list(range(0,n,2*N)),'even-neighbor exact pivots')
    # Full central slack, independent of the generic Gauss lower bound.
    central={}
    if r==2:
        actual_t2=[2*m+(p-2)*((m+p-1)//p) for m in range(n+1)]
        for m in range(n+1):
            _,v=divmod(m,N);aa,bb=divmod(v,p)
            require(actual_t2[m]-w[m]==aa*(p-1)+bb+(p-2)*(bb>0),'central Delta identity')
        for kind,b0,base in [('H',n,c*(N+2*B)),('M',n-1,E2)]:
            gaps=[];pi=[]
            for k in range(b0%2,b0+1,2):
                v2=2*w[b0]-2*w[(b0-k)//2]-2*w[k]+actual_t2[k]
                if k%N==0:require(v2==base,'central polynomial pivot');pi.append(k)
                else:gaps.append(v2-base);require(v2-base>=(B+p-1 if kind=='H' else p-1),'central nonpivot')
            central[kind]={'pivots':pi,'min_nonpivot_gap_twice':min(gaps)}
        gaps=[];pi=[];dc=0
        for k in range(1,n+1,2):
            for m in range(k):
                j=k-m;v2=2*w[n]-2*w[(n-k)//2]-2*w[m]+actual_t2[m]-2*edges[j]
                pivot=(j==N and m%N==0 and (m//N)%2==0)
                if pivot:require(v2==D2,'central derivative pivot');pi.append([k,m])
                else:gaps.append(v2-D2);require(v2-D2>=p-1,'central derivative nonpivot gap')
                dc+=1
        central['Hprime']={'pivots':pi,'min_nonpivot_gap_twice':min(gaps),'terms':dc}
    return {'p':p,'c':c,'r':r,'neighbor_pivots':pivots,'neighbor_derivative_terms':count,'neighbor_derivative_min_twice':derivative_min,'E_twice':E2,'central':central}

def original_field(p=7,c=5):
    N=p*p;n=c*N+1;e=(p-1)*N;order=p*N;mod=p**3;B=p*(p-1)
    K=Fraction(c*N,2)+c*B;E=(c-1)*N//2+c*B;D=N+E-p;rho=Fraction(p,2);S=K+rho;d=B//2
    require(3*e>N+E+2,'field precision')
    def qshift(a,j):
        padded=np.zeros((n+1,order),dtype=np.int64);padded[:,:e]=a
        z=np.roll(padded,j%order,axis=1);high=z[:,e:];low=z[:,:e].copy()
        for k in range(p-1):low[:,k*N:(k+1)*N]-=high
        return low%mod
    prev=np.zeros((n+1,e),dtype=np.int64);prev[0,0]=1
    cur=np.zeros_like(prev);cur[1,0]=1;states={}
    for j in range(1,n):
        nxt=(qshift(prev,j)-prev)%mod;nxt[1:]=(nxt[1:]+cur[:-1])%mod
        prev,cur=cur,nxt
        if j+1 in [n-2,n-1,n]:states[j+1]=cur.copy()
    transform=np.zeros((e,e),dtype=np.int64)
    for j in range(e):
        for k in range(j+1):transform[j,k]=math.comb(j,k)%mod
    arrays={k:v@transform%mod for k,v in states.items()}
    def qderiv(a):
        out=np.zeros_like(a)
        for j in range(1,n+1):out[j-1]=j*a[j]%mod
        return out
    def xshift(a,step):
        out=np.zeros_like(a);out[step:]=a[:-step];return out
    mq=states[n-2];aq=states[n-1];fq=states[n]
    edge_m=(mq-qshift(mq,c*N))%mod
    edge_mp=(qderiv(mq)-qshift(qderiv(mq),c*N))%mod
    jq=np.array([(j-1)*fq[j]%mod for j in range(n+1)])
    require(np.array_equal(jq,(xshift(qderiv(aq),2)+edge_m-xshift(edge_mp,1))%mod),'exact original cyclotomic J identity')
    def derivative(a):
        out=np.zeros_like(a)
        for j in range(1,n+1):out[j-1]=j*a[j]%mod
        return out
    def cv(row):
        candidates=[(j+e*vp(int(a),p),j,int(a)) for j,a in enumerate(row) if a]
        if not candidates:return None
        value,j,a=min(candidates);v=vp(a,p)
        return value,(a//p**v*(-1)**v)%p
    def ini(a):
        values=[(Fraction(z[0])+j*rho,j,z[1]) for j,row in enumerate(a) if (z:=cv(row)) is not None]
        val=min(x[0] for x in values)
        return val,{j:u for w,j,u in values if w==val}
    A=arrays[n-1];M=arrays[n-2];F=arrays[n];Ap=derivative(A);Mp=derivative(M)
    J=np.array([(j-1)*F[j]%mod for j in range(n+1)])
    eps=(-1)**((p-1)//2)
    expected_A={j*p:(-eps*a)%p for j,a in hermite(c).items() if a%p}
    expected_M={j*p:(-a)%p for j,a in hermite(c-1).items() if a%p}
    expected_Ap={j*p:(c*a)%p for j,a in hermite(c-1).items() if (c*a)%p}
    expected_F={j+1:u for j,u in expected_A.items()}
    expected_J={}
    for j,a in hermite(c-1).items():
        for shift in [0,2]:expected_J[j*p+shift]=(expected_J.get(j*p+shift,0)+c*a)%p
    expected_J={j:a for j,a in expected_J.items() if a}
    got={name:ini(poly) for name,poly in [('A',A),('M',M),('A_prime',Ap),('M_prime',Mp),('F',F),('J',J)]}
    for name,value,expected in [('A',K,expected_A),('M',E,expected_M),('A_prime',D,expected_Ap),('F',S,expected_F),('J',N+E,expected_J)]:
        require(got[name]==(value,expected),'actual original field '+name)
    require(got['M_prime'][0]>=E,'original Mprime')
    require(cv(F[0])[0]==N+E,'actual constant')
    m1=(p+1)//2
    coeffs={j:cv(F[2*j])[0]+p*j-S for j in range(m1+1)}
    require(coeffs[0]==d and coeffs[m1]==0 and all(coeffs[j]>=d for j in range(m1)),'central interior polygon')
    return {'parameters':[p,c,2,3],'ring':f'(Z/{mod})[q]/Phi_{order}','precision':3*e,'weights':{name:str(x[0]) for name,x in got.items()},'initials':{name:x[1] for name,x in got.items()},'central_interior_coefficients':{str(j):str(v) for j,v in coeffs.items()},'depth':str(Fraction(N,p+1))}

def exceptional_original_jet(p=13,c=11):
    N=p*p;B=p*(p-1);d=B//2;S=(c*(N+2*B)+p)//2;m=(c*N+1)//2
    limit=S+d+2;modbase=1
    while modbase<=limit*(p-1)**2:modbase*=256
    width=(modbase.bit_length()-1)//8
    mask=(1<<(8*width*limit))-1
    def trim(a):return a[:limit]
    def plus(a,b):
        out=[0]*min(limit,max(len(a),len(b)))
        for j in range(len(out)):out[j]=((a[j] if j<len(a) else 0)+(b[j] if j<len(b) else 0))%p
        return out
    def shift(a,neg=False):return [0]*p+[(p-x)%p if neg else x for x in a[:limit-p]]
    def multiply(a,b):
        length=min(limit,len(a)+len(b)-1)
        packed_a=int.from_bytes(b''.join(int(x).to_bytes(width,'little') for x in a),'little')
        packed_b=int.from_bytes(b''.join(int(x).to_bytes(width,'little') for x in b),'little')
        raw=((packed_a*packed_b)&mask).to_bytes(width*length,'little')
        return [int.from_bytes(raw[j*width:(j+1)*width],'little')%p for j in range(length)]
    even=[1];even_v=[0];odd=[1];odd_v=[0];qpower=[1];digest=hashlib.sha256()
    for k in range(1,m+1):
        qpower=plus(qpower,[0]+qpower);edge=qpower.copy();edge[0]=0
        new_even=plus(multiply(edge,even),shift(odd,True))
        new_even_v=plus(multiply(edge,even_v),plus(shift(odd),shift(odd_v,True)))
        even,even_v=new_even,new_even_v
        if k<m:
            qpower=plus(qpower,[0]+qpower);edge=qpower.copy();edge[0]=0
            odd=plus(even,multiply(edge,odd));odd_v=plus(even_v,multiply(edge,odd_v))
        for arr in [even,even_v]:digest.update(bytes(arr))
    j0=plus([(-x)%p for x in even],[(-2*x)%p for x in even_v])
    nz=[[j,x] for j,x in enumerate(j0) if x]
    nonzero_f=[[j,x] for j,x in enumerate(even) if x]
    bc,rprime=obstruction(c)
    require(bc%p==0 and rprime%p!=0,'genuine exceptional fixture')
    require(not nonzero_f or nonzero_f[0][0]>S+p,'f(-1) deep enough')
    require(nz and nz[0]==[S+d+1,(-rprime*pow(4,-1,p))%p],'original J second layer')
    require((p-1)*N+m>S+d+1,'raw lattice validates actual mixed-characteristic jet')
    return {'p':p,'c':c,'original_degree':c*N+1,'S':S,'d':d,'truncation_exclusive':limit,'first_F_term':nonzero_f[0] if nonzero_f else None,'first_J_term':nz[0],'R_prime_minus_one':rprime,'expected_J_unit':(-rprime*pow(4,-1,p))%p,'state_stream_sha256':digest.hexdigest(),'carry_free_base':modbase,'max_convolution_coefficient':limit*(p-1)**2,'mixed_characteristic_lattice_margin':(p-1)*N+m-S,'original_derivative_used':'J=2U F_U-F, evaluated at U=-1; not F_U off roots'}

def low_arithmetic():
    rows=[]
    for c in [3,5,7,9,11,13,15,17]:
        b,dp=obstruction(c);rows.append({'c':c,'b':b,'R_prime_minus_one':dp})
    require([r['b'] for r in rows[:5]]==[2,6,20,28,-936],'obstruction integers')
    require(obstruction(11)[0]%13==0,'c11p13 real exception')
    # Coefficientwise odd operator: f' of the residual cannot be given weight d.
    p=7;c=5;m=(p+1)//2
    leading={m+j*p:a%p for j,a in ((j//2,a) for j,a in hermite(c).items())}
    require(any(j*a%p for j,a in leading.items()),'negative control: false global f_U bound rejected')
    require(all((2*j-1)*a%p==0 for j,a in leading.items()),'correct odd operator residual')
    factorial=[]
    for p in [5,7,13]:
        aa=(p*p-1)//2;constant=1;linear=0
        for j in range(1,aa+1):
            edge=2*j;v=vp(edge,p);constant=constant*(-(edge//p**v))%p
            if not v:linear=(linear+(edge-1)*pow(2,-1,p))%p
        require(constant==p-1 and linear==(-pow(8,-1,p))%p,'Q first correction')
        factorial.append({'p':p,'Q_unit':constant,'relative_linear':linear})
    return {'obstructions':rows,'Q_first_corrections':factorial,'false_global_odd_f_U_bound':'REJECTED','correct_operator':'2U f_U-f'}

def main():
    parser=argparse.ArgumentParser();parser.add_argument('--write',action='store_true');args=parser.parse_args()
    data={'status':'PASS','finite_controls_not_family_proof':True,'supplied_source_programs_executed':False,'arithmetic':low_arithmetic(),'all_terms':[all_terms(p,c,r) for p,c,r in [(5,3,2),(7,5,2),(13,11,2),(7,5,3)]],'original_cyclotomic_coefficients':original_field(),'original_exceptional_jet':exceptional_original_jet()}
    encoded=json.dumps(data,indent=2,sort_keys=True)+'\n'
    if args.write:(ROOT/'CONTROL_RESULTS.json').write_text(encoded)
    else:require(encoded==(ROOT/'CONTROL_RESULTS.json').read_text(),'frozen results differ')
    print(encoded)
if __name__=='__main__':main()
