PK␀␀␀␀␀␀␀!␀;1ŸÐ(␀␀Ð(␀␀Q␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/independent-review/private/checks.py#!/usr/bin/env python3
"""New reviewer controls. No producer/dependency code is imported or executed."""
from pathlib import Path
from fractions import Fraction
from math import factorial, ceil
import json, time, hashlib
import numpy as np
import sympy as sp

ROOT=Path(__file__).resolve().parent

def require(test, message):
    if not test:
        raise RuntimeError(message)

def ordp(x,p):
    if x==0: return 10**9
    v=0
    while x%p==0: x//=p; v+=1
    return v

def hermites(n):
    Z=sp.Symbol('Z'); H=[sp.Integer(1),Z]
    for k in range(2,n+1): H.append(sp.expand(Z*H[-1]+(k-1)*H[-2]))
    return Z,H

def arithmetic():
    Z,H=hermites(61); U=sp.Symbol('U'); out=[]; b=[1,2]
    for m in range(2,31): b.append(2*(2*m-1)*(b[-1]-(m-1)*b[-2]))
    for m in range(1,31):
        c=2*m+1
        Scoeff={int(d[0])//2:int(v) for d,v in sp.Poly(H[c]/Z,Z).terms()}
        S=sum(v*U**d for d,v in Scoeff.items())
        val=int(S.subs(U,-1))
        require(val==b[m],f'obstruction recurrence c={c}')
        require(ordp(val,2)==(m+1)//2,f'exact 2-adic obstruction c={c}')
        require(int(S.subs(U,0))==factorial(c)//(2**m*factorial(m)),f'odd residual constant c={c}')
        if c<=19:
            factors=sp.factorint(abs(val))
            out.append({'c':c,'obstruction':val,'factorization':{str(k):int(v) for k,v in factors.items()},'allowed_exceptional_primes':[int(k) for k in factors if k>c]})
        if c<=17:
            require(sp.resultant(H[c],H[c-1],Z)==sp.prod(j**j for j in range(1,c)),f'neighbor resultant c={c}')
            primes=set(sp.primerange(c+1,120))|{int(p) for p in sp.factorint(abs(val)) if p>c}
            for p in primes:
                expected=(val%p==0)
                require((sp.degree(sp.gcd(sp.Poly(S,U,modulus=p),sp.Poly(U+1,U,modulus=p)))==1)==expected,'criterion gcd equivalence')
                require(sp.degree(sp.gcd(sp.Poly(H[c],Z,modulus=p),sp.Poly(H[c-1],Z,modulus=p)))==0,'coprime neighboring Hermites')
    # Exact original recurrence, not a residual model.
    X,q=sp.symbols('X q'); P=[sp.Integer(1),X]
    for j in range(1,14): P.append(sp.expand(X*P[-1]-(1-q**j)*P[-2]))
    for n in range(4,15,2):
        F,A,M=P[n],P[n-1],P[n-2]; edge=1-q**(n-1)
        require(sp.expand(X*sp.diff(F,X)-F-X**2*sp.diff(A,X)-edge*M+edge*X*sp.diff(M,X))==0,'exact J identity')
        require(sp.expand(F.subs(X,0)-(-1)**(n//2)*sp.prod(1-q**j for j in range(1,n,2)))==0,'exact constant product')
    return {'obstruction_rows':out,'recurrence_and_nonzero_tested_through_c':61,'original_recurrence_even_degrees':list(range(4,15,2)),'status':'PASS'}

def valuation_combinatorics():
    rows=[]
    for c,p,r in [(3,5,2),(5,7,2),(7,11,2),(9,11,2),(11,13,2),(3,5,3),(5,7,3)]:
        N=p**r; B=r*(p-1)*p**(r-1)//2; E=(c-1)*N//2+c*B; D=(c+1)*N//2+c*B-p; h=r//2
        rho2=p**h if r%2==0 else p**(h-1)*(2*p-1)
        v=np.array([0]+[p**ordp(j,p) for j in range(1,c*N+1)],dtype=np.int64)
        W=np.cumsum(v); T2=np.cumsum(np.minimum(2*v,rho2)); T2[0]=0
        R2=2*W-T2
        require(np.all(R2<=W),'half W cap')
        require(list(np.flatnonzero(R2==W))==list(range(0,c*N+1,N)),'cap exact equality multiples')
        b=c*N-1; eq=[]; dmax=-1; pairs=0
        for k in range(0,b+1,2):
            a=(b-k)//2
            if 2*W[a]+R2[k]==2*E:eq.append(k)
            if k:
                scores=2*W[a]+R2[:k]+2*v[k:0:-1]
                dmax=max(dmax,int(np.max(scores))); pairs+=k
        require(eq==list(range(0,c*N,N*2)),'even neighbor equality indices')
        require(dmax<=2*E,'whole even neighbor derivative bound')
        actual=[]; target=2*(int(W[c*N])-D)
        for k in range(1,c*N+1,2):
            a=(c*N-k)//2; scores=2*W[a]+R2[:k]+2*v[k:0:-1]
            require(int(np.max(scores))<=target,'leading derivative maximum')
            actual.extend((int(m),k) for m in np.flatnonzero(scores==target))
        expected=[(l*N,l*N+p*p) for l in range(0,c,2)]
        require(actual==expected,'leading derivative exact pivot set')
        rows.append({'c':c,'p':p,'r':r,'neighbor_equality_indices':eq,'neighbor_derivative_pairs':pairs,'max_doubled_neighbor_bracket':dmax,'twice_E':2*E,'leading_derivative_pivots':actual})
    return {'rows':rows,'status':'PASS'}

def hull(points):
    hs=[]
    for a in points:
        while len(hs)>1 and (hs[-1][0]-hs[-2][0])*(a[1]-hs[-1][1]) <= (hs[-1][1]-hs[-2][1])*(a[0]-hs[-1][0]): hs.pop()
        hs.append(a)
    return hs

def cyclotomic(c,p,r,s,phase):
    start=time.time(); N=p**r; n=c*N+1; order=p**s; e=order-order//p
    B=r*(p-1)*p**(r-1)//2; K=Fraction(c*N,2)+c*B; E=(c-1)*N//2+c*B; D=(c+1)*N//2+c*B-p
    h=r//2; L=N//p**h; rho=Fraction(p**h,2) if r%2==0 else Fraction(p**(h-1)*(2*p-1),2)
    threshold=N+E; cap=min(n,ceil(Fraction(threshold,rho))+2); precision=ceil(Fraction(threshold+1,e))+1; modulus=p**precision
    require(modulus<2**40,'safe int64 arithmetic range')
    # Independent construction in cyclic q ring. Low-X truncation is closed
    # under the original recurrence, and discarded degrees have j*rho>threshold.
    a=np.zeros((cap+1,order),dtype=np.int64); a[0,0]=1
    b=np.zeros_like(a); b[1,0]=1; snapshots={}
    for j in range(1,n):
        d=-a+np.roll(a,phase*j,axis=1); d[1:]+=b[:-1]; d%=modulus
        a,b=b,d
        if j+1 in (n-2,n-1,n): snapshots[j+1]=b.copy()
    # Phi_(p^s) quotient first, then Pascal substitution with no t truncation.
    def change_basis(data):
        out=data[:,:e].copy(); tail=data[:,e:]
        for block in range(p-1): out[:,block*(order//p):(block+1)*(order//p)]-=tail
        out%=modulus
        t=np.zeros_like(out)
        for power in range(e-1,-1,-1):
            t[:,1:]+=t[:,:-1].copy();t[:,0]+=out[:,power];t%=modulus
        return t
    A,M,F=[change_basis(snapshots[k]) for k in [n-1,n-2,n]]
    def deriv(a):
        out=np.zeros_like(a);out[:-1]=a[1:]*np.arange(1,cap+1)[:,None];return out%modulus
    Ap,Mp=deriv(A),deriv(M)
    J=(F*(np.arange(cap+1)-1)[:,None])%modulus
    def vals(data):
        result=[]
        for row in data:
            nonzero=np.flatnonzero(row)
            if not len(nonzero):result.append(None);continue
            best=None
            for degree in nonzero:
                coef=int(row[degree]); power=ordp(coef,p); valuation=int(degree)+e*power
                if best is None or valuation<best[0]:best=(valuation,int(coef//p**power*(-1)**power)%p)
            result.append(best)
        return result
    def init(data):
        data_vals=vals(data); best=min(Fraction(z[0])+j*rho for j,z in enumerate(data_vals) if z)
        res={j:z[1] for j,z in enumerate(data_vals) if z and Fraction(z[0])+j*rho==best}
        return best,res,data_vals
    blocks={name:init(poly) for name,poly in [('A',A),('M',M),('Ap',Ap),('Mp',Mp),('F',F),('J',J)]}
    for name,expected in [('A',K),('M',E),('Ap',D),('F',K+rho)]: require(blocks[name][0]==expected,f'{name} exact weight')
    require(blocks['Mp'][0]>=E,'full original M derivative weight')
    require(blocks['F'][2][0][0]==threshold,'original constant weight')
    Z,H=hermites(c); aa=blocks['A'][1]; ma=blocks['M'][1]; da=blocks['Ap'][1]; fa=blocks['F'][1]
    require(fa=={j+1:v for j,v in aa.items()},'whole F leading central residual')
    require(set(aa)==set(j*L for (j,),coef in sp.Poly(H[c],Z).terms() if int(coef)%p),'A residual supports')
    require(set(ma)==set(j*L for (j,),coef in sp.Poly(H[c-1],Z).terms() if int(coef)%p),'M residual supports')
    require(all((da[j]*ma[0]-ma[j]*da[0])%p==0 for j in ma),'Ap and M proportional residuals')
    if r==2:
        # q_input=q_base^phase; t=q_base-1. Coordinate sqrt(t^p), not sqrt((q_input-1)^p).
        def predicted(poly):
            deg=int(sp.degree(poly,Z))
            return {int(j)*p:int(coef)*pow(phase,(deg-int(j))//2,p)%p for (j,),coef in sp.Poly(poly,Z).terms() if int(coef)%p}
        for actual,poly in [(aa,H[c]),(ma,H[c-1])]:
            expected=predicted(poly); lead=max(actual); scale=actual[lead]
            require(actual=={j:v*scale%p for j,v in expected.items()},'actual phase-covariant Hermite residual')
        require(da=={j:(-c*v)%p for j,v in ma.items()},'actual original derivative to neighbor ratio')
        jr={}
        for j,v in ma.items():
            jr[j]=(jr.get(j,0)-c*phase*v)%p; jr[j+2]=(jr.get(j+2,0)-c*v)%p
        jr={j:v for j,v in jr.items() if v}
        require(blocks['J'][0]==threshold and blocks['J'][1]==jr,'actual full original J residual')
        Y=sp.Symbol('Y'); root=sum(v*Y**j for j,v in fa.items()); jpoly=sum(v*Y**j for j,v in jr.items())
        common=sp.gcd(sp.Poly(root,Y,modulus=p),sp.Poly(jpoly,Y,modulus=p))
        expected_exception=(int(sp.expand(H[c]/Z).subs(Z,sp.I))%p==0)
        require(common.degree()==(2 if expected_exception else 0),'gcd actual exceptional residual branches')
    vF=blocks['F'][2]; hs=hull([(j,Fraction(v[0])) for j,v in enumerate(vF) if v and Fraction(v[0])+j*rho<=threshold])
    segments=[{'count':right[0]-left[0],'depth':str((left[1]-right[1])/(right[0]-left[0]))} for left,right in zip(hs,hs[1:])]
    central=sum(z['count'] for z in segments if Fraction(z['depth'])>=rho)
    interior=sum(z['count'] for z in segments if Fraction(z['depth'])>rho)
    require(central==c*L+1 and interior==L+1,'direct original central root count')
    return {'c':c,'p':p,'r':r,'s':s,'primitive_phase_exponent':phase,'modulus':modulus,'precision_value':precision*e,'threshold':threshold,'low_X_cap':cap,'full_degree':n,'weights':{name:str(v[0]) for name,v in blocks.items()},'initials':{name:v[1] for name,v in blocks.items() if name!='Mp'},'central_roots':central,'central_strict_interior_roots':interior,'Newton_segments':segments,'status':'PASS'}

def main():
    report={'independence':'New local reviewer program; no candidate/dependency programs imported or executed.','controls_are_not_uniform_proof':True}
    report['arithmetic']=arithmetic(); print('arithmetic PASS',flush=True)
    report['valuation_combinatorics']=valuation_combinatorics(); print('combinatorics PASS',flush=True)
    report['original_cyclotomic']=[]
    for args in [(5,7,2,3,2),(7,11,2,3,3),(11,13,2,3,2),(3,5,3,4,2)]:
        row=cyclotomic(*args); report['original_cyclotomic'].append(row)
        print('cyclotomic',args,'PASS',flush=True)
    report['status']='PASS'; (ROOT/'CONTROL_RESULTS.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
    print('ALL PASS',flush=True)
if __name__=='__main__':main()
PK␀␀␀␀␀␀␀!␀öÂPA␀␀A␀␀W␀␀␀f020-uniform-odd-adjacent-public-20261021_v2/independent-review/private/second_layer.py#!/usr/bin/env python3
"""Independent original parity-recurrence jets at U=-1 and exact t basis."""
import json, math, time
from pathlib import Path
from fractions import Fraction
import numpy as np
import sympy as sp
ROOT=Path(__file__).resolve().parent

def require(x,msg):
 if not x:raise RuntimeError(msg)
def vp(x,p):
 if not x:return 10**9
 k=0
 while x%p==0:x//=p;k+=1
 return k

def check(c,p,s,u):
 now=time.time();N=p*p;B=p*(p-1);d=B//2;rho=Fraction(p,2);K=Fraction(c*(N+2*B),2);S=int(K+rho)
 n=c*N+1;m=n//2;order=p**s;e=order-order//p;Jmax=p;prec=math.ceil(Fraction(S+d+p+3,e))+1;mod=p**prec
 require(mod*2**p*(p+2)<2**63,'integer convolution accumulation bound')
 E=np.zeros((Jmax+1,order),dtype=np.int64);E[0,0]=1;O=E.copy()
 # U=-1+V and T=(q_base^u-1)^p are kept exactly over Z/p^prec.
 terms=[((-1)**(p-l)*math.comb(p,l),u*l) for l in range(p+1)]
 def Tmul(a):
  z=np.zeros_like(a)
  for coeff,shift in terms:z+=coeff*np.roll(a,shift,axis=1)
  return z%mod
 for k in range(1,m+1):
  oldO=O.copy();ux=-oldO;ux[1:]+=oldO[:-1]
  E=(Tmul(ux)-E+np.roll(E,u*(2*k-1),axis=1))%mod
  O=(E-oldO+np.roll(oldO,u*2*k,axis=1))%mod
 def basis(a):
  q=a[:,:e].copy();last=a[:,e:]
  for b in range(p-1):q[:,b*(order//p):(b+1)*(order//p)]-=last
  q%=mod;ts=np.zeros_like(q)
  for i in range(e-1,-1,-1):ts[:,1:]+=ts[:,:-1].copy();ts[:,0]+=q[:,i];ts%=mod
  return ts
 ts=basis(E)
 def val(row):
  vals=[]
  for j in np.flatnonzero(row):
   a=int(row[j]);k=vp(a,p);v=int(j)+e*k
   vals.append((v,(a//p**k*(-1)**k*pow(u,-v,p))%p))
  return min(vals) if vals else None
 jets=[val(row) for row in ts]
 Z=sp.Symbol('Z');M=[sp.Integer(1),Z]
 for k in range(2,c+1):M.append(sp.expand(Z*M[-1]+(k-1)*M[-2]))
 R=sum(int(coef)*Z**(int(j)//2) for (j,),coef in sp.Poly(M[c]/Z,Z).terms())
 obstruction=int(R.subs(Z,-1));Rprime=int(sp.diff(R,Z).subs(Z,-1))%p
 # J/t^S=2U f_U-f. At U=-1, J=-2 F_U-F.
 jval=val((-2*ts[1]-ts[0])%mod)
 exceptional=obstruction%p==0
 if exceptional:
  require(jets[0][0]>S+p,'exceptional full F(-1) lattice bound')
  require(all(jets[j][0]>S+p for j in range(1,p)),'operator-forced lower jet bound')
  require(jets[p][0]==S,'multiplicity exactly p in U')
  require(jval[0]==S+d+1,'J first nonzero lifted layer')
  require(jval[1]==(-Rprime*pow(4,-1,p))%p,'J actual mixed-characteristic normalized unit')
 else: require(jets[0][0]==S,'nonexceptional constant control')
 return {'c':c,'p':p,'r':2,'s':s,'primitive_phase':u,'S':S,'d':d,'ramification_e':e,'modulus':mod,'precision':prec*e,'raw_lattice_floor':m,'lattice_margin':e+m-S,'obstruction':obstruction,'Rprime_mod_p':Rprime,'exceptional':exceptional,'F_U_minus_one_jets':[{'V_degree':j,'valuation':v[0],'unit_normalized_to_input_q_minus_one':v[1]} if v else {'V_degree':j,'valuation_at_least':prec*e} for j,v in enumerate(jets)],'J_at_U_minus_one':{'valuation':jval[0],'unit':jval[1]},'status':'PASS'}

def main():
 out={'independent_original_parity_recurrence':True,'all_ordinary_integer_derivative_factors_retained':True,'finite_controls_not_uniform_proof':True,'cases':[]}
 for args in [(11,13,3,1),(11,13,3,2),(11,13,3,-1),(9,11,3,2),(7,11,3,1)]:
  row=check(*args);out['cases'].append(row);print(args,row['J_at_U_minus_one'],flush=True)
 out['status']='PASS';(ROOT/'SECOND_LAYER_RESULTS.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
 print('ALL SECOND LAYER PASS',flush=True)
if __name__=='__main__':main()
