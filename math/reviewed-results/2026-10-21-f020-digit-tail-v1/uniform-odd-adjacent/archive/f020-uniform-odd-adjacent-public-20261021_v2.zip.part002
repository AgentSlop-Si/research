"""Fresh uniform-proof falsification fixtures, including all nonpivot indices."""
import json
from pathlib import Path
import numpy as np
import sympy as sp
ROOT=Path(__file__).resolve().parent

def require(a,m):
 if not a:raise RuntimeError(m)
def vp(j,p):
 k=0
 while j and j%p==0:j//=p;k+=1
 return k

def main():
 rows=[]
 for c,p in [(3,5),(5,7),(7,11),(9,11),(11,13),(15,17)]:
  N=p*p;B=p*(p-1);d=B//2;g=(p-1)//2;Wn=N+2*B;K2=c*Wn;E=(c-1)*N//2+c*B;D=(c+1)*N//2+c*B-p
  terms=np.array([0]+[p**vp(j,p) for j in range(1,c*N+1)],dtype=np.int64);W=np.cumsum(terms)
  T2=np.array([2*m+(p-2)*((m+p-1)//p) for m in range(c*N+1)],dtype=np.int64);R2=2*W-T2
  for m in range(c*N+1):
   a,b=divmod(m%N,p);formula=a*(p-1)+b+(p-2)*(b>0)
   require(int(T2[m]-W[m])==formula,'exact central slack formula')
  gaps={'H':10**20,'M':10**20,'Hprime':10**20};pivots={'H':[],'M':[],'Hprime':[]};neighbor_derivative_min=10**20
  for k in range(1,c*N+1,2):
   a=(c*N-k)//2;excess=2*W[c*N]-2*W[a]-R2[k]-K2
   if k%N==0:pivots['H'].append(k);require(excess==0,'H pivot')
   else:gaps['H']=min(gaps['H'],int(excess))
   vals=2*W[c*N]-2*W[a]-R2[:k]-2*terms[k:0:-1]-2*D
   for m in np.flatnonzero(vals==0):pivots['Hprime'].append((int(m),k))
   other=vals[vals!=0]
   if len(other):gaps['Hprime']=min(gaps['Hprime'],int(other.min()))
  for k in range(0,c*N,2):
   a=(c*N-1-k)//2;excess=2*W[c*N-1]-2*W[a]-R2[k]-2*E
   if k%N==0:pivots['M'].append(k);require(excess==0,'M pivot')
   else:gaps['M']=min(gaps['M'],int(excess))
   if k:
    vals=2*W[c*N-1]-2*W[a]-R2[:k]-2*terms[k:0:-1]
    neighbor_derivative_min=min(neighbor_derivative_min,int(vals.min()))
  require(pivots['H']==list(range(N,c*N+1,2*N)),'odd H pivots')
  require(pivots['M']==list(range(0,c*N,2*N)),'even M pivots include zero')
  require(pivots['Hprime']==[(l*N,(l+1)*N) for l in range(0,c,2)],'ordinary derivative pivots include zero')
  require(gaps['H']>=2*(d+g) and gaps['M']>=2*g and gaps['Hprime']>=2*g,'all nonpivot bounds')
  require(neighbor_derivative_min>=2*E,'entire Mprime bound')
  rows.append({'c':c,'p':p,'twice_minimum_nonpivot_gaps':gaps,'pivots':pivots,'twice_neighbor_derivative_min':neighbor_derivative_min,'twice_E':2*E})
 grouped=[];z,h=sp.symbols('z h')
 for p in [5,7,11,13]:
  prod=sp.Poly(1,z,h,modulus=p)
  for a in range(p):prod*=sp.Poly(z+(1+h)**a,z,h,modulus=p)
  diff=prod-sp.Poly((z+1)**p,z,h,modulus=p)
  min_h=min(j for (i,j),a in diff.terms())
  require(min_h>=p-1,'grouped product divisibility')
  A=(p*p-1)//2;unit=1;linear=0
  for j in range(1,A+1):
   idx=2*j;v=vp(idx,p);unit=unit*(-idx//p**v)%p
   if v==0:linear=(linear+(idx-1)*pow(2,-1,p))%p
  require(unit==p-1 and linear==(-pow(8,-1,p))%p,'Q actual first-order correction')
  grouped.append({'p':p,'grouped_min_h_order':min_h,'Q_unit':unit,'Q_relative_linear':linear})
 margins=[]
 for p in list(sp.primerange(5,100)):
  N=p*p;B=p*(p-1);d=B//2
  for c in range(3,p,2):
   margin=(p-c)*B-(p-1)//2
   require(margin>max(p,d+1),'all odd lattice margins')
   margins.append(margin)
 out={'new_independent_program':True,'uniform_proof_not_replaced_by_finite_checks':True,'all_index_cases':rows,'grouped_product_and_Q_cases':grouped,'odd_lattice_fixtures':len(margins),'minimum_lattice_margin':min(margins),'status':'PASS'}
 (ROOT/'STRUCTURAL_SECOND_LAYER_RESULTS.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n');print('ALL STRUCTURAL PASS')
if __name__=='__main__':main()
