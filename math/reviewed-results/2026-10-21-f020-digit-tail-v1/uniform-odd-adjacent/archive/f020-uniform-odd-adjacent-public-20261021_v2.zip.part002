 for row in ledger:
  safe(row['source_path'])
  originals[row['source_packet']+'/'+row['source_path']]=row['original']
  if row['mode']=='omitted':
   require(row['source_packet']=='author' and row['source_path']=='RUN_LOG.md' and row['export_path'] is None and bool(row['reason']),'Undisclosed scientific omission');continue
  name=row['export_path'];require(name not in exports,'Repeated export');exports[name]=row;originals[name]=row['original']
  require(desc(safe(name))==row['exported'],'Source public identity changed: '+name)
  if row['mode']=='exact':require(row['original']==row['exported'],'Exact copy differs')
  else:
   require(row['mode']=='public_projection','Unknown projection')
   p=row['projection'];require(p['scientific_content_changed'] is False and p['mathematical_and_code_bytes_changed'] is False and p['contributor_credit_preserved'] is True,'Scientific projection is not permitted')
   require(row['original']!=row['exported'],'Empty projection')
   require(not name.endswith('.py'),'Code projection is not permitted')
   for c in p['replacements']:
    require(c['kind'] in ['locator','attribution_role'] and c['count']>0 and re.fullmatch('[0-9a-f]{64}',c['source_text_sha256']),'Invalid projection record')
    require((ROOT/name).read_text().count(c['replacement'])>=c['count'],'Projected text missing')
    if c['kind']=='locator':safe(c['replacement'])
 om=read('OMISSIONS.json');require(om['final_proofs_reviews_mathematical_checkers_or_data_omitted'] is False,'Scientific evidence omitted')
 require(om['frozen_source_omissions']==[r for r in ledger if r['mode']=='omitted'],'Omission ledger differs')
 for packet,digest in ORIGINAL_MANIFESTS.items():
  rows=[r for r in ledger if r['source_packet']==packet];src=read(packet+'/MANIFEST.json')
  require(src['package']==packet,'Projected source packet label differs')
  require(originals[packet+'/MANIFEST.json']['sha256']==digest,'Source manifest identity differs')
  require((ROOT/packet/'SEAL.sha256').read_text().split()==[digest,'MANIFEST.json'],'Original manifest seal differs')
  require({r['source_path'] for r in rows}=={r['path'] for r in src['files']}|{'MANIFEST.json','SEAL.sha256'},'Source inventory differs')
  for e in src['files']:
   hits=[r for r in rows if r['source_path']==e['path']]
   require(len(hits)==1 and hits[0]['original']=={k:e[k] for k in ['bytes','sha256']},'Source manifest entry differs')
 a=read('ACCEPTANCE.json');v=read('independent-review/VERDICT.json')
 require(a['status']==v['verdict']=='ACCEPTED_WITHIN_STATED_SCOPE','Fresh acceptance missing')
 require(a['source_manifests']==ORIGINAL_MANIFESTS,'Acceptance source identities differ')
 require(a['author_report_original']==originals['author/REPORT.md'] and a['author_report_original']['sha256']==AUTHOR_REPORT,'Author proof binding differs')
 require(a['independent_review_original']==originals['independent-review/INDEPENDENT_REVIEW.md'] and a['independent_review_original']['sha256']==AUDIT_REPORT,'Fresh review binding differs')
 require(a['author_report_public']==desc(ROOT/'author/REPORT.md') and a['independent_review_public']==desc(ROOT/'independent-review/INDEPENDENT_REVIEW.md'),'Public review/proof identity differs')
 require(v['source_manifest_sha256']==ORIGINAL_MANIFESTS['author'] and v['source_report_sha256']==AUTHOR_REPORT and not v['mathematical_defects_found'] and v['independent_controls']['all_passed'],'Frozen acceptance incomplete')
 binding=read('independent-review/SOURCE_BINDING.json')
 require(binding['package']=='author' and binding['manifest_sha256']==ORIGINAL_MANIFESTS['author'] and binding['report_sha256']==AUTHOR_REPORT and binding['all_manifest_entries_verified'],'Fresh source verification incomplete')
 require({r['path'] for r in binding['files']}=={r['path'] for r in read('author/MANIFEST.json')['files']},'Fresh bound inventory incomplete')
 for r in binding['files']:require(r['verified'] and originals['author/'+r['path']]=={k:r[k] for k in ['bytes','sha256']},'Fresh source entry mismatch')
 # Recover original scientific identities through every nested public projection ledger.
 deep_orig=dict(originals)
 for p in sorted((ROOT/'dependencies').rglob('SOURCE_LEDGER.json'),key=lambda p:len(p.parts)):
  data=json.loads(p.read_text());rows=data['files'] if isinstance(data,dict) else data
  for r in rows:
   if r.get('export_path') is not None:deep_orig[(p.parent.relative_to(ROOT)/r['export_path']).as_posix()]=r['original']
 nbind=0
 for r in read('author/SOURCE_BINDINGS.json'):
  expected={k:r[k] for k in ['bytes','sha256']}
  require(deep_orig[r['source_path']]==expected and originals['author/'+r['retained_path']]==expected,'Retained scientific source identity differs');nbind+=1
 d=read('DEPENDENCIES.json');prior=[r for r in ledger if r['source_packet']=='even-low-digit-portable']
 require(d['root']=='dependencies/even-low-digit' and len(prior)==d['source_file_count']==328 and all(r['mode']=='exact' for r in prior),'Prior packet incomplete or changed')
 require(d['source_zip_sha256']==PRIOR_ZIP and d['portable_manifest_sha256']==PRIOR_MANIFEST and desc(ROOT/d['root']/'MANIFEST.json')['sha256']==PRIOR_MANIFEST,'Prior packet seal differs')
 cfg=read('REPLAY_CASES.json');require(cfg['ignored_nondeterministic_keys']==['seconds','elapsed_seconds','total_seconds'],'Unapproved ignored replay fields')
 require(len(cfg['cases'])==29 and sum(c['group']=='current' for c in cfg['cases'])==3 and sum(c['group']=='prior' for c in cfg['cases'])==26,'Replay set incomplete')
 for c in cfg['cases']:
  for k in ['script','expected_output']:require(safe(c[k]).is_file(),'Missing replay input')
  for extra in c.get('additional_expected_outputs',[]):require(safe(extra).is_file(),'Missing extra replay output')
  if 'generated_output' in c:require(PurePosixPath(c['generated_output']).name==c['generated_output'],'Unsafe generated output')
  for x in c.get('support_files',[]):require(safe(x['source']).is_file(),'Missing checker support')
 tokens=['/'+'workspace'+'/','/'+'home'+'/','/'+'tmp'+'/','/'+'root'+'/','docs.google.com'+'/spreadsheets','cloud'+'_threads','collaboration'+'.','mcp'+'__','user_message'+'.','/'+'agent_notes'+'/','/'+'user_notes'+'/','dream'+'_notes','codex'+':','chatgpt'+'.com','native'+'_plan','delivery'+'_context','coordinating '+'parent',"parent's "+'exploratory','The '+'parent','Global '+'owner scope']
 for name in actual:
  text=(ROOT/name).read_text();require(not any(t in name or t in text for t in tokens),'Private locator or coordination term: '+name)
  require(re.search(r'f020_[a-z_]+_20\d{6}',name+'\n'+text) is None,'Private source-directory label: '+name)
 env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1';env.pop('PYTHONOPTIMIZE',None)
 child=subprocess.run([sys.executable,str(ROOT/d['root']/'verify_package.py')],cwd=ROOT,env=env,capture_output=True,text=True)
 require(child.returncode==0,'Prior packet verifier failed: '+child.stderr)
 return {'status':'PASS','public_files':len(actual),'source_entries':len(ledger),'public_projections':sum(r['mode']=='public_projection' for r in ledger),'explicit_omissions':sum(r['mode']=='omitted' for r in ledger),'fresh_scoped_acceptance_bound':True,'mathematical_code_and_data_bytes_preserved':True,'contributor_attribution_preserved':True,'scientific_source_bindings_checked':nbind,'complete_prior_dependency':json.loads(child.stdout),'all_member_privacy_scan':'PASS','original_undistributed_bytes_reconstructed':False,'mathematical_replay':False,'network_used':False}
if __name__=='__main__':print(json.dumps(main(),indent=2))
