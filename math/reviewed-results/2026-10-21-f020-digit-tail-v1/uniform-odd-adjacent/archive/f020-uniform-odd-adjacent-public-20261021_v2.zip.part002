  key=(row['collection'],route(row['source_path']));need(key not in originals,'duplicate omission');identity(row['original']);originals[key]=row['original'];need(not(root/key[0]/key[1]).exists(),'omitted original unexpectedly present')
 for coll in SOURCES:
  need(sha((root/coll/'MANIFEST.json').read_bytes())==SOURCES[coll]==read(root/coll/'SEAL.json')['manifest_sha256'],'current source seal');m=read(root/coll/'MANIFEST.json');names=set()
  for x in m['files']:
   n=route(x['path']);need(n not in names,'source duplicate');names.add(n);same(originals[(coll,n)],{k:x[k]for k in('bytes','sha256')},'original current source identity')
  same({n for c,n in originals if c==coll},names|{'MANIFEST.json','SEAL.json'},'current source exact accounting');same(inventory(root/coll),{n[len(coll)+1:]for n in by if n.startswith(coll+'/')},'current source export set')
 role_roots=set()
 for role in inv['selected_snapshot_inventory_roles']:
  coll=role['collection'];prefix=route(role['root']);need((coll,prefix)not in role_roots,'duplicate selected inventory');role_roots.add((coll,prefix));m=read(root/coll/prefix/'MANIFEST.json');need(sha((root/coll/prefix/'MANIFEST.json').read_bytes())==role['manifest_sha256']==read(root/coll/prefix/'SEAL.json')['manifest_sha256'],'selected source seal');missing={x['path']:x for x in role['missing_original_inventory_files']};need(len(missing)==len(role['missing_original_inventory_files']),'duplicate missing member');present=[]
  for x in m['files']:
   n=route(x['path']);key=(coll,prefix+'/'+n)
   if coll+'/'+prefix+'/'+n in by:same(originals[key],{k:x[k]for k in('bytes','sha256')},'selected source exact identity');present.append(n)
   else:need(n in missing,'undeclared snapshot omission');same({k:missing[n][k]for k in('bytes','sha256')},{k:x[k]for k in('bytes','sha256')},'snapshot missing identity')
  same(sorted(present),sorted(role['retained_listed_files']),'snapshot retained list');same(set(missing),{x['path']for x in m['files']}-set(present),'snapshot missing set');need(role['original_inventory_completely_retained']is(not missing),'snapshot completeness')
 seen_json=set()
 omitted_keys={(x['collection'],x['source_path'])for x in inv['omissions']}
 for role in inv['selected_json_inventory_roles']:
  coll=role['collection'];path=route(role['inventory_path']);field=role['inventory_field'];need(field in ('files','source_files','sources'),'inventory field');key=(coll,path,field);need(key not in seen_json,'duplicate JSON inventory role');seen_json.add(key);p=root/coll/path;obj=read(p);need(sha(p.read_bytes())==role['inventory_sha256'],'JSON inventory identity');prefix=PurePosixPath(path).parent;missing={x['path']:x for x in role['missing_original_inventory_files']};need(len(missing)==len(role['missing_original_inventory_files']),'duplicate JSON omissions');present=[]
  for f in obj[field]:
   n=route(f['path']);source_path=str(prefix/n);q=coll+'/'+source_path;declared={k:f[k]for k in('bytes','sha256')}
   if q in by:same(by[q]['original'],declared,'selected JSON original identity');present.append(n)
   else:
    need(n in missing,'unqualified JSON inventory member');same({k:missing[n][k]for k in('bytes','sha256')},declared,'JSON omission identity');same(missing[n]['disposition'],'omitted_in_export'if(coll,source_path)in omitted_keys else'absent_in_original_snapshot','exact missing-member disposition')
  same(sorted(present),sorted(role['retained_listed_files']),'JSON retained paths');same(set(missing),{x['path']for x in obj[field]}-set(present),'JSON missing paths');need(role['original_inventory_completely_retained']is(not missing),'JSON completeness qualification')
 expected_json=set()
 for coll in SOURCES:
  for p in(root/coll).rglob('*.json'):
   data=read(p)
   if type(data)is dict:
    for field in ('files','source_files','sources'):
     if type(data.get(field))is list:expected_json.add((coll,p.relative_to(root/coll).as_posix(),field))
 same(seen_json,expected_json,'every retained source files/source_files inventory, including root manifests, qualified')
 for role in inv['selected_snapshot_inventory_roles']:
  for f in role['missing_original_inventory_files']:
   source_path=role['root']+'/'+f['path'];same(f['disposition'],'omitted_in_export'if(role['collection'],source_path)in omitted_keys else'absent_in_original_snapshot','nested missing-member disposition')
 expected_roles={(c,str(p.parent.relative_to(root/c)))for c in SOURCES for p in(root/c).rglob('MANIFEST.json')if p.parent!=root/c};same(role_roots,expected_roles,'all selected snapshot inventories qualified')
 hist=read(root/'provenance/HISTORICAL_ARCHIVE_LEDGER.json');need(hist['raw_logs_exported']is False and hist['fresh_historical_execution']is False and hist['archive_envelopes_omitted']is True and hist['archive_envelopes_rewritten']is False,'history disclosure');same(len(hist['archives']),1,'one accepted historical archive');a=hist['archives'][0];identity(a['original_archive']);need(a['original_archive']['sha256']==DEP_SHA and a['envelope_retained']is False,'archive identity/omission');same(a['original_archive'],originals[('author','sources/accepted-c3-author/sources/accepted-single-leading-digit-comparison.zip')],'source archive identity');coll=a['collection'];members={};logs=0
 for x in a['members']:
  n=route(x['path']);need(n not in members,'historical duplicate');members[n]=x;identity(x['original']);disp=x['disposition']
  if disp=='retained_verbatim':need(x['stored_path']in by and by[x['stored_path']]['mode']=='verbatim','history retained mapping');same(by[x['stored_path']]['original'],x['original'],'history retained identity');same((by[x['stored_path']]['collection'],by[x['stored_path']]['source_path']),(coll,n),'history source mapping')
  else:need(disp=='raw_runtime_log_omitted'and n.endswith('.log')and(coll,n)not in originals,'only raw logs omitted');logs+=1
 same(logs,48,'exact omitted logs');same(len(members),455,'original archive member count');prefix=a['original_root'];manifest=members[prefix+'/MANIFEST.json'];m=read(root/manifest['stored_path']);need(sha((root/manifest['stored_path']).read_bytes())==a['original_manifest_sha256'],'archive manifest pin');same(set(members),{prefix+'/'+x['path']for x in m['files']}|{prefix+'/MANIFEST.json',prefix+'/SEAL.json'},'exact archived member accounting')
 for x in m['files']:same(members[prefix+'/'+x['path']]['original'],{k:x[k]for k in('bytes','sha256')},'archive original inventory member')
 expected_inventory_paths=set()
 for n,x in members.items():
  if not n.endswith('.json')or x['disposition']!='retained_verbatim':continue
  data=read(root/x['stored_path'])
  if type(data)is dict and type(data.get('files'))is list:expected_inventory_paths.add(x['stored_path'])
 seen=set()
 for role in a['historical_inventory_roles']:
  path=role['inventory_path'];need(path not in seen and path in expected_inventory_paths,'historical inventory path');seen.add(path);data=read(root/path);need(sha((root/path).read_bytes())==role['inventory_sha256'],'historical inventory pin');source_path=by[path]['source_path'];parent=source_path.rsplit('/',1)[0]+'/';same(len(role['entries']),len(data['files']),'all historical entries qualified');closed=True
  for index,(f,entry)in enumerate(zip(data['files'],role['entries'])):
   if all(k in f for k in('path','bytes','sha256')):rel=f['path'];declared={k:f[k]for k in('bytes','sha256')};schema='path_identity'
   else:
    need(all(k in f for k in('source_path','original','export_path')),'historical source-ledger schema');rel=f['export_path'];declared=f.get('exported',f['original']);schema='historical_source_ledger';same(entry['original_source_identity'],f['original'],'historical original identity');same(entry['historical_mode'],f['mode'],'historical mode')
   same(entry['index'],index,'historical row index');same(entry['path'],rel,'historical row path');same(entry['declared_identity'],declared,'historical declaration');need(entry['schema']==schema,'historical schema');q=parent+rel if rel is not None else None
   if q not in members:need(entry['disposition']=='absent_in_original_public_archive','historical absence qualification');closed=False
   elif members[q]['disposition']=='raw_runtime_log_omitted':need(entry['disposition']=='raw_runtime_log_omitted','historical log omission qualification');same(entry['archive_member_identity'],members[q]['original'],'historical omitted log identity');closed=False
   else:
    need(entry['disposition']=='retained_verbatim_archive_member','historical retained qualification');same(entry['stored_path'],members[q]['stored_path'],'historical retained path');same(entry['archive_member_identity'],members[q]['original'],'historical archive identity');matched=exact(members[q]['original'],declared);need(entry['matches_declared_identity']is matched,'historical original/public distinction');closed=closed and matched
  need(role['declared_inventory_closed_in_export']is closed,'historical closure qualification')
 same(seen,expected_inventory_paths,'every historical JSON files-inventory qualified');same(inventory(root/'accepted-history'),{n[len('accepted-history/'):]for n in by if n.startswith('accepted-history/')},'history exact export set')
 return {'retained_files':len(by),'projected_source_files':0,'separately_named_metadata_reading_projections':len(inv['locator_projections']),'current_omitted_files':len(inv['omissions']),'omitted_archive_envelopes':1,'omitted_raw_logs':logs,'qualified_historical_json_inventories':len(seen),'selected_partial_inventories':sum(not x['original_inventory_completely_retained']for x in inv['selected_snapshot_inventory_roles']),'missing_selected_original_files':sum(len(x['missing_original_inventory_files'])for x in inv['selected_snapshot_inventory_roles'])}

def locator_records(root):
 deps=read(root/'provenance/DEPENDENCIES.json');policy=read(root/'REPLAY_POLICY.json');inv=read(root/'provenance/SOURCE_INVENTORY.json');hist=read(root/'provenance/HISTORICAL_ARCHIVE_LEDGER.json')
 keys(deps,('mathematical_authority','specific_even_neighbor','author_archived_path_reading_adapter','adapter_meaning','historical_snapshot_qualification','original_inventory_wrappers_replayed','historical_programs_freshly_replayed','original_full_archive_verification_reproduced','source_programs_executed_as_mathematical_authority','scope_comparison_only','metadata_reading_adapters','public_wrapper_references'))
 records=[]
 def target(pointer,path,kind,section=None):
  n=route(path);p=root/n;need(not p.is_symlink(),'locator symlink');row={'declaration':pointer,'target':n,'kind':kind,'exists':True}
  if kind=='file':need(p.is_file(),'declared reading/replay file missing: '+n);row['identity']=ident(p.read_bytes())
  else:
   need(kind=='directory'and p.is_dir(),'declared reading directory missing: '+n);entries=[{'path':q,**ident((p/q).read_bytes())}for q in sorted(inventory(p))];need(bool(entries),'empty reading adapter');row['regular_files']=len(entries);row['descendant_inventory_sha256']=sha((json.dumps(entries,sort_keys=True,separators=(',',':'))+'\n').encode());row['identity_meaning']='Exact delivered descendant bytes; not closure of any original historical inventory.'
  if section is not None:row['section_annotation']=section
  records.append(row)
 for i,value in enumerate(deps['mathematical_authority']):
  parts=value.split(' Section',1);target('DEPENDENCIES.mathematical_authority['+str(i)+']',parts[0],'file','Section'+parts[1]if len(parts)==2 else None)
 for i,value in enumerate(deps['scope_comparison_only']):target('DEPENDENCIES.scope_comparison_only['+str(i)+']',value,'directory')
 omissions={x['collection']+'/'+x['source_path']:x for x in inv['omissions']};adapters=deps['author_archived_path_reading_adapter'];need(type(adapters)is dict and bool(adapters),'reading adapter map')
 for source,dest in sorted(adapters.items()):
  route(source);need(source in omissions and not(root/source).exists(),'reading adapter source must be exact intentional omission');records.append({'declaration':'DEPENDENCIES.author_archived_path_reading_adapter.source','target':source,'kind':'intentionally_omitted_original_archive','exists':False,'identity':omissions[source]['original']});target('DEPENDENCIES.author_archived_path_reading_adapter['+source+']',dest,'directory')
 parents=[]
 for i,archive in enumerate(hist['archives']):
  parent=route(archive['parent_reference']);need(parent in adapters,'historical parent lacks reading adapter');same(archive['original_archive'],omissions[parent]['original'],'historical parent exact omitted identity');parents.append(parent);records.append({'declaration':'HISTORICAL_ARCHIVE_LEDGER.archives['+str(i)+'].parent_reference','target':parent,'kind':'intentionally_omitted_original_archive','exists':False,'identity':archive['original_archive'],'reading_target':adapters[parent]})
 same(set(parents),set(adapters),'all archive adapters and parents matched')
 for source,dest in sorted(deps['metadata_reading_adapters'].items()):
  need(source in omissions and not(root/source).exists(),'metadata adapter source must be an exact omission');records.append({'declaration':'DEPENDENCIES.metadata_reading_adapters.source','target':source,'kind':'intentionally_omitted_original_metadata','exists':False,'identity':omissions[source]['original']});target('DEPENDENCIES.metadata_reading_adapters['+source+']',dest,'file')
 for i,path in enumerate(deps['public_wrapper_references']):
  if path in ('tools/verify.py','provenance/LOCATOR_VALIDATION.json'):
   route(path);need((root/path).is_file() or path=='provenance/LOCATOR_VALIDATION.json','manifest-bound tool missing');records.append({'declaration':'DEPENDENCIES.public_wrapper_references['+str(i)+']','target':path,'kind':'self_referential_manifest_bound_file','identity_authority':'Exact path, byte length and SHA-256 checked by the root MANIFEST.json and trusted canonical ZIP. Avoids a circular self-hash.'})
  else:target('DEPENDENCIES.public_wrapper_references['+str(i)+']',path,'file')
 proj=read(root/'provenance/projections/review_SOURCE_BINDING.json')['content']
 for i,row in enumerate(proj['source_records']):
  path='independent-review/'+route(row['snapshot'])
  if path in omissions:
   same(omissions[path]['original'],{k:row[k]for k in('bytes','sha256')},'snapshot omitted original identity');need(path in deps['metadata_reading_adapters'],'omitted snapshot requires adapter');records.append({'declaration':'review_source_records['+str(i)+'].snapshot','target':path,'kind':'intentionally_omitted_original_metadata','exists':False,'identity':omissions[path]['original'],'reading_target':deps['metadata_reading_adapters'][path]})
  else:
   target('review_source_records['+str(i)+'].snapshot',path,'file');same(ident((root/path).read_bytes()),{k:row[k]for k in('bytes','sha256')},'snapshot exact source identity')
 for i,spec in enumerate(policy['current_scientific_programs']):
  allowed={'role','script','result','reference','stdout_reference','comparison','arguments','stdout_sha256','stdout_bytes','stdout_reference_derivation','copy_reference_beside_script'};need(set(spec)<=allowed and {'role','script','result','reference','comparison'}<=set(spec),'replay declaration fields')
  for field in ('script','reference','stdout_reference'):
   if field in spec:target('REPLAY_POLICY.current_scientific_programs['+str(i)+'].'+field,spec[field],'file')
  output=route(spec['result']);need('/'not in output,'runtime result must be local filename');records.append({'declaration':'REPLAY_POLICY.current_scientific_programs['+str(i)+'].result','target':output,'kind':'fresh_isolated_runtime_output','created_only_at_replay':True,'reference':spec['reference'],'expected_identity':ident((root/spec['reference']).read_bytes())})
  if 'arguments'in spec:same(spec['arguments'],['--output',output],'all reviewer output arguments bind declared runtime output')
 return {'status':'PASS','validation_scope':'Every active reading and replay locator declared by the public dependency, historical parent-reference, and current replay policy wrappers. Retained original historical declarations are classified by the source/history ledgers, not represented as active complete adapters.','source_files_changed':False,'missing_active_targets':[],'records':records,'record_count':len(records),'directory_identity_algorithm':'SHA-256 of sorted descendant path/size/SHA-256 rows encoded as compact sorted-key JSON plus newline.'}

def validate_locators(root):
 expected=locator_records(root);same(read(root/'provenance/LOCATOR_VALIDATION.json'),expected,'exhaustive reading/replay locator existence and identity ledger');return {'status':'PASS','records':expected['record_count']}

def semantics(root):
 v=read(root/'independent-review/VERDICT.json');scope=read(root/'SCOPE.json');accept=read(root/'provenance/ACCEPTANCE_BINDING.json');claim=read(root/'author/CLAIM_SCOPE.json')
 need(v['verdict']==accept['mathematical_verdict']=='ACCEPTED_WITHIN_EXACT_STATED_SCOPE','exact acceptance')
 need(accept['author_manifest_sha256']==SOURCES['author'] and accept['review_manifest_sha256']==SOURCES['independent-review'],'acceptance identities')
 for key,path in [('author_report','author/REPORT.md'),('review_report','independent-review/INDEPENDENT_REVIEW.md'),('review_verdict','independent-review/VERDICT.json')]:same(accept[key],ident((root/path).read_bytes()),'accepted '+key)
 same(scope['exact_family'],v['exact_scope'],'exact family');need(v['author_manifest_sha256']==SOURCES['author'] and v['author_report_sha256']==sha((root/'author/REPORT.md').read_bytes()),'review binds exact candidate');same(scope['accepted_verdict'],v,'entire accepted verdict');same(scope['author_claim'],claim,'entire author scope');need(accept['public_packaging_independently_accepted']is False,'no public self-acceptance')
 need(scope['inherited_c3_not_new_credit']is True and scope['global_F020_F023_closed']is False and scope['FFT_or_cost_claim']is False and scope['historical_novelty_claim']is False,'claim limits')
 inv=read(root/'provenance/SOURCE_INVENTORY.json');orig={(x['collection'],x['source_path']):x['original']for x in inv['files']+inv['omissions']}
 projection=read(root/'provenance/projections/author_SOURCE_BINDINGS.json')
 same(projection['original_identity'],orig[('author','SOURCE_BINDINGS.json')],'projected metadata original identity')
 for f in projection['content']['sources']:same(orig[('author',f['path'])],{k:f[k]for k in('bytes','sha256')},'complete author declared source identity')
 need(len(projection['removed_fields'])==len(projection['content']['sources']),'all source private origins removed')
 same(read(root/'provenance/projections/review_AUTHOR_SOURCE_BINDINGS.json')['content'],projection['content'],'duplicate author provenance projection');
 for row in inv['locator_projections']:
  source=(row['collection'],row['source_path']);data=read(root/row['projection_path']);same(data['original_identity'],orig[source],'projection original identity');same(ident((root/row['projection_path']).read_bytes()),row['projected_identity'],'projection exported identity');need(data['scientific_content_changed']is False,'no scientific projection')
 oldbase=root/'author/sources/accepted-c3-author';oldbinding=read(oldbase/'SOURCE_BINDINGS.json');oldreview=read(root/'author/sources/accepted-c3-review/VERDICT.json')
 need(oldreview['status']=='ACCEPTED_WITHIN_STATED_SCOPE' and oldreview['source_manifest_sha256']=='ba8247e802e0e32503993847c9c385b3c58ef6d32e2cdac6dd48c236f141462b' and oldreview['source_report_sha256']==sha((oldbase/'REPORT.md').read_bytes())=='8f721e6e5b42764b78a4ce633aa12ac565101243c4d3fc77ace164869bda744d','inherited c3 exact authority')
 need(oldbinding['archive_sha256']==DEP_SHA,'accepted archive pin')
 for f in oldbinding['source_files']:same(orig[('author','sources/accepted-c3-author/'+f['path'])],{k:f[k]for k in('bytes','sha256')},'c3 source identity')
 a=read(root/'provenance/HISTORICAL_ARCHIVE_LEDGER.json')['archives'][0];members={x['path']:x for x in a['members']}
 for check in oldbinding['archive_manifest_verification']:
  x=members[check['archive_manifest']];m=read(root/x['stored_path']);need(x['original']['sha256']==check['sha256'] and len(m['files'])==check['verified_entries'],'current original archive inventory')
  pre=check['archive_manifest'].removesuffix('MANIFEST.json')
  for f in m['files']:same(members[pre+f['path']]['original'],{k:f[k]for k in('bytes','sha256')},'original archive declared member')
 base='f020-single-leading-digit-comparison/dependencies/accepted-theorem/'
 for n in ('ACCEPTANCE.json','MANIFEST.json','SEAL.json','author/REPORT.md','independent-review/INDEPENDENT_REVIEW.md','independent-review/VERDICT.json'):same((oldbase/'sources/leading-digit'/n).read_bytes(),(root/members[base+n]['stored_path']).read_bytes(),'readable theorem snapshots')
 policy=read(root/'REPLAY_POLICY.json');same(policy['scientific_source_adapters'],[],'no scientific edits');same(policy['timing_exceptions'],[],'no result exceptions');same([x['role']for x in policy['current_scientific_programs']],['author','review','review_second_layer','review_structural'],'four current programs')
 need(policy['historical_programs_freshly_replayed']is False and policy['original_inventory_wrappers_replayed']is False,'no replay inflation')

def integrity(root=ROOT):
 actual=inventory(root);m=read(root/'MANIFEST.json');seal=read(root/'SEAL.json');keys(m,('schema_version','package','files'));keys(seal,('algorithm','manifest','manifest_sha256','file_count'));need(type(m['schema_version'])is int and m['schema_version']==1 and m['package']==PACKAGE,'manifest schema');need(seal['algorithm']=='SHA-256' and seal['manifest']=='MANIFEST.json' and seal['manifest_sha256']==sha((root/'MANIFEST.json').read_bytes()),'public manifest seal');need(type(seal['file_count'])is int and seal['file_count']==len(actual),'public file count');names=[]
 for row in m['files']:
  keys(row,('path','bytes','sha256'));n=route(row['path']);identity({k:row[k]for k in ('bytes','sha256')});names.append(n);same(ident((root/n).read_bytes()),{k:row[k]for k in ('bytes','sha256')},'public member identity: '+n)
 need(names==sorted(set(names)) and actual==set(names)|{'MANIFEST.json','SEAL.json'} and not {'MANIFEST.json','SEAL.json'}&set(names),'exact public inventory')
 dirs={str(p.relative_to(root)) for p in root.rglob('*') if p.is_dir()};expected_dirs={str(p) for n in actual for p in PurePosixPath(n).parents if str(p)!='.'};need(dirs==expected_dirs,'extra directory')
 for n,h in ANCHORS.items():need(sha((root/n).read_bytes())==h,'fixed administrative/scientific anchor: '+n)
 for n in sorted(actual):privacy(n,(root/n).read_bytes())
 src=source_check(root);semantics(root);validate_locators(root)
 return {'status':'PASS','public_regular_files':len(actual),'source_representation':src,'optimized_python':bool(sys.flags.optimize),'public_packaging_independently_accepted':False}

def reseal(root):
 files=[{'path':p,**ident((root/p).read_bytes())} for p in sorted(inventory(root)-{'MANIFEST.json','SEAL.json'})];(root/'MANIFEST.json').write_text(json.dumps({'schema_version':1,'package':PACKAGE,'files':files},indent=2,sort_keys=True)+'\n');(root/'SEAL.json').write_text(json.dumps({'algorithm':'SHA-256','manifest':'MANIFEST.json','manifest_sha256':sha((root/'MANIFEST.json').read_bytes()),'file_count':len(files)+2},indent=2,sort_keys=True)+'\n')
def negatives(root=ROOT):
 integrity(root);rows=[]
 for kind in ['changed_proof','missing_file','extra_file','extra_directory','symlink_file','symlink_directory','rehashed_proof','duplicate_json_key','unsafe_path','duplicate_manifest_member','wrong_seal','boolean_byte_count','negative_byte_count','float_byte_count','nonfinite_json']:
  with tempfile.TemporaryDirectory(prefix='public-inventory-mutant-') as td:
   d=Path(td)/'copy';shutil.copytree(root,d)
   if kind=='changed_proof':(d/'author/REPORT.md').write_bytes(b'changed')
   elif kind=='missing_file':(d/'author/REPORT.md').unlink()
   elif kind=='extra_file':(d/'EXTRA').write_text('extra')
   elif kind=='extra_directory':(d/'EXTRA').mkdir()
   elif kind=='symlink_file':(d/'author/REPORT.md').unlink();(d/'author/REPORT.md').symlink_to(root/'author/REPORT.md')
   elif kind=='symlink_directory':(d/'LINK').symlink_to(root/'author',target_is_directory=True)
   elif kind=='rehashed_proof':(d/'author/REPORT.md').write_bytes(b'changed');reseal(d)
   elif kind=='duplicate_json_key':p=d/'MANIFEST.json';p.write_text(p.read_text().replace('{','{"files": [],',1));s=read(d/'SEAL.json');s['manifest_sha256']=sha(p.read_bytes());(d/'SEAL.json').write_text(json.dumps(s))
   elif kind=='wrong_seal':s=read(d/'SEAL.json');s['manifest_sha256']='0'*64;(d/'SEAL.json').write_text(json.dumps(s))
   else:
    m=read(d/'MANIFEST.json')
    if kind=='unsafe_path':m['files'][0]['path']='../outside'
    elif kind=='boolean_byte_count':m['files'][0]['bytes']=True
    elif kind=='negative_byte_count':m['files'][0]['bytes']=-1
    elif kind=='float_byte_count':m['files'][0]['bytes']=float(m['files'][0]['bytes'])
    elif kind=='nonfinite_json':m['files'][0]['bytes']=float('nan')
    else:m['files'].append(m['files'][0])
    p=d/'MANIFEST.json';p.write_text(json.dumps(m));s=read(d/'SEAL.json');s['manifest_sha256']=sha(p.read_bytes());(d/'SEAL.json').write_text(json.dumps(s))
   rejected=False
   try:integrity(d)
   except (ValueError,OSError,KeyError,TypeError):rejected=True
   need(rejected,'accepted inventory mutant '+kind);rows.append({'mutation':kind,'rejected':True})
 members={PACKAGE+'/'+n:(root/n).read_bytes() for n in inventory(root)};raw=canonical_zip(members)
 tests={'prefix':b'prefix'+raw,'suffix':raw+b'suffix','eocd_comment':raw[:-2]+b'\x01\x00'+b'x'}
 for kind in ['compressed','timestamp','member_extra','archive_symlink','unsafe_archive_path','duplicate_archive_member','case_collision']:
  b=io.BytesIO()
  with zipfile.ZipFile(b,'w') as z:
   for i,(n,data) in enumerate(sorted(members.items())):
    info=zipfile.ZipInfo('../escape' if kind=='unsafe_archive_path' and i==0 else n,(1981,1,1,0,0,0) if kind=='timestamp' and i==0 else (1980,1,1,0,0,0));info.create_system=3;info.external_attr=(0o120777 if kind=='archive_symlink' and i==0 else 0o100644)<<16;info.compress_type=zipfile.ZIP_DEFLATED if kind=='compressed' else zipfile.ZIP_STORED
    if kind=='member_extra' and i==0:info.extra=b'\x01\x00\x00\x00'
    z.writestr(info,data)
   if kind in ('duplicate_archive_member','case_collision'):
    n,data=next(iter(sorted(members.items())));n=n if kind=='duplicate_archive_member' else n.upper()
    with warnings.catch_warnings():warnings.simplefilter('ignore');z.writestr(n,data)
  tests[kind]=b.getvalue()
 for kind,data in tests.items():
  rejected=False
  try:canonical_members(data)
  except (ValueError,OSError,zipfile.BadZipFile,UnicodeError,struct.error):rejected=True
  need(rejected,'accepted archive mutant '+kind);rows.append({'mutation':'archive_'+kind,'rejected':True})
 canonical_members(raw);integrity(root);return {'status':'PASS','optimized_python':bool(sys.flags.optimize),'mutations':rows,'original_unchanged':True}
def main():
 p=argparse.ArgumentParser();p.add_argument('--archive');p.add_argument('--expect-sha256');p.add_argument('--extract');p.add_argument('--negative-controls',action='store_true');a=p.parse_args()
 if a.archive:
  need(a.expect_sha256 is not None and HEX.fullmatch(a.expect_sha256),'trusted archive digest required');raw=Path(a.archive).read_bytes();need(sha(raw)==a.expect_sha256,'archive SHA-256 mismatch');canonical_members(raw)
  if a.extract:
   dest=Path(a.extract);extract(raw,dest);out=integrity(dest/PACKAGE)
  else:
   with tempfile.TemporaryDirectory(prefix='exact-zip-check-')as td:dest=Path(td)/'new';extract(raw,dest);out=integrity(dest/PACKAGE)
 else:need(not a.extract and not a.expect_sha256,'archive required');out=integrity()
 if a.negative_controls:out['negative_controls']=negatives()
 print(json.dumps(out,indent=2,sort_keys=True))
if __name__=='__main__':
 try:main()
 except Exception as e:print('FAIL: '+str(e),file=sys.stderr);sys.exit(1)
