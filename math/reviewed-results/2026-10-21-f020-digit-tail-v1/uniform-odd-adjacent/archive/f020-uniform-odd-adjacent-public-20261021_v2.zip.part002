  "corollary_with_accepted_sources": "Original H/P squarefree and original algebraic-square kernel nonzero for all odd p, even 2<=c<p, s>2 at n=c*p^2+1",
  "excluded": [
    "arbitrary n or digits",
    "odd c or c>=p",
    "s<=2",
    "global F020/F023 closure",
    "FFT or cost",
    "historical novelty",
    "external writes",
    "general exact root depth beyond >1"
  ],
  "new_uniform_result": [
    "every exceptional U root has v(U+1)>1",
    "v(f_U)=p(p-1)/2+1, normalized residue R_c_prime(-1)/8",
    "v(P_n_prime)=K+p(p-1)/2+1, normalized residue -R_c_prime(-1)/4",
    "all exceptional roots simple; no further residual obstruction"
  ],
  "p3_boundary": "only c2; inherited exact derivative value76/3; not the new first-order lemma",
  "parameters": "p>=5 prime; even 2<=c<p; s>2; p divides A_c; original n=c*p^2+1",
