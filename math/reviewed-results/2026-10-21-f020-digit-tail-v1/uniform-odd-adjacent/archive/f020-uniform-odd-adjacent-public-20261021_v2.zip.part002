 p=subprocess.run(flags+[str(script)]+spec.get('arguments',[]),cwd=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE);sys.stdout.buffer.write(p.stdout);sys.stderr.buffer.write(p.stderr)
 need(p.returncode==0,'scientific child failed');need(p.stderr==b'','scientific stderr differs from empty reference');need((d/spec['result']).is_file(),'scientific result missing')
