    {
      "id": "ACF02",
      "claim": "For every prime p=1 mod4, p!=5, half-order squarefreeness at all primitive roots of order 15p; for every prime p=1 mod4, likewise at order 19p",
      "status": "ACCEPT_USING_PREVIOUSLY_ACCEPTED_AUGMENTED_CRITERION"
    },
    {
      "id": "ACF03",
      "claim": "For U=z^rP(z+z^-1), DiscU=P(2)P(-2)Disc(P)^2 and Res(U,z^s+1)=(-1)^rP(-2)Res(P,C_s)^2; hence Gamma=(-1)^rP(2)P(-2)^2[Disc(P)Res(P,C_s)]^2",
      "status": "ACCEPT_GENERAL_POLYNOMIAL_IDENTITIES"
    },
    {
      "id": "ACF04",
      "claim": "s63,p5 has an irreducible exact-order63 adverse resonance component and a separate good augmented component; thus an all-component/norm-unit shortcut fails while 5 does not divide c_63^+",
      "status": "ACCEPT_EXACT_COMPONENT_CERTIFICATE"
    },
    {
      "id": "ACF05",
      "claim": "The new d=3 mod4 families remove the remaining residual-squarefreeness guard in the accepted all-local-index overlap theorem; the forbidden simple root -1 and m+1 legal-bank minimum persist",
      "status": "ACCEPT_WITH_INHERITED_RESONANCE_AND_DISK_THEOREMS"
    }
